        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n\n  .pt-shell {\n    --pt-surface: #fbf9f6;\n    --pt-paper: #f4efea;\n    --pt-linen: #f1efeb;\n    --pt-white: #ffffff;\n    --pt-ink: #1e2d24;\n    --pt-body: #334135;\n    --pt-muted: #5a685d;\n    --pt-amber: #c27803;\n    --pt-amber-soft: #ffddbb;\n    --pt-thread: #e6dec8;\n    --pt-burgundy: #881337;\n    --pt-ui: 'Be Vietnam Pro', sans-serif;\n    --pt-display: 'Playfair Display', Georgia, serif;\n    --pt-paper-shadow: 0 16px 34px -22px rgba(30, 45, 36, 0.24), 0 3px 9px -5px rgba(30, 45, 36, 0.12);\n    --pt-button-shadow: 0 8px 14px -9px rgba(194, 120, 3, 0.72);\n  }\n\n  .pt-ui { font-family: var(--pt-ui); }\n  .pt-display { font-family: var(--pt-display); }\n</style>\n<div class=\"pt-shell pt-ui min-h-[900px] bg-[var(--pt-surface)] text-[var(--pt-body)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"bg-[var(--pt-surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"border-b border-[var(--pt-thread)] bg-[var(--pt-paper)] px-4 py-2 md:px-6\" data-kid=\"1-1-1\" data-name=\"top utility bar\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-4 text-[10px] leading-4 text-[var(--pt-muted)] sm:text-[11px]\" data-kid=\"1-1-1-1\" data-name=\"utility links container\">\n                <p class=\"truncate text-[11px]\" data-kid=\"1-1-1-1-1\" data-name=\"promotional announcement text\">\n                    Cam kết 100% ảnh thật chụp trực tiếp từng cuốn sách\n                    <span class=\"mx-1 text-[var(--pt-amber)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"bullet separator icon\">\n                        •\n                    </span>\n                    Kiểm tra hàng trước khi thanh toán\n                </p>\n                <p class=\"hidden shrink-0 text-[11px] sm:block\" data-kid=\"1-1-1-1-2\" data-name=\"store hours and contact info\">\n                    Hà Nội: 08:30 – 21:30\n                    <span class=\"mx-1 text-[var(--pt-amber)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"bullet separator icon\">\n                        •\n                    </span>\n                    Hotline: 0988 123 456\n                </p>\n            </div>\n        </div>\n        <div class=\"border-b border-[var(--pt-thread)] px-4 py-4 md:px-6\" data-kid=\"1-1-2\" data-name=\"header main row\">\n            <div class=\"mx-auto flex max-w-[1200px] flex-col gap-4 md:flex-row md:items-center md:gap-6\" data-kid=\"1-1-2-1\" data-name=\"header content wrapper\">\n                <a aria-label=\"The Page Turner, về trang chủ\" class=\"flex shrink-0 items-center gap-3 text-[var(--pt-ink)]\" data-kid=\"1-1-2-1-1\" data-name=\"site logo and branding link\" href=\"#\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-[4px] bg-[var(--pt-ink)] text-[var(--pt-amber)] shadow-[0_4px_8px_-6px_rgba(30,45,36,.5)]\" data-kid=\"1-1-2-1-1-1\" data-name=\"logo icon container\">\n                        <svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"book logo icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M5.25 5.5c2.65-.55 4.72.08 6.75 1.7v11.3c-2.03-1.62-4.1-2.25-6.75-1.7V5.5Z\">\n                            </path>\n                            <path d=\"M18.75 5.5c-2.65-.55-4.72.08-6.75 1.7v11.3c2.03-1.62 4.1-2.25 6.75-1.7V5.5Z\">\n                            </path>\n                            <path d=\"M12 7.2v11.3\">\n                            </path>\n                        </svg>\n                    </span>\n                    <span data-kid=\"1-1-2-1-1-2\" data-name=\"site name text group\">\n                        <span class=\"pt-display block text-[20px] font-semibold leading-5 tracking-[-0.02em]\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"site headline text\">\n                            The Page Turner\n                        </span>\n                        <span class=\"mt-1 block text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--pt-muted)]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"site tagline text\">\n                            Sách cũ & quý hiếm\n                        </span>\n                    </span>\n                </a>\n                <div class=\"flex min-w-0 flex-1 items-center gap-3\" data-kid=\"1-1-2-1-2\" data-name=\"search bar area\">\n                    <label class=\"sr-only\" data-kid=\"1-1-2-1-2-1\" data-name=\"search input label\" for=\"site-search\">\n                        Tìm kiếm sách\n                    </label>\n                    <div class=\"relative min-w-0 flex-1\" data-kid=\"1-1-2-1-2-2\" data-name=\"search input field container\">\n                        <svg aria-hidden=\"true\" class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--pt-muted)]\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                            <circle cx=\"10.8\" cy=\"10.8\" r=\"5.8\">\n                            </circle>\n                            <path d=\"m15.2 15.2 4.2 4.2\">\n                            </path>\n                        </svg>\n                        <input class=\"h-10 w-full rounded-[4px] border border-[var(--pt-thread)] bg-[var(--pt-paper)] pl-10 pr-4 text-[12px] text-[var(--pt-body)] outline-none placeholder:text-[var(--pt-muted)] focus:border-[var(--pt-amber)] focus:ring-2 focus:ring-[var(--pt-amber)]/15\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"search input field\" id=\"site-search\" placeholder=\"Tìm kiếm sách, tác giả, nhà xuất bản\" type=\"search\"/>\n                    </div>\n                    <span class=\"hidden shrink-0 rounded-[4px] border border-[var(--pt-thread)] bg-[var(--pt-surface)] px-3 py-2.5 text-[11px] text-[var(--pt-muted)] lg:block\" data-kid=\"1-1-2-1-2-3\" data-name=\"featured category tag\">\n                        Trước 1975\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 text-[11px] text-[var(--pt-body)] md:shrink-0 md:justify-end md:gap-5\" data-kid=\"1-1-2-1-3\" data-name=\"user account menu links\">\n                    <a class=\"inline-flex items-center gap-1.5 whitespace-nowrap hover:text-[var(--pt-amber)]\" data-kid=\"1-1-2-1-3-1\" data-name=\"wishlist link\" href=\"#\">\n                        <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--pt-amber)]\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"heart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M12 20.1S4.5 15.4 4.5 9.4A3.9 3.9 0 0 1 8.4 5.5c1.6 0 2.8.9 3.6 2 0.8-1.1 2-2 3.6-2a3.9 3.9 0 0 1 3.9 3.9c0 6-7.5 10.7-7.5 10.7Z\">\n                            </path>\n                        </svg>\n                        Yêu thích\n                    </a>\n                    <a class=\"inline-flex items-center gap-1.5 whitespace-nowrap hover:text-[var(--pt-amber)]\" data-kid=\"1-1-2-1-3-2\" data-name=\"cart link\" href=\"#\">\n                        <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--pt-amber)]\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"cart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M4.5 6.5h2l1.4 9.2h9.9l1.6-6.3H7.3\">\n                            </path>\n                            <circle cx=\"9.2\" cy=\"19\" r=\"1.2\">\n                            </circle>\n                            <circle cx=\"17.3\" cy=\"19\" r=\"1.2\">\n                            </circle>\n                        </svg>\n                        Giỏ hàng\n                    </a>\n                    <a class=\"inline-flex items-center gap-1.5 whitespace-nowrap font-semibold text-[var(--pt-ink)] hover:text-[var(--pt-amber)]\" data-kid=\"1-1-2-1-3-3\" data-name=\"user profile link\" href=\"#\">\n                        <span class=\"flex h-5 w-5 items-center justify-center rounded-full bg-[var(--pt-ink)] text-white\" data-kid=\"1-1-2-1-3-3-1\" data-name=\"user icon container\">\n                            <svg aria-hidden=\"true\" class=\"h-3 w-3\" data-kid=\"1-1-2-1-3-3-1-1\" data-name=\"user icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                                <circle cx=\"12\" cy=\"8\" r=\"3\">\n                                </circle>\n                                <path d=\"M5.5 19c.8-3.2 3-4.8 6.5-4.8s5.7 1.6 6.5 4.8\">\n                                </path>\n                            </svg>\n                        </span>\n                        Thành viên\n                    </a>\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Điều hướng chính\" class=\"border-b border-[var(--pt-thread)] bg-white px-4 py-3 md:px-6\" data-kid=\"1-1-3\" data-name=\"main navigation bar\">\n            <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-5 gap-y-2 text-[11px] text-[var(--pt-body)] md:text-[12px]\" data-kid=\"1-1-3-1\" data-name=\"navigation link list\">\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-1\" data-name=\"navigation link home\" href=\"#\">\n                    Trang chủ\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-2\" data-name=\"navigation link categories\" href=\"#\">\n                    Danh mục sách\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-3\" data-name=\"navigation link literature\" href=\"#\">\n                    Văn học\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-4\" data-name=\"navigation link economics\" href=\"#\">\n                    Kinh tế\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-5\" data-name=\"navigation link psychology\" href=\"#\">\n                    Tâm lý\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-6\" data-name=\"navigation link rare books\" href=\"#\">\n                    Sách hiếm\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-7\" data-name=\"navigation link sale\" href=\"#\">\n                    Sách giảm giá\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-8\" data-name=\"navigation link checkout\" href=\"#\">\n                    Giỏ hàng & Thanh toán\n                </a>\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-1-3-1-9\" data-name=\"navigation link about\" href=\"#\">\n                    Về chúng tôi\n                </a>\n            </div>\n        </nav>\n    </header>\n    <main class=\"bg-[var(--pt-linen)] px-4 py-9 md:px-6 md:py-12\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mx-auto max-w-[720px]\" data-kid=\"1-2-1\" data-name=\"breadcrumb and login container\">\n            <div class=\"flex items-center gap-2 text-[11px] uppercase tracking-[0.11em] text-[var(--pt-muted)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation bar\">\n                <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb home link\" href=\"#\">\n                    Trang chủ\n                </a>\n                <span class=\"text-[var(--pt-amber)]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb account step\">\n                    Tài khoản\n                </span>\n                <span class=\"text-[var(--pt-amber)]\" data-kid=\"1-2-1-1-4\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"text-[var(--pt-body)]\" data-kid=\"1-2-1-1-5\" data-name=\"breadcrumb current page\">\n                    Đăng nhập\n                </span>\n            </div>\n            <section aria-labelledby=\"login-title\" class=\"mt-5 overflow-hidden rounded-[6px] border border-[var(--pt-thread)] bg-white shadow-[var(--pt-paper-shadow)]\" data-kid=\"1-2-1-2\" data-name=\"login card container\">\n                <div class=\"h-1 bg-[var(--pt-amber)]\" data-kid=\"1-2-1-2-1\" data-name=\"card top accent line\">\n                </div>\n                <div class=\"border-b border-[var(--pt-thread)] bg-[var(--pt-paper)] px-5 py-4 md:px-8\" data-kid=\"1-2-1-2-2\" data-name=\"card header area\">\n                    <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-2-1\" data-name=\"card header content\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"card icon container\">\n                            <span class=\"flex h-9 w-9 items-center justify-center rounded-[4px] border border-[var(--pt-amber)]/40 bg-[var(--pt-surface)] text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"profile icon\">\n                                <svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-1-2-2-1-1-1-1\" data-name=\"book profile icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M5.5 6.2h5.1c.8 0 1.4.6 1.4 1.4v10.2c-.8-.8-1.8-1.2-3-1.2H5.5V6.2Z\">\n                                    </path>\n                                    <path d=\"M18.5 6.2h-5.1c-.8 0-1.4.6-1.4 1.4v10.2c.8-.8 1.8-1.2 3-1.2h3.5V6.2Z\">\n                                    </path>\n                                    <path d=\"M12 7.6v9\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <div data-kid=\"1-2-1-2-2-1-1-2\" data-name=\"card header text group\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-2-1-1-2-1\" data-name=\"card header label\">\n                                    Kệ sách của tôi\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[var(--pt-muted)]\" data-kid=\"1-2-1-2-2-1-1-2-2\" data-name=\"card header description\">\n                                    Không gian riêng cho những ấn bản bạn trân trọng\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"hidden rounded-full border border-[var(--pt-thread)] bg-white px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-[var(--pt-muted)] sm:inline-flex\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"member status badge\">\n                            Thành viên\n                        </span>\n                    </div>\n                </div>\n                <div class=\"px-5 py-8 sm:px-10 md:px-16 md:py-10\" data-kid=\"1-2-1-2-3\" data-name=\"login form container\">\n                    <div class=\"mx-auto max-w-[470px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"login form inner box\">\n                        <h1 class=\"pt-display text-[29px] font-semibold leading-[1.18] tracking-[-0.02em] text-[var(--pt-ink)] sm:text-[34px]\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"login heading text\" id=\"login-title\">\n                            Đăng nhập vào Kệ sách của tôi\n                        </h1>\n                        <p class=\"mt-3 max-w-[430px] text-[14px] leading-6 text-[var(--pt-muted)]\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"login subtext\">\n                            Tiếp tục theo dõi đơn hàng, chứng thư điện tử và những ấn bản bạn đã lưu tâm.\n                        </p>\n                        <form aria-label=\"Biểu mẫu đăng nhập\" class=\"mt-8 space-y-5\" data-kid=\"1-2-1-2-3-1-3\" data-name=\"login form\" onsubmit=\"event.preventDefault()\">\n                            <div data-kid=\"1-2-1-2-3-1-3-1\" data-name=\"email field group\">\n                                <label class=\"mb-2 block text-[12px] font-semibold text-[var(--pt-body)]\" data-kid=\"1-2-1-2-3-1-3-1-1\" data-name=\"email field label\" for=\"email\">\n                                    Địa chỉ email\n                                </label>\n                                <input autocomplete=\"email\" class=\"h-12 w-full rounded-[4px] border border-[var(--pt-thread)] bg-[var(--pt-paper)] px-4 text-[14px] text-[var(--pt-body)] outline-none transition focus:border-[var(--pt-amber)] focus:ring-2 focus:ring-[var(--pt-amber)]/20 placeholder:text-[var(--pt-muted)]\" data-kid=\"1-2-1-2-3-1-3-1-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"ten@email.com\" required=\"\" type=\"email\"/>\n                            </div>\n                            <div data-kid=\"1-2-1-2-3-1-3-2\" data-name=\"password field group\">\n                                <label class=\"mb-2 block text-[12px] font-semibold text-[var(--pt-body)]\" data-kid=\"1-2-1-2-3-1-3-2-1\" data-name=\"password field label\" for=\"password\">\n                                    Mật khẩu\n                                </label>\n                                <div class=\"relative\" data-kid=\"1-2-1-2-3-1-3-2-2\" data-name=\"password input container\">\n                                    <input autocomplete=\"current-password\" class=\"h-12 w-full rounded-[4px] border border-[var(--pt-thread)] bg-[var(--pt-paper)] px-4 pr-16 text-[14px] text-[var(--pt-body)] outline-none transition focus:border-[var(--pt-amber)] focus:ring-2 focus:ring-[var(--pt-amber)]/20 placeholder:text-[var(--pt-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1-3-2-2-1\" data-name=\"password input field\" data-reason=\"text visibility toggled by script\" id=\"password\" name=\"password\" placeholder=\"Nhập mật khẩu của bạn\" required=\"\" type=\"password\"/>\n                                    <button aria-controls=\"password\" aria-label=\"Hiện mật khẩu\" aria-pressed=\"false\" class=\"absolute right-3 top-1/2 inline-flex -translate-y-1/2 items-center gap-1.5 rounded-[3px] px-1 py-1 text-[11px] font-semibold text-[var(--pt-muted)] transition hover:text-[var(--pt-amber)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1-3-2-2-2\" data-name=\"password visibility toggle button\" data-reason=\"icon and labels toggled by script\" id=\"password-toggle\" type=\"button\">\n                                        <svg aria-hidden=\"true\" class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1-3-2-2-2-1\" data-name=\"eye open icon\" data-reason=\"visibility toggled by script\" fill=\"none\" id=\"eye-open\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                            <path d=\"M3.7 12s3.1-5 8.3-5 8.3 5 8.3 5-3.1 5-8.3 5-8.3-5-8.3-5Z\">\n                                            </path>\n                                            <circle cx=\"12\" cy=\"12\" r=\"2.2\">\n                                            </circle>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"hidden h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1-3-2-2-2-2\" data-name=\"eye closed icon\" data-reason=\"visibility toggled by script\" fill=\"none\" id=\"eye-closed\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                            <path d=\"m4 4 16 16\">\n                                            </path>\n                                            <path d=\"M9.8 6.9A9.4 9.4 0 0 1 12 6.7c5.2 0 8.3 5.3 8.3 5.3a15.1 15.1 0 0 1-3.1 3.4M6.1 8.7C4.5 10 3.7 12 3.7 12s3.1 5.3 8.3 5.3c.7 0 1.4-.1 2-.3\">\n                                            </path>\n                                        </svg>\n                                        <span data-dynamic=\"true\" data-kid=\"1-2-1-2-3-1-3-2-2-2-3\" data-name=\"password toggle label text\" data-reason=\"text content toggled by script\" id=\"password-toggle-label\">\n                                            Hiện\n                                        </span>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-4 pt-0.5\" data-kid=\"1-2-1-2-3-1-3-3\" data-name=\"form action row\">\n                                <label class=\"flex cursor-pointer items-center gap-2 text-[13px] text-[var(--pt-body)]\" data-kid=\"1-2-1-2-3-1-3-3-1\" data-name=\"remember me checkbox group\" for=\"remember\">\n                                    <input class=\"h-4 w-4 rounded-[2px] accent-[var(--pt-ink)]\" data-kid=\"1-2-1-2-3-1-3-3-1-1\" data-name=\"remember me checkbox input\" id=\"remember\" name=\"remember\" type=\"checkbox\"/>\n                                    <span data-kid=\"1-2-1-2-3-1-3-3-1-2\" data-name=\"remember me text\">\n                                        Ghi nhớ đăng nhập\n                                    </span>\n                                </label>\n                                <a class=\"shrink-0 text-[13px] font-semibold text-[var(--pt-amber)] underline decoration-[var(--pt-amber)] underline-offset-4 hover:text-[var(--pt-ink)]\" data-kid=\"1-2-1-2-3-1-3-3-2\" data-name=\"forgot password link\" href=\"#\">\n                                    Quên mật khẩu?\n                                </a>\n                            </div>\n                            <button class=\"group flex h-12 w-full items-center justify-center gap-2 rounded-[4px] bg-[var(--pt-ink)] text-[13px] font-semibold text-white shadow-[0_7px_12px_-8px_rgba(30,45,36,.55)] transition hover:border-[var(--pt-amber)] hover:bg-[var(--pt-ink)] hover:shadow-[var(--pt-button-shadow)] focus:outline-none focus:ring-2 focus:ring-[var(--pt-amber)]/35 active:translate-y-px\" data-kid=\"1-2-1-2-3-1-3-4\" data-name=\"login submit button\" type=\"submit\">\n                                Đăng nhập\n                                <svg aria-hidden=\"true\" class=\"h-4 w-4 transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-1-2-3-1-3-4-1\" data-name=\"arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M5 12h13\">\n                                    </path>\n                                    <path d=\"m13 7 5 5-5 5\">\n                                    </path>\n                                </svg>\n                            </button>\n                        </form>\n                        <div class=\"my-7 flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--pt-muted)]/70\" data-kid=\"1-2-1-2-3-1-4\" data-name=\"form separator\">\n                            <span class=\"h-px flex-1 bg-[var(--pt-thread)]\" data-kid=\"1-2-1-2-3-1-4-1\" data-name=\"separator line\">\n                            </span>\n                            <span class=\"flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-2-1-2-3-1-4-2\" data-name=\"separator text group\">\n                                <svg aria-hidden=\"true\" class=\"h-3 w-3 text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-3-1-4-2-1\" data-name=\"separator star icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" viewbox=\"0 0 24 24\">\n                                    <path d=\"m12 4.5 1.8 5.7 5.7 1.8-5.7 1.8-1.8 5.7-1.8-5.7-5.7-1.8 5.7-1.8L12 4.5Z\">\n                                    </path>\n                                </svg>\n                                <span data-kid=\"1-2-1-2-3-1-4-2-2\" data-name=\"separator label\">\n                                    hoặc\n                                </span>\n                                <svg aria-hidden=\"true\" class=\"h-3 w-3 text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-3-1-4-2-3\" data-name=\"separator star icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" viewbox=\"0 0 24 24\">\n                                    <path d=\"m12 4.5 1.8 5.7 5.7 1.8-5.7 1.8-1.8 5.7-1.8-5.7-5.7-1.8 5.7-1.8L12 4.5Z\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span class=\"h-px flex-1 bg-[var(--pt-thread)]\" data-kid=\"1-2-1-2-3-1-4-3\" data-name=\"separator line\">\n                            </span>\n                        </div>\n                        <p class=\"text-center text-[14px] text-[var(--pt-muted)]\" data-kid=\"1-2-1-2-3-1-5\" data-name=\"register call-to-action area\">\n                            Chưa có tài khoản?\n                            <a class=\"font-semibold text-[var(--pt-ink)] underline decoration-[var(--pt-amber)] underline-offset-4 hover:text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-3-1-5-1\" data-name=\"register link\" href=\"#\">\n                                Đăng ký ngay\n                            </a>\n                        </p>\n                        <div class=\"mt-7 flex items-start gap-3 border-t border-[var(--pt-thread)] pt-5 text-[12px] leading-5 text-[var(--pt-muted)]\" data-kid=\"1-2-1-2-3-1-6\" data-name=\"security notice container\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--pt-amber)]\" data-kid=\"1-2-1-2-3-1-6-1\" data-name=\"shield lock icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n                                <rect height=\"10\" rx=\"1.5\" width=\"14\" x=\"5\" y=\"10\">\n                                </rect>\n                                <path d=\"M8 10V7.7a4 4 0 0 1 8 0V10\">\n                                </path>\n                                <path d=\"M12 14v2\">\n                                </path>\n                            </svg>\n                            <p data-kid=\"1-2-1-2-3-1-6-2\" data-name=\"security notice text\">\n                                Thông tin của bạn được bảo mật. Đăng nhập để xem\n                                <span class=\"font-semibold text-[var(--pt-body)]\" data-kid=\"1-2-1-2-3-1-6-2-1\" data-name=\"security notice highlighted text\">\n                                    chứng thư điện tử\n                                </span>\n                                , lịch sử đơn hàng và những ấn bản đã lưu.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <p class=\"mx-auto mt-5 max-w-[640px] text-center text-[11px] leading-5 text-[var(--pt-muted)]\" data-kid=\"1-2-1-3\" data-name=\"footer advisory text\">\n                The Page Turner lưu giữ lịch sử mua hàng và chứng thư số của bạn trong một không gian riêng, rõ ràng và dễ tra cứu.\n            </p>\n        </div>\n    </main>\n    <footer class=\"border-t border-[var(--pt-thread)] bg-[var(--pt-paper)] px-4 py-10 md:px-6\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <div class=\"grid grid-cols-1 gap-8 text-[12px] leading-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10\" data-kid=\"1-3-1-1\" data-name=\"footer grid layout\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <p class=\"pt-display text-[17px] font-semibold text-[var(--pt-ink)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"brand name heading\">\n                        The Page Turner\n                    </p>\n                    <p class=\"mt-3 max-w-[230px] text-[var(--pt-muted)]\" data-kid=\"1-3-1-1-1-2\" data-name=\"brand description text\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách là một chứng nhân của thời gian, được thẩm định tỉ mỉ và trao lại cho người đọc.\n                    </p>\n                    <p class=\"mt-4 inline-flex items-center gap-2 font-semibold text-[var(--pt-body)]\" data-kid=\"1-3-1-1-1-3\" data-name=\"brand location text\">\n                        <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"location pin icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M4.5 10.5 12 5l7.5 5.5\">\n                            </path>\n                            <path d=\"M6.5 9.5v8h11v-8M9.5 17.5v-4h5v4\">\n                            </path>\n                        </svg>\n                        Tiệm sách độc lập Hà Nội\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"footer links column one\">\n                    <p class=\"font-semibold text-[var(--pt-ink)]\" data-kid=\"1-3-1-1-2-1\" data-name=\"links column heading\">\n                        Hỗ trợ & Chính sách\n                    </p>\n                    <div class=\"mt-3 space-y-1 text-[var(--pt-muted)]\" data-kid=\"1-3-1-1-2-2\" data-name=\"links list container\">\n                        <a class=\"block hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"link classification\" href=\"#\">\n                            Quy chuẩn phân loại tình trạng sách\n                        </a>\n                        <a class=\"block hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"link returns\" href=\"#\">\n                            Chính sách kiểm tra & đổi trả 7 ngày\n                        </a>\n                        <a class=\"block hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"link shipping\" href=\"#\">\n                            Giao hàng & đóng gói chuyên dụng\n                        </a>\n                        <a class=\"block hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-2-2-4\" data-name=\"link consignment\" href=\"#\">\n                            Ký gửi & thu mua sách cũ hiếm\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer contact column\">\n                    <p class=\"font-semibold text-[var(--pt-ink)]\" data-kid=\"1-3-1-1-3-1\" data-name=\"contact heading\">\n                        Liên hệ tiệm sách\n                    </p>\n                    <div class=\"mt-3 space-y-1.5 text-[var(--pt-muted)]\" data-kid=\"1-3-1-1-3-2\" data-name=\"contact details container\">\n                        <p class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"address row\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"address icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 20s6-6.1 6-10.4a6 6 0 1 0-12 0C6 13.9 12 20 12 20Z\">\n                                </path>\n                                <circle cx=\"12\" cy=\"9.6\" r=\"2\">\n                                </circle>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-1-2\" data-name=\"address text\">\n                                42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                            </span>\n                        </p>\n                        <p class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"phone row\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"phone icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M7.3 4.8h2.2l1.1 3.2-1.8 1.7a12.2 12.2 0 0 0 5.5 5.5l1.7-1.8 3.2 1.1v2.2c0 1-.8 1.8-1.8 1.8A13.4 13.4 0 0 1 5.5 6.6c0-1 .8-1.8 1.8-1.8Z\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-2-2\" data-name=\"phone text\">\n                                Hotline: 0988 123 456\n                            </span>\n                        </p>\n                        <p class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"email row\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-3-2-3-1\" data-name=\"email icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <rect height=\"11\" rx=\"1.5\" width=\"16\" x=\"4\" y=\"6.5\">\n                                </rect>\n                                <path d=\"m5.5 8 6.5 5 6.5-5\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-3-2\" data-name=\"email address text\">\n                                thuthu@thepageturner.vn\n                            </span>\n                        </p>\n                        <p class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"hours row\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--pt-amber)]\" data-kid=\"1-3-1-1-3-2-4-1\" data-name=\"hours icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <circle cx=\"12\" cy=\"12\" r=\"7.5\">\n                                </circle>\n                                <path d=\"M12 8v4l2.7 1.7\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-4-2\" data-name=\"hours text\">\n                                Mở cửa: 08:30 – 21:30 hàng ngày\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"newsletter column\">\n                    <p class=\"font-semibold text-[var(--pt-ink)]\" data-kid=\"1-3-1-1-4-1\" data-name=\"newsletter heading\">\n                        Bản tin Sách Hiếm\n                    </p>\n                    <p class=\"mt-3 text-[var(--pt-muted)]\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Nhận danh mục bản in đầu tuyển chọn, sách có chữ ký và bản đã phát hành một thời mỗi sáng thứ Bảy.\n                    </p>\n                    <label class=\"sr-only\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter email label\" for=\"newsletter-email\">\n                        Địa chỉ email nhận bản tin\n                    </label>\n                    <input class=\"mt-3 h-9 w-full rounded-[4px] border border-[var(--pt-thread)] bg-[var(--pt-surface)] px-3 text-[11px] text-[var(--pt-body)] outline-none placeholder:text-[var(--pt-muted)] focus:border-[var(--pt-amber)] focus:ring-2 focus:ring-[var(--pt-amber)]/15\" data-kid=\"1-3-1-1-4-4\" data-name=\"newsletter email input\" id=\"newsletter-email\" placeholder=\"Địa chỉ email của bạn...\" type=\"email\"/>\n                    <button class=\"mt-2 h-9 w-full rounded-[4px] bg-[var(--pt-ink)] text-[11px] font-semibold text-white transition hover:bg-[var(--pt-ink)]/90 focus:outline-none focus:ring-2 focus:ring-[var(--pt-amber)]/35\" data-kid=\"1-3-1-1-4-5\" data-name=\"newsletter subscribe button\" type=\"button\">\n                        Đăng ký nhận tin\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-9 flex flex-col gap-3 border-t border-[var(--pt-thread)] pt-4 text-[10px] leading-4 text-[var(--pt-muted)] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer copyright row\">\n                <p data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </p>\n                <div class=\"flex flex-wrap gap-x-5 gap-y-1\" data-kid=\"1-3-1-2-2\" data-name=\"footer bottom links\">\n                    <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-2-2-1\" data-name=\"link terms\" href=\"#\">\n                        Điều khoản dịch vụ\n                    </a>\n                    <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-2-2-2\" data-name=\"link privacy\" href=\"#\">\n                        Chính sách bảo mật\n                    </a>\n                    <a class=\"hover:text-[var(--pt-amber)]\" data-kid=\"1-3-1-2-2-3\" data-name=\"link certificates\" href=\"#\">\n                        Chứng thư ấn bản\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n    const toggle = document.getElementById('password-toggle');\n    const field = document.getElementById('password');\n    const label = document.getElementById('password-toggle-label');\n    const openIcon = document.getElementById('eye-open');\n    const closedIcon = document.getElementById('eye-closed');\n    if (!toggle || !field) return;\n    toggle.addEventListener('click', () => {\n      const visible = field.type === 'text';\n      field.type = visible ? 'password' : 'text';\n      toggle.setAttribute('aria-pressed', String(!visible));\n      toggle.setAttribute('aria-label', visible ? 'Hiện mật khẩu' : 'Ẩn mật khẩu');\n      label.textContent = visible ? 'Hiện' : 'Ẩn';\n      openIcon.classList.toggle('hidden', !visible);\n      closedIcon.classList.toggle('hidden', visible);\n    });\n  })();\n</script>\n",
      "comments": [],
