" data-kid=\"1-2-1-4-2-3-2-4\" data-name=\"third page number button\">\n                                3\n                            </button>\n                            <button class=\"flex h-9 items-center gap-1 rounded bg-[#f4efea] px-3 text-[#434844]\" data-kid=\"1-2-1-4-2-3-2-5\" data-name=\"next page button\">\n                                Tiếp theo\n                                <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-1-4-2-3-2-5-1\" data-name=\"next arrow icon\">\n                                    arrow_forward\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                    <section class=\"relative mt-6 overflow-hidden rounded bg-[#1e2d24] p-6 text-white shadow-[0_10px_25px_-9px_rgba(30,45,36,.35)] sm:p-7\" data-kid=\"1-2-1-4-2-4\" data-name=\"search service banner\">\n                        <div class=\"pointer-events-none absolute -bottom-12 -right-8 opacity-10\" data-kid=\"1-2-1-4-2-4-1\" data-name=\"service banner decorative background\">\n                            <span class=\"material-symbols-outlined text-[210px]\" data-kid=\"1-2-1-4-2-4-1-1\" data-name=\"decorative book icon\">\n                                auto_stories\n                            </span>\n                        </div>\n                        <div class=\"relative max-w-2xl\" data-kid=\"1-2-1-4-2-4-2\" data-name=\"service banner content\">\n                            <div class=\"flex flex-wrap items-center gap-2 text-[11px]\" data-kid=\"1-2-1-4-2-4-2-1\" data-name=\"banner header labels\">\n                                <span class=\"rounded bg-[#fea93e] px-2 py-1 font-semibold text-[#6d4100]\" data-kid=\"1-2-1-4-2-4-2-1-1\" data-name=\"banner service label\">\n                                    Dịch vụ Thủ thư\n                                </span>\n                                <span class=\"text-[#b9cbbe]\" data-kid=\"1-2-1-4-2-4-2-1-2\" data-name=\"banner status label\">\n                                    • Tìm kiếm theo yêu cầu\n                                </span>\n                            </div>\n                            <h2 class=\"mt-4 font-display text-[24px] leading-8\" data-kid=\"1-2-1-4-2-4-2-2\" data-name=\"banner title\">\n                                Không tìm thấy ấn bản tác phẩm bạn mong muốn?\n                            </h2>\n                            <p class=\"mt-2 text-[13px] leading-6 text-[#b9cbbe]\" data-kid=\"1-2-1-4-2-4-2-3\" data-name=\"banner description\">\n                                The Page Turner duy trì mạng lưới liên kết với hơn 40 nhà sưu tập cá nhân và các hiệu sách cũ kỳ cựu khắp Hà Nội & Sài Gòn. Hãy gửi thông tin tác phẩm, chúng tôi sẽ liên hệ ngay khi tìm được bản in phù hợp.\n                            </p>\n                            <div class=\"mt-5 flex flex-wrap gap-2\" data-kid=\"1-2-1-4-2-4-2-4\" data-name=\"banner actions\">\n                                <button class=\"flex items-center gap-2 rounded bg-[#c27803] px-4 py-2.5 text-[11px] font-semibold text-white\" data-kid=\"1-2-1-4-2-4-2-4-1\" data-name=\"search registration button\">\n                                    <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-1-4-2-4-2-4-1-1\" data-name=\"button book icon\">\n                                        menu_book\n                                    </span>\n                                    Đăng ký tìm sách hiếm\n                                </button>\n                                <button class=\"flex items-center gap-2 rounded border border-white/20 bg-white/5 px-4 py-2.5 text-[11px] font-semibold text-white\" data-kid=\"1-2-1-4-2-4-2-4-2\" data-name=\"contact librarian button\">\n                                    <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-2-1-4-2-4-2-4-2-1\" data-name=\"button chat icon\">\n                                        chat\n                                    </span>\n                                    Nhắn tin trực tiếp với Thủ thư\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                </section>\n            </div>\n        </div>\n    </main>\n    <footer class=\"w-full border-t border-[#e6dec8] bg-[#f4efea]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto max-w-[1320px] px-4 py-10 sm:px-6 lg:py-12\" data-kid=\"1-3-1\" data-name=\"footer content wrapper\">\n            <div class=\"grid grid-cols-1 gap-8 text-[12px] leading-5 text-[#5a685d] sm:grid-cols-2 lg:grid-cols-4 lg:gap-10\" data-kid=\"1-3-1-1\" data-name=\"footer grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand section\">\n                    <h3 class=\"font-display text-[18px] text-[#1e2d24]\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer brand title\">\n                        The Page Turner\n                    </h3>\n                    <p class=\"mt-3\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand description\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách cũ là một chứng nhân của thời gian, được thẩm định tỉ mỉ và tuyển chọn cẩn trọng.\n                    </p>\n                    <div class=\"mt-3 flex items-center gap-2 text-[#1e2d24]\" data-kid=\"1-3-1-1-1-3\" data-name=\"independent bookstore status\">\n                        <span class=\"material-symbols-outlined text-[16px] text-[#c27803]\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"store status icon\">\n                            auto_stories\n                        </span>\n                        <span class=\"font-semibold\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"store status text\">\n                            Tiệm sách độc lập Hà Nội\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"footer policies section\">\n                    <h3 class=\"font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-2-1\" data-name=\"policies title\">\n                        Hỗ trợ & Chính sách\n                    </h3>\n                    <ul class=\"mt-3 space-y-2\" data-kid=\"1-3-1-1-2-2\" data-name=\"policies list\">\n                        <li data-kid=\"1-3-1-1-2-2-1\" data-name=\"policy item one\">\n                            Quy chuẩn phân loại tình trạng sách\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-2\" data-name=\"policy item two\">\n                            Chính sách kiểm tra & đổi trả 7 ngày\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-3\" data-name=\"policy item three\">\n                            Giao hàng & đóng gói chuyên dụng\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-4\" data-name=\"policy item four\">\n                            Ký gửi & thu mua sách cổ hiếm\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-5\" data-name=\"policy item five\">\n                            Hướng dẫn đặt hàng và thanh toán\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer contact section\">\n                    <h3 class=\"font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-3-1\" data-name=\"contact title\">\n                        Liên hệ tiệm sách\n                    </h3>\n                    <div class=\"mt-3 space-y-2\" data-kid=\"1-3-1-1-3-2\" data-name=\"contact details\">\n                        <div class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"address line\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"address icon\">\n                                location_on\n                            </span>\n                            <span data-kid=\"1-3-1-1-3-2-1-2\" data-name=\"address text\">\n                                42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"phone line\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"phone icon\">\n                                call\n                            </span>\n                            <span data-kid=\"1-3-1-1-3-2-2-2\" data-name=\"phone number text\">\n                                Hotline: 0988 123 456\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"email line\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-3-1-1-3-2-3-1\" data-name=\"email icon\">\n                                mail\n                            </span>\n                            <span data-kid=\"1-3-1-1-3-2-3-2\" data-name=\"email address text\">\n                                thuthu@thepageturner.vn\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"hours line\">\n                            <span class=\"material-symbols-outlined text-[16px]\" data-kid=\"1-3-1-1-3-2-4-1\" data-name=\"hours icon\">\n                                schedule\n                            </span>\n                            <span data-kid=\"1-3-1-1-3-2-4-2\" data-name=\"hours text\">\n                                Mở cửa: 08:30 – 21:30 hàng ngày\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"footer newsletter section\">\n                    <h3 class=\"font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-4-1\" data-name=\"newsletter title\">\n                        Bản tin Sách Hiếm\n                    </h3>\n                    <p class=\"mt-3\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Nhận danh mục ấn bản tuyển chọn, sách chữ ký và bản in đầu phát hành mỗi sáng thứ Bảy.\n                    </p>\n                    <input class=\"mt-3 w-full rounded border border-[#e6dec8] bg-white px-3 py-2.5 text-[11px] text-[#1e2d24] outline-none placeholder:text-[#5a685d] focus:border-[#c27803]\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter input field\" placeholder=\"Địa chỉ email của bạn...\" type=\"email\"/>\n                    <button class=\"mt-2 w-full rounded bg-[#1e2d24] py-2.5 text-[11px] font-semibold text-white\" data-kid=\"1-3-1-1-4-4\" data-name=\"newsletter signup button\">\n                        Đăng ký nhận tin\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-9 flex flex-col gap-3 border-t border-[#e6dec8] pt-5 text-[10px] text-[#5a685d] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </span>\n                <div class=\"flex flex-wrap gap-x-5 gap-y-2\" data-kid=\"1-3-1-2-2\" data-name=\"footer links\">\n                    <a data-kid=\"1-3-1-2-2-1\" data-name=\"terms link\" href=\"#\">\n                        Điều khoản dịch vụ\n                    </a>\n                    <a data-kid=\"1-3-1-2-2-2\" data-name=\"privacy link\" href=\"#\">\n                        Chính sách bảo mật\n                    </a>\n                    <a data-kid=\"1-3-1-2-2-3\" data-name=\"certificate link\" href=\"#\">\n                        Chứng thực ấn bản\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <script>\n        (() => {\n      const repairs = {\n        'Bìa sách Tôi Thấy Hoa Vàng Trên Cỏ Xanh': 'https://lh3.googleusercontent.com/aida-public/AB6AXuDDC-7iuOQG65Cvw2pwGI_hsvcX_O5WQtoKOMauFWCas4zOSu1-wcata4srSyLc2eku3mTc6edtdJKr5EMHAdsBow2zCGuM1mdZFQ4C7gHMTmqM3mJEKXI5nrH2qjKc0mGiks-LwGrKF3t_GBDvBrGKF723JzHMPkjpLFm0e2zQTkOSqmxCR0MeWpLkRzAbku1vKRPEeywk_yP0XsBgswS1PSA_P9ZYZAPIqJWpaWYCjFn-SOuNFllp',\n        'Bìa sách Hạ Đỏ': 'https://lh3.googleusercontent.com/aida-public/AB6AXuADur5SNejMpfW8ldUdzX4_3DIMcd8sjzODlnTHprZH9jmxvzKOIM75fnqNpmY0hGNofrUz3rFPduAKgy0BfMYq4WR7HEc9R--xCBXGPKEA2ngRzOF77YpT-neuJ2szEObwbVd4Arse6ixabz6Vz8nxH5wiWQnjaStI9WiF81oABWIMkGj_PsIA9G8iN8qIExDOuOapO8qWFPSHA-kNDf9EJZWi-eQrwMhVZ5MF0XvXxUmhDey63zMA'\n      };\n      document.querySelectorAll('img[alt]').forEach((image) => {\n        const replacement = repairs[image.alt];\n        if (replacement) {\n          const apply = () => { if (image.naturalWidth === 0) image.src = replacement; };\n          image.addEventListener('error', apply, { once: true });\n          if (image.complete && image.naturalWidth === 0) apply();\n        }\n      });\n    })();\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-09-23T06:23:59.873540+00:00",
      "modified": "2026-09-23T06:23:59.873540+00:00",
      "id": "var_668a9af82afb"
    },
    "var_09dc9917a910": {
      "type": "variant",
      "label": "Page Turner — Đơn hàng của tôi",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 11040,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n  .pt-orders-root { --paper:#fbf9f6; --paper-2:#f4efe8; --paper-3:#efede8; --white:#ffffff; --ink:#1e2d24; --forest:#091810; --moss:#334135; --muted:#657067; --line:#e6dec8; --amber:#c27803; --amber-pale:#fff4dd; --amber-ink:#8d5c12; --green-pale:#e8f5e9; --green-ink:#1e5128; --yellow-pale:#fef3c7; --yellow-ink:#92400e; --burgundy:#881337; --rose-pale:#fce7eb; --soft-gray:#edece8; --shadow-card:0 8px 20px -4px rgba(30,45,36,.08),0 2px 6px -1px rgba(30,45,36,.04); --shadow-soft:0 3px 12px -3px rgba(30,45,36,.06); font-family:'Be Vietnam Pro',sans-serif; color:var(--moss); }\n  .pt-orders-root .book-cover { background:linear-gradient(135deg,var(--cover-a),var(--cover-b)); }\n  .pt-orders-root .book-cover:before { content:''; position:absolute; inset:0 auto 0 0; width:7px; background:linear-gradient(90deg,rgba(24,31,24,.32),rgba(255,255,255,.12)); }\n  .pt-orders-root .book-cover:after { content:''; position:absolute; inset:12px 8px auto; height:1px; background:var(--white-60); box-shadow:0 44px 0 var(--white-20); }\n  .pt-orders-root .icon-stroke { stroke:currentColor; stroke-width:1.65; stroke-linecap:round; stroke-linejoin:round; fill:none; }\n  .pt-orders-root input::placeholder { color:var(--muted); opacity:.82; }\n  /* Editorial readability and timeline alignment refinements */\n  .pt-orders-root .text-\\[9px\\] { font-size:12px; line-height:1.45; }\n  .pt-orders-root .text-\\[10px\\] { font-size:13px; line-height:1.5; }\n  .pt-orders-root .text-\\[11px\\] { font-size:13px; line-height:1.5; }\n  .pt-orders-root .text-\\[12px\\] { font-size:14px; line-height:1.5; }\n  .pt-orders-root .book-cover { padding:.625rem; }\n  .pt-orders-root .border-l > .relative > span.absolute { left:-26px; }\n  @media (max-width: 767px) {\n    .pt-orders-root .desktop-only { display:none; }\n    .pt-orders-root .mobile-full { width:100%; }\n  }\n</style>\n<div class=\"pt-orders-root bg-[var(--paper)] text-[var(--moss)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--white-60:rgba(255,255,255,.6);--white-20:rgba(255,255,255,.2);--display:'Playfair Display',serif;\">\n    <div class=\"border-b border-[var(--white-20)] bg-[var(--forest)] px-4 py-2.5 text-[10px] leading-4 text-[var(--white)] md:px-10\" data-kid=\"1-1\" data-name=\"top utility bar\">\n        <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-1 opacity-90\" data-kid=\"1-1-1\" data-name=\"utility bar content container\">\n            <span data-kid=\"1-1-1-1\" data-name=\"guarantee information text\">\n                Cam kết 100% ảnh thật chụp trực tiếp từng cuốn sách · Kiểm tra hàng trước khi thanh toán\n            </span>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-2\" data-name=\"contact information container\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"operating hours text\">\n                    Hà Nội 08:30 – 21:30\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"hotline contact text\">\n                    Hotline: 0988 123 456\n                </span>\n            </div>\n        </div>\n    </div>\n    <header class=\"border-b border-[var(--line)] bg-[var(--paper)] px-4 py-4 md:px-10\" data-kid=\"1-2\" data-name=\"header section\">\n        <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-4 lg:flex-nowrap lg:gap-7\" data-kid=\"1-2-1\" data-name=\"header content container\">\n            <div class=\"w-[176px] shrink-0\" data-kid=\"1-2-1-1\" data-name=\"brand logo area\">\n                <div class=\"font-[var(--display)] text-[18px] font-semibold leading-5 text-[var(--ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"brand name text\">\n                    The Page Turner\n                </div>\n                <div class=\"mt-1 text-[9px] font-semibold uppercase tracking-[.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"brand subtitle text\">\n                    Sách cũ & quý hiếm\n                </div>\n            </div>\n            <div class=\"order-3 flex h-10 min-w-0 basis-full items-center gap-3 rounded-[4px] border border-[var(--line)] bg-[var(--paper-2)] px-3 text-[11px] text-[var(--muted)] lg:order-none lg:flex-1 lg:basis-auto\" data-kid=\"1-2-1-2\" data-name=\"search input container\">\n                <svg aria-hidden=\"true\" class=\"h-4 w-4 shrink-0 text-[var(--ink)]\" data-kid=\"1-2-1-2-1\" data-name=\"search magnifying glass icon\" viewbox=\"0 0 24 24\">\n                    <circle class=\"icon-stroke\" cx=\"11\" cy=\"11\" r=\"6.5\">\n                    </circle>\n                    <path class=\"icon-stroke\" d=\"m16 16 4.5 4.5\">\n                    </path>\n                </svg>\n                <span class=\"min-w-0 flex-1 truncate\" data-kid=\"1-2-1-2-2\" data-name=\"search placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản\n                </span>\n                <span class=\"hidden border-l border-[var(--line)] pl-4 md:inline\" data-kid=\"1-2-1-2-3\" data-name=\"search category tag link\">\n                    Kinh tế học\n                </span>\n                <span class=\"hidden border-l border-[var(--line)] pl-4 md:inline\" data-kid=\"1-2-1-2-4\" data-name=\"search category tag link\">\n                    Trước 1975\n                </span>\n            </div>\n            <div class=\"ml-auto flex items-center gap-3 text-[11px] font-semibold text-[var(--ink)] md:gap-5\" data-kid=\"1-2-1-3\" data-name=\"header actions container\">\n                <span class=\"hidden items-center gap-1.5 md:flex\" data-kid=\"1-2-1-3-1\" data-name=\"wishlist action link\">\n                    <span class=\"text-[15px]\" data-kid=\"1-2-1-3-1-1\" data-name=\"wishlist heart icon\">\n                        ♡\n                    </span>\n                 