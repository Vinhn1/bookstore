      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n\n  .pt-page {\n    font-family: 'Be Vietnam Pro', sans-serif;\n    color: #334135;\n    background-color: #faf8f5;\n    background-image: radial-gradient(circle at 16% 8%, rgba(194, 120, 3, 0.035) 0, transparent 22rem), linear-gradient(180deg, rgba(255,255,255,0.3), rgba(250,248,245,0.1));\n  }\n  .pt-heading { font-family: 'Playfair Display', serif; }\n  .pt-card-lift { box-shadow: 0 14px 30px -18px rgba(30, 45, 36, 0.25), 0 3px 9px -6px rgba(30, 45, 36, 0.1); }\n  .pt-button { transition: background-color 180ms ease, box-shadow 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease; }\n  .pt-button:hover { box-shadow: 0 0 0 1px rgba(194, 120, 3, 0.68), 0 9px 18px -9px rgba(30, 45, 36, 0.72); transform: translateY(-1px); }\n  .pt-button:focus-visible, .pt-link:focus-visible, .pt-input:focus-visible { outline: 2px solid #c27803; outline-offset: 2px; }\n  .pt-input { box-shadow: inset 0 1px 2px rgba(30, 45, 36, 0.035); transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease; }\n  .pt-input:focus { border-color: #c27803; background-color: #fffdfa; box-shadow: 0 0 0 3px rgba(194, 120, 3, 0.12); }\n  .pt-check { accent-color: #1e2d24; }\n</style>\n<div class=\"pt-page w-full\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#e6dec8] bg-[#fffdfa]\" data-kid=\"1-1\" data-name=\"page header container\">\n        <div class=\"hidden border-b border-[#eee6da] bg-[#f4efea] px-4 py-2.5 text-[13px] leading-4 text-[#5a685d] sm:block md:px-10\" data-kid=\"1-1-1\" data-name=\"announcement bar container\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-6\" data-kid=\"1-1-1-1\" data-name=\"announcement bar wrapper\">\n                <p class=\"truncate\" data-kid=\"1-1-1-1-1\" data-name=\"announcement text\">\n                    Cam kết 100% ảnh thật chụp trực tiếp từng cuốn sách\n                    <span class=\"mx-1.5 text-[#c27803]\" data-kid=\"1-1-1-1-1-1\" data-name=\"announcement separator bullet\">\n                        •\n                    </span>\n                    Kiểm tra hàng trước khi thanh toán\n                </p>\n                <div class=\"flex shrink-0 items-center gap-5\" data-kid=\"1-1-1-1-2\" data-name=\"store hours and hotline container\">\n                    <span data-kid=\"1-1-1-1-2-1\" data-name=\"opening hours text\">\n                        Hà Nội: 08:30 – 21:30\n                    </span>\n                    <span data-kid=\"1-1-1-1-2-2\" data-name=\"hotline number text\">\n                        Hotline: 0988 123 456\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4 md:px-6 lg:flex-nowrap lg:gap-7 lg:py-5\" data-kid=\"1-1-2\" data-name=\"header main section\">\n            <a aria-label=\"The Page Turner, về trang chủ\" class=\"pt-link shrink-0 text-[#1e2d24]\" data-kid=\"1-1-2-1\" data-name=\"logo and brand name link\" href=\"#\">\n                <span class=\"pt-heading block text-[19px] font-semibold leading-5 tracking-[-0.02em]\" data-kid=\"1-1-2-1-1\" data-name=\"brand name headline\">\n                    The Page Turner\n                </span>\n                <span class=\"mt-1 block text-[9px] font-semibold uppercase tracking-[0.18em] text-[#5a685d]\" data-kid=\"1-1-2-1-2\" data-name=\"brand slogan subheadline\">\n                    Sách cũ & quý hiếm\n                </span>\n            </a>\n            <div class=\"hidden h-10 min-w-0 flex-1 items-center rounded border border-[#e6dec8] bg-[#f4efea] px-3 text-xs text-[#5a685d] md:flex\" data-kid=\"1-1-2-2\" data-name=\"desktop search bar container\">\n                <svg aria-hidden=\"true\" class=\"mr-2.5 h-4 w-4 shrink-0 text-[#1e2d24]\" data-kid=\"1-1-2-2-1\" data-name=\"search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"6.5\">\n                    </circle>\n                    <path d=\"m16 16 4.5 4.5\">\n                    </path>\n                </svg>\n                <span class=\"truncate\" data-kid=\"1-1-2-2-2\" data-name=\"search input placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản\n                </span>\n                <span class=\"ml-auto shrink-0 border-l border-[#e6dec8] pl-3 text-[11px] text-[#5a685d]\" data-kid=\"1-1-2-2-3\" data-name=\"search category filter label\">\n                    Trước 1975\n                </span>\n            </div>\n            <div class=\"ml-auto flex shrink-0 items-center gap-2.5 text-[13px] font-semibold text-[#334135] sm:gap-4\" data-kid=\"1-1-2-3\" data-name=\"user account action links container\">\n                <a aria-label=\"Sách yêu thích\" class=\"pt-link hidden items-center gap-1.5 md:flex\" data-kid=\"1-1-2-3-1\" data-name=\"wishlist navigation link\" href=\"#\">\n                    <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[#c27803]\" data-kid=\"1-1-2-3-1-1\" data-name=\"wishlist heart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                        <path d=\"M20.8 8.7c0 5.2-8.8 10.2-8.8 10.2S3.2 13.9 3.2 8.7A4.5 4.5 0 0 1 12 6.5a4.5 4.5 0 0 1 8.8 2.2Z\">\n                        </path>\n                    </svg>\n                    Yêu thích\n                </a>\n                <a aria-label=\"Giỏ hàng\" class=\"pt-link hidden items-center gap-1.5 sm:flex\" data-kid=\"1-1-2-3-2\" data-name=\"cart navigation link\" href=\"#\">\n                    <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[#c27803]\" data-kid=\"1-1-2-3-2-1\" data-name=\"cart shopping bag icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                        <path d=\"M4 5h2l1.8 10.1a2 2 0 0 0 2 1.7h7.5a2 2 0 0 0 1.9-1.5L21 8H7\">\n                        </path>\n                        <circle cx=\"10\" cy=\"20\" r=\"1.1\">\n                        </circle>\n                        <circle cx=\"18\" cy=\"20\" r=\"1.1\">\n                        </circle>\n                    </svg>\n                    Giỏ hàng\n                </a>\n                <span class=\"flex items-center gap-1.5 rounded bg-[#1e2d24] px-3 py-2 text-[13px] text-white\" data-kid=\"1-1-2-3-3\" data-name=\"member portal button\">\n                    <svg aria-hidden=\"true\" class=\"h-3.5 w-3.5 text-[#fea93e]\" data-kid=\"1-1-2-3-3-1\" data-name=\"user account profile icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                        <circle cx=\"12\" cy=\"8\" r=\"3.2\">\n                        </circle>\n                        <path d=\"M5.5 20c.6-3.3 2.8-5.2 6.5-5.2s5.9 1.9 6.5 5.2\">\n                        </path>\n                    </svg>\n                    Thành viên\n                </span>\n            </div>\n            <div class=\"order-last flex h-10 w-full items-center rounded border border-[#e6dec8] bg-[#f4efea] px-3 text-xs text-[#5a685d] md:hidden\" data-kid=\"1-1-2-4\" data-name=\"mobile search bar container\">\n                <svg aria-hidden=\"true\" class=\"mr-2.5 h-4 w-4 shrink-0 text-[#1e2d24]\" data-kid=\"1-1-2-4-1\" data-name=\"mobile search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"6.5\">\n                    </circle>\n                    <path d=\"m16 16 4.5 4.5\">\n                    </path>\n                </svg>\n                <span class=\"truncate\" data-kid=\"1-1-2-4-2\" data-name=\"mobile search placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản\n                </span>\n                <span class=\"ml-auto shrink-0 text-[11px] text-[#5a685d]\" data-kid=\"1-1-2-4-3\" data-name=\"mobile search icon\">\n                    ⌕\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Điều hướng chính\" class=\"hidden border-t border-[#f0ebe4] md:block\" data-kid=\"1-1-3\" data-name=\"main navigation bar\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center gap-7 px-6 py-3 text-[11px] text-[#334135] lg:gap-8\" data-kid=\"1-1-3-1\" data-name=\"navigation link list container\">\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-1\" data-name=\"home navigation link\" href=\"#\">\n                    Trang chủ\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-2\" data-name=\"book categories navigation link\" href=\"#\">\n                    Danh mục sách\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-3\" data-name=\"advanced search navigation link\" href=\"#\">\n                    Tìm kiếm nâng cao\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-4\" data-name=\"literature navigation link\" href=\"#\">\n                    Văn học\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-5\" data-name=\"economics navigation link\" href=\"#\">\n                    Kinh tế\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-6\" data-name=\"psychology navigation link\" href=\"#\">\n                    Tâm lý\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-7\" data-name=\"rare books navigation link\" href=\"#\">\n                    Sách hiếm\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-8\" data-name=\"discounted books navigation link\" href=\"#\">\n                    Sách giảm giá\n                </a>\n                <a class=\"pt-link\" data-kid=\"1-1-3-1-9\" data-name=\"about us navigation link\" href=\"#\">\n                    Về chúng tôi\n                </a>\n            </div>\n        </nav>\n    </header>\n    <main class=\"px-4 py-12 sm:px-6 md:py-16 lg:px-10 lg:py-[72px]\" data-kid=\"1-2\" data-name=\"page main content area\">\n        <div class=\"mx-auto max-w-[1100px]\" data-kid=\"1-2-1\" data-name=\"hero section container\">\n            <div class=\"mb-9 text-center md:mb-11\" data-kid=\"1-2-1-1\" data-name=\"hero header section\">\n                <div class=\"mb-4 flex items-center justify-center gap-3 text-[12px] font-semibold uppercase tracking-[0.18em] text-[#c27803]\" data-kid=\"1-2-1-1-1\" data-name=\"hero section label container\">\n                    <span class=\"h-px w-10 bg-[#e6dec8]\" data-kid=\"1-2-1-1-1-1\" data-name=\"decorative divider line\">\n                    </span>\n                    Thành viên The Page Turner\n                    <span class=\"h-px w-10 bg-[#e6dec8]\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero section label text\">\n                    </span>\n                </div>\n                <h1 class=\"pt-heading text-[30px] font-semibold leading-[1.18] tracking-[-0.02em] text-[#1e2d24] sm:text-[36px]\" data-kid=\"1-2-1-1-2\" data-name=\"main headline text\">\n                    Mở cánh cửa đến những trang sách thân quen\n                </h1>\n                <p class=\"mx-auto mt-3 max-w-[610px] text-sm leading-6 text-[#5a685d]\" data-kid=\"1-2-1-1-3\" data-name=\"hero subheadline description text\">\n                    Tạo tài khoản miễn phí để lưu lại những cuốn sách bạn yêu thích và nhận hỗ trợ tận tâm từ tiệm.\n                </p>\n            </div>\n            <div class=\"grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_330px]\" data-kid=\"1-2-1-2\" data-name=\"registration layout container\">\n                <section aria-labelledby=\"register-title\" class=\"pt-card-lift rounded-md border border-[#e6dec8] bg-[#fffdfa] p-5 sm:p-7 md:p-8\" data-kid=\"1-2-1-2-1\" data-name=\"registration card\">\n                    <div class=\"flex items-start justify-between gap-5 border-b border-[#e6dec8] pb-6\" data-kid=\"1-2-1-2-1-1\" data-name=\"registration card header\">\n                        <div data-kid=\"1-2-1-2-1-1-1\" data-name=\"registration title group\">\n                            <p class=\"mb-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#c27803]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"section small title\">\n                                Đăng ký thành viên\n                            </p>\n                            <h2 class=\"pt-heading text-[27px] font-semibold leading-8 tracking-[-0.015em] text-[#1e2d24] sm:text-[30px]\" data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"registration form heading\" id=\"register-title\">\n                                Tạo tài khoản bạn đọc\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-6 text-[#5a685d]\" data-kid=\"1-2-1-2-1-1-1-3\" data-name=\"registration prompt text\">\n                                Chỉ mất khoảng một phút để bắt đầu.\n                            </p>\n                        </div>\n                        <div aria-hidden=\"true\" class=\"hidden h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#c27803] text-[#c27803] sm:flex\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"registration icon container\">\n                            <svg class=\"h-5 w-5\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"user registration icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"m12 3 1.6 4.7L18 9.4l-4.4 1.7L12 16l-1.6-4.9L6 9.4l4.4-1.7L12 3Z\">\n                                </path>\n                                <path d=\"m19 15 .7 2.1L22 18l-2.3.9L19 21l-.7-2.1L16 18l2.3-.9L19 15Z\">\n                                </path>\n                            </svg>\n                        </div>\n                    </div>\n                    <form aria-label=\"Form tạo tài khoản bạn đọc\" class=\"mt-7\" data-kid=\"1-2-1-2-1-2\" data-name=\"registration form\">\n                        <div class=\"grid gap-x-4 gap-y-5 sm:grid-cols-2\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"registration form input fields grid\">\n                            <div data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"full name input group\">\n                                <label class=\"mb-2 block text-xs font-semibold text-[#334135]\" data-kid=\"1-2-1-2-1-2-1-1-1\" data-name=\"full name label\" for=\"full-name\">\n                                    Họ và tên\n                                    <span aria-hidden=\"true\" class=\"text-[#881337]\" data-kid=\"1-2-1-2-1-2-1-1-1-1\" data-name=\"required field asterisk\">\n                                        *\n                                    </span>\n                                </label>\n                                <input autocomplete=\"name\" class=\"pt-input block h-11 w-full rounded border border-[#e6dec8] bg-[#f4efea] px-3.5 text-sm text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-2-1-2-1-2-1-1-2\" data-name=\"full name input field\" id=\"full-name\" name=\"full-name\" placeholder=\"Nguyễn Hoàng Hải\" required=\"\" type=\"text\"/>\n                            </div>\n                            <div data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"email input group\">\n                                <label class=\"mb-2 block text-xs font-semibold text-[#334135]\" data-kid=\"1-2-1-2-1-2-1-2-1\" data-name=\"email label\" for=\"email\">\n                                    Địa chỉ email\n                                    <span aria-hidden=\"true\" class=\"text-[#881337]\" data-kid=\"1-2-1-2-1-2-1-2-1-1\" data-name=\"required field asterisk\">\n                                        *\n                                    </span>\n                                </label>\n                                <input autocomplete=\"email\" class=\"pt-input block h-11 w-full rounded border border-[#e6dec8] bg-[#f4efea] px-3.5 text-sm text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-2-1-2-1-2-1-2-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"ban@thepageturner.vn\" required=\"\" type=\"email\"/>\n                            </div>\n                            <div class=\"sm:col-span-2\" data-kid=\"1-2-1-2-1-2-1-3\" data-name=\"phone input group\">\n                                <label class=\"mb-2 block text-xs font-semibold text-[#334135]\" data-kid=\"1-2-1-2-1-2-1-3-1\" data-name=\"phone label\" for=\"phone\">\n                                    Số điện thoại\n                                    <span aria-hidden=\"true\" class=\"text-[#881337]\" data-kid=\"1-2-1-2-1-2-1-3-1-1\" data-name=\"required field asterisk\">\n                                        *\n                                    </span>\n                                </label>\n                                <input autocomplete=\"tel\" class=\"pt-input block h-11 w-full rounded border border-[#e6dec8] bg-[#f4efea] px-3.5 text-sm text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-2-1-2-1-2-1-3-2\" data-name=\"phone input field\" id=\"phone\" name=\"phone\" placeholder=\"09xx xxx xxx\" required=\"\" type=\"tel\"/>\n                            </div>\n                            <div data-kid=\"1-2-1-2-1-2-1-4\" data-name=\"password input group\">\n                                <label class=\"mb-2 block text-xs font-semibold text-[#334135]\" data-kid=\"1-2-1-2-1-2-1-4-1\" data-name=\"password label\" for=\"password\">\n                                    Mật khẩu\n                                    <span aria-hidden=\"true\" class=\"text-[#881337]\" data-kid=\"1-2-1-2-1-2-1-4-1-1\" data-name=\"required field asterisk\">\n                                        *\n                                    </span>\n                                </label>\n                                <input autocomplete=\"new-password\" class=\"pt-input block h-11 w-full rounded border border-[#e6dec8] bg-[#f4efea] px-3.5 text-sm text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-2-1-2-1-2-1-4-2\" data-name=\"password input field\" id=\"password\" minlength=\"8\" name=\"password\" placeholder=\"Ít nhất 8 ký tự\" required=\"\" type=\"password\"/>\n                                <p class=\"mt-1.5 text-[11px] leading-4 text-[#7a857c]\" data-kid=\"1-2-1-2-1-2-1-4-3\" data-name=\"password helper text\">\n                                    Dùng tối thiểu 8 ký tự để bảo vệ tài khoản.\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-1-2-1-2-1-5\" data-name=\"confirm password input group\">\n                                <label class=\"mb-2 block text-xs font-semibold text-[#334135]\" data-kid=\"1-2-1-2-1-2-1-5-1\" data-name=\"confirm password label\" for=\"password-confirm\">\n                                    Nhập lại mật khẩu\n                                    <span aria-hidden=\"true\" class=\"text-[#881337]\" data-kid=\"1-2-1-2-1-2-1-5-1-1\" data-name=\"required field asterisk\">\n                                        *\n                                    </span>\n                                </label>\n                                <input autocomplete=\"new-password\" class=\"pt-input block h-11 w-full rounded border border-[#e6dec8] bg-[#f4efea] px-3.5 text-sm text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-2-1-2-1-2-1-5-2\" data-name=\"confirm password input field\" id=\"password-confirm\" minlength=\"8\" name=\"password-confirm\" placeholder=\"Nhập lại mật khẩu của bạn\" required=\"\" type=\"password\"/>\n                            </div>\n                        </div>\n                        <label class=\"mt-6 flex items-start gap-3 text-sm leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"consent checkbox group\" for=\"consent\">\n                            <input class=\"pt-check mt-0.5 h-4 w-4 shrink-0 rounded border-[#c3c8c2]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"consent checkbox\" id=\"consent\" name=\"consent\" required=\"\" type=\"checkbox\"/>\n                            <span data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"consent label text\">\n                                Tôi đồng ý với\n                                <a class=\"pt-link font-semibold text-[#1e2d24] underline decoration-[#c27803] decoration-1 underline-offset-4\" data-kid=\"1-2-1-2-1-2-2-2-1\" data-name=\"terms of service link\" href=\"#\">\n                                    Điều khoản sử dụng\n                                </a>\n                                và\n                                <a class=\"pt-link font-semibold text-[#1e2d24] underline decoration-[#c27803] decoration-1 underline-offset-4\" data-kid=\"1-2-1-2-1-2-2-2-2\" data-name=\"privacy policy link\" href=\"#\">\n                                    Chính sách bảo mật\n                                </a>\n                                của The Page Turner.\n                            </span>\n                        </label>\n                        <button aria-label=\"Tạo tài khoản bạn đọc\" class=\"pt-button mt-6 flex h-12 w-full items-center justify-center gap-2 rounded bg-[#1e2d24] px-5 text-sm font-semibold text-white hover:bg-[#2b4234]\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"submit registration button\" type=\"button\">\n                            Tạo tài khoản\n                            <svg aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"button arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 12h13\">\n                                </path>\n                                <path d=\"m13 6 6 6-6 6\">\n                                </path>\n                            </svg>\n                        </button>\n                        <p class=\"mt-5 text-center text-sm text-[#5a685d]\" data-kid=\"1-2-1-2-1-2-4\" data-name=\"login prompt text\">\n                            Đã có tài khoản?\n                            <a class=\"pt-link font-semibold text-[#1e2d24] underline decoration-[#c27803] decoration-1 underline-offset-4\" data-kid=\"1-2-1-2-1-2-4-1\" data-name=\"login link\" href=\"#\">\n                                Đăng nhập\n                            </a>\n                        </p>\n                    </form>\n                </section>\n                <aside aria-labelledby=\"trust-title\" class=\"rounded-md border border-[#e6dec8] bg-[#f4efea] p-6 sm:p-7\" data-kid=\"1-2-1-2-2\" data-name=\"features aside container\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2-2-1\" data-name=\"feature label header\">\n                        <div aria-hidden=\"true\" class=\"flex h-11 w-11 items-center justify-center rounded bg-[#1e2d24] text-[#fea93e]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"aside icon container\">\n                            <svg class=\"h-5 w-5\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"reading icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M4.5 5.5h6.2a2 2 0 0 1 2 2v11a2 2 0 0 0-2-2H4.5v-11Z\">\n                                </path>\n                                <path d=\"M19.5 5.5h-6.2a2 2 0 0 0-2 2v11a2 2 0 0 1 2-2h6.2v-11Z\">\n                                </path>\n                                <path d=\"M7 8.5h3M7 11h3M17 8.5h-3M17 11h-3\">\n                                </path>\n                            </svg>\n                        </div>\n                        <span class=\"rounded-full border border-[#e5c98f] bg-[#fff3d9] px-2.5 py-1 text-[12px] font-semibold text-[#885200]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"feature label badge\">\n                            Dành cho bạn đọc\n                        </span>\n                    </div>\n                    <p class=\"mt-7 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#c27803]\" data-kid=\"1-2-1-2-2-2\" data-name=\"feature subtitle text\">\n                        Một góc riêng cho bạn\n                    </p>\n                    <h2 class=\"pt-heading mt-2 text-[24px] font-semibold leading-8 tracking-[-0.01em] text-[#1e2d24]\" data-kid=\"1-2-1-2-2-3\" data-name=\"feature section headline\" id=\"trust-title\">\n                        Đọc lâu hơn, giữ lại nhiều hơn.\n                    </h2>\n                    <p class=\"mt-3 text-sm leading-6 text-[#5a685d]\" data-kid=\"1-2-1-2-2-4\" data-name=\"feature section description text\">\n                        Tài khoản giúp mỗi lần ghé tiệm trở nên gọn gàng và gần gũi hơn.\n                    </p>\n                    <div class=\"mt-6 divide-y divide-[#e6dec8] border-y border-[#e6dec8]\" data-kid=\"1-2-1-2-2-5\" data-name=\"feature points list container\">\n                        <div class=\"flex gap-3.5 py-4\" data-kid=\"1-2-1-2-2-5-1\" data-name=\"personal bookshelf feature point\">\n                            <span aria-hidden=\"true\" class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#e5c98f] bg-[#fff3d9] text-[#c27803]\" data-kid=\"1-2-1-2-2-5-1-1\" data-name=\"bookshelf icon container\">\n                                <svg class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-5-1-1-1\" data-name=\"bookshelf icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M4 5h16M4 19h16M6 5v14M18 5v14M8 8h8v4H8zM8 14h8v3H8z\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <div data-kid=\"1-2-1-2-2-5-1-2\" data-name=\"bookshelf feature title\">\n                                <h3 class=\"text-sm font-semibold text-[#334135]\" data-kid=\"1-2-1-2-2-5-1-2-1\">\n                                    Kệ sách cá nhân\n                                </h3>\n                                <p class=\"mt-1 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-2-5-1-2-2\" data-name=\"bookshelf feature description\">\n                                    Lưu những tựa sách muốn đọc và bộ sưu tập đã chọn.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3.5 py-4\" data-kid=\"1-2-1-2-2-5-2\" data-name=\"electronic certificate feature point\">\n                            <span aria-hidden=\"true\" class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#e5c98f] bg-[#fff3d9] text-[#c27803]\" data-kid=\"1-2-1-2-2-5-2-1\" data-name=\"certificate icon container\">\n                                <svg class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-5-2-1-1\" data-name=\"certificate icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M7 4h10v7a5 5 0 0 1-10 0V4Z\">\n                                    </path>\n                                    <path d=\"m9 18 3-2 3 2v3l-3-1-3 1v-3Z\">\n                                    </path>\n                                    <path d=\"M10 8h4M10 10.5h4\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <div data-kid=\"1-2-1-2-2-5-2-2\" data-name=\"certificate feature title\">\n                                <h3 class=\"text-sm font-semibold text-[#334135]\" data-kid=\"1-2-1-2-2-5-2-2-1\">\n                                    Chứng thư điện tử\n                                </h3>\n                                <p class=\"mt-1 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-2-5-2-2-2\" data-name=\"certificate feature description\">\n                                    Tra cứu chứng nhận sở hữu cho các bản sách đặc biệt.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3.5 py-4\" data-kid=\"1-2-1-2-2-5-3\" data-name=\"order tracking feature point\">\n                            <span aria-hidden=\"true\" class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#e5c98f] bg-[#fff3d9] text-[#c27803]\" data-kid=\"1-2-1-2-2-5-3-1\" data-name=\"tracking icon container\">\n                                <svg class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-5-3-1-1\" data-name=\"tracking icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"m4 7 8-4 8 4-8 4-8-4Z\">\n                                    </path>\n                                    <path d=\"M4 7v10l8 4 8-4V7M12 11v10M8 5l8 4\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <div data-kid=\"1-2-1-2-2-5-3-2\" data-name=\"tracking feature title\">\n                                <h3 class=\"text-sm font-semibold text-[#334135]\" data-kid=\"1-2-1-2-2-5-3-2-1\">\n                                    Theo dõi đơn hàng\n                                </h3>\n                                <p class=\"mt-1 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-2-5-3-2-2\" data-name=\"tracking feature description\">\n                                    Xem trạng thái đóng gói, giao nhận và lịch sử mua.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 flex items-start gap-2.5 rounded border border-[#e4d7c2] bg-[#fffdfa] px-3 py-3 text-[11px] leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-2-6\" data-name=\"privacy assurance container\">\n                        <svg aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-[#c27803]\" data-kid=\"1-2-1-2-2-6-1\" data-name=\"shield icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M12 3 5 6v5c0 4.5 2.8 7.8 7 10 4.2-2.2 7-5.5 7-10V6l-7-3Z\">\n                            </path>\n                            <path d=\"m9 12 2 2 4-4\">\n                            </path>\n                        </svg>\n                        <span data-kid=\"1-2-1-2-2-6-2\" data-name=\"privacy assurance text\">\n                            Thông tin của bạn được giữ riêng tư và chỉ dùng để hỗ trợ trải nghiệm mua sách.\n                        </span>\n                    </div>\n                </aside>\n            </div>\n        </div>\n    </main>\n    <footer class=\"border-t border-[#e6dec8] bg-[#f4efea] px-4 py-10 sm:px-6 md:px-10 md:py-12\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-3-1\" data-name=\"footer inner wrapper\">\n            <div class=\"grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12\" data-kid=\"1-3-1-1\" data-name=\"footer link sections grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"brand footer column\">\n                    <h2 class=\"pt-heading text-[17px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer brand name\">\n                        The Page Turner\n                    </h2>\n                    <p class=\"mt-3 max-w-[230px] text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand description\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách là một chứng nhân của thời gian.\n                    </p>\n                    <p class=\"mt-4 flex items-center gap-1.5 text-[11px] font-semibold text-[#5a685d]\" data-kid=\"1-3-1-1-1-3\" data-name=\"location badge container\">\n                        <svg aria-hidden=\"true\" class=\"h-3.5 w-3.5 text-[#c27803]\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"location map pin icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"m12 21-7-7a4.95 4.95 0 1 1 7-7 4.95 4.95 0 1 1 7 7l-7 7Z\">\n                            </path>\n                            <circle cx=\"12\" cy=\"10\" r=\"2\">\n                            </circle>\n                        </svg>\n                        Tiệm sách độc lập Hà Nội\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"policies footer column\">\n                    <h2 class=\"text-xs font-semibold text-[#334135]\" data-kid=\"1-3-1-1-2-1\" data-name=\"policies header\">\n                        Hỗ trợ & Chính sách\n                    </h2>\n                    <ul class=\"mt-3 space-y-2 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-2-2\" data-name=\"policies link list\">\n                        <li data-kid=\"1-3-1-1-2-2-1\" data-name=\"policy link 1\">\n                            <a class=\"pt-link\" data-kid=\"1-3-1-1-2-2-1-1\" href=\"#\">\n                                Quy chuẩn phân loại tình trạng sách\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-2\" data-name=\"policy link 2\">\n                            <a class=\"pt-link\" data-kid=\"1-3-1-1-2-2-2-1\" href=\"#\">\n                                Chính sách kiểm tra & đổi trả 7 ngày\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-3\" data-name=\"policy link 3\">\n                            <a class=\"pt-link\" data-kid=\"1-3-1-1-2-2-3-1\" href=\"#\">\n                                Giao hàng & đóng gói chuyên dụng\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-4\" data-name=\"policy link 4\">\n                            <a class=\"pt-link\" data-kid=\"1-3-1-1-2-2-4-1\" href=\"#\">\n                                Ký gửi & thu mua sách cổ hiếm\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"contact footer column\">\n                    <h2 class=\"text-xs font-semibold text-[#334135]\" data-kid=\"1-3-1-1-3-1\" data-name=\"contact header\">\n                        Liên hệ tiệm sách\n                    </h2>\n                    <ul class=\"mt-3 space-y-2 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-3-2\" data-name=\"contact info list\">\n                        <li class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"address contact item\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-[#c27803]\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"address icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 21s6-5.3 6-11a6 6 0 1 0-12 0c0 5.7 6 11 6 11Z\">\n                                </path>\n                                <circle cx=\"12\" cy=\"10\" r=\"2\">\n                                </circle>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-1-2\">\n                                42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                            </span>\n                        </li>\n                        <li class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"hotline contact item\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-[#c27803]\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"phone icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M6 4h3l1.5 4-2 1.4a14 14 0 0 0 6.1 6.1l1.4-2 4 1.5v3c0 1-1 2-2 2C10.3 20 4 13.7 4 6c0-1 1-2 2-2Z\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-2-2\">\n                                Hotline: 0988 123 456\n                            </span>\n                        </li>\n                        <li class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"email contact item\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-[#c27803]\" data-kid=\"1-3-1-1-3-2-3-1\" data-name=\"email icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <rect height=\"14\" rx=\"1.5\" width=\"18\" x=\"3\" y=\"5\">\n                                </rect>\n                                <path d=\"m4 7 8 6 8-6\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-3-2\">\n                                thuthu@thepageturner.vn\n                            </span>\n                        </li>\n                        <li class=\"flex gap-2\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"hours contact item\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-[#c27803]\" data-kid=\"1-3-1-1-3-2-4-1\" data-name=\"clock icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                <circle cx=\"12\" cy=\"12\" r=\"8.5\">\n                                </circle>\n                                <path d=\"M12 7v5l3 2\">\n                                </path>\n                            </svg>\n                            <span data-kid=\"1-3-1-1-3-2-4-2\">\n                                Mở cửa: 08:30 – 21:30 hàng ngày\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"newsletter footer column\">\n                    <h2 class=\"text-xs font-semibold text-[#334135]\" data-kid=\"1-3-1-1-4-1\" data-name=\"newsletter header\">\n                        Bản tin Sách Hiếm\n                    </h2>\n                    <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Nhận danh mục bản tuyển chọn, sách chữ ký và bản in đầu phát hành mỗi tuần.\n                    </p>\n                    <label class=\"sr-only\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter input label\" for=\"newsletter\">\n                        Địa chỉ email nhận bản tin\n                    </label>\n                    <input class=\"pt-input mt-4 h-10 w-full rounded border border-[#e6dec8] bg-[#fffdfa] px-3 text-xs text-[#334135] placeholder:text-[#8a938b]\" data-kid=\"1-3-1-1-4-4\" data-name=\"newsletter email input field\" id=\"newsletter\" placeholder=\"Địa chỉ email của bạn...\" type=\"email\"/>\n                    <button class=\"pt-button mt-3 h-10 w-full rounded bg-[#1e2d24] px-3 text-xs font-semibold text-white hover:bg-[#2b4234]\" data-kid=\"1-3-1-1-4-5\" data-name=\"subscribe newsletter button\" type=\"button\">\n                        Đăng ký nhận tin\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-9 flex flex-col gap-3 border-t border-[#e6dec8] pt-4 text-[10px] leading-4 text-[#5a685d] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer copyright section\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </span>\n                <div class=\"flex flex-wrap gap-x-5 gap-y-1\" data-kid=\"1-3-1-2-2\" data-name=\"legal links container\">\n                    <a class=\"pt-link\" data-kid=\"1-3-1-2-2-1\" data-name=\"terms of service footer link\" href=\"#\">\n                        Điều khoản dịch vụ\n                    </a>\n                    <a class=\"pt-link\" data-kid=\"1-3-1-2-2-2\" data-name=\"privacy policy footer link\" href=\"#\">\n                        Chính sách bảo mật\n                    </a>\n                    <a class=\"pt-link\" data-kid=\"1-3-1-2-2-3\" data-name=\"authenticity certificate footer link\" href=\"#\">\n                        Chứng thực ấn bản\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n",
