        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap');\n\n  .ptp-interface {\n    font-family: 'Be Vietnam Pro', sans-serif;\n  }\n\n  .ptp-display {\n    font-family: 'Playfair Display', Georgia, serif;\n  }\n\n  .ptp-footer-contact p {\n    font-size: 12px;\n  }\n\n  .ptp-footer-contact span {\n    display: flex;\n    align-items: flex-start;\n    gap: 0.375rem;\n  }\n\n  .ptp-footer-contact span svg {\n    margin-top: 0.125rem;\n    flex-shrink: 0;\n  }\n\n  .ptp-footer-contact br {\n    display: none;\n  }\n\n  .ptp-footer-contact span + span {\n    margin-top: 0.25rem;\n  }\n</style>\n<div class=\"ptp-interface w-full bg-[#fbf9f6] text-[#1b1c1a]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#e6dec8] bg-[#fbf9f6]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"border-b border-[#e6dec8] px-4 py-2 text-[11px] leading-4 text-[#5a685d] sm:px-6\" data-kid=\"1-1-1\" data-name=\"top utility bar\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-6\" data-kid=\"1-1-1-1\" data-name=\"utility bar container\">\n                <p class=\"hidden sm:block\" data-kid=\"1-1-1-1-1\" data-name=\"promotional text\">\n                    Cam kết 100% ảnh thật chụp trực tiếp từng cuốn sách · Kiểm tra trước khi thanh toán\n                </p>\n                <p class=\"ml-auto whitespace-nowrap\" data-kid=\"1-1-1-1-2\" data-name=\"store hours and hotline information\">\n                    Hà Nội: 08:30 – 21:30\n                    <span class=\"mx-2 text-[#c27803]\" data-kid=\"1-1-1-1-2-1\" data-name=\"dot separator icon\">\n                        •\n                    </span>\n                    Hotline: 0988 123 456\n                </p>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-[1200px] flex-col gap-3 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:gap-5\" data-kid=\"1-1-2\" data-name=\"header branding and navigation area\">\n            <a aria-label=\"The Page Turner, về trang chủ\" class=\"flex shrink-0 items-center gap-3 text-[#1e2d24]\" data-kid=\"1-1-2-1\" data-name=\"logo and brand link\" href=\"#top\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-sm bg-[#1e2d24] text-[#fef3df]\" data-kid=\"1-1-2-1-1\" data-name=\"logo icon container\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-1-2-1-1-1\" data-name=\"book icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"18\">\n                        <path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z\">\n                        </path>\n                        <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20M8 7h8M8 10h6\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"leading-[1.05]\" data-kid=\"1-1-2-1-2\" data-name=\"brand name and tagline container\">\n                    <span class=\"ptp-display block text-[16px] font-semibold\" data-kid=\"1-1-2-1-2-1\" data-name=\"brand name text\">\n                        The Page Turner\n                    </span>\n                    <span class=\"mt-1 block text-[9px] font-semibold tracking-[0.16em] text-[#5a685d]\" data-kid=\"1-1-2-1-2-2\" data-name=\"brand tagline text\">\n                        SÁCH CŨ & QUÝ HIẾM\n                    </span>\n                </span>\n            </a>\n            <div class=\"flex min-w-0 flex-1 items-center border border-[#e6dec8] bg-[#f4efea] px-3 py-2 text-[12px] text-[#5a685d]\" data-kid=\"1-1-2-2\" data-name=\"search input container\">\n                <svg aria-hidden=\"true\" class=\"mr-2 shrink-0 text-[#1e2d24]\" data-kid=\"1-1-2-2-1\" data-name=\"search magnifying glass icon\" fill=\"none\" height=\"15\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"15\">\n                    <circle cx=\"11\" cy=\"11\" r=\"6.5\">\n                    </circle>\n                    <path d=\"m16 16 4.5 4.5\">\n                    </path>\n                </svg>\n                <span class=\"truncate\" data-kid=\"1-1-2-2-2\" data-name=\"search placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản\n                </span>\n                <span class=\"ml-auto hidden shrink-0 border-l border-[#e6dec8] pl-3 text-[11px] text-[#737873] sm:block\" data-kid=\"1-1-2-2-3\" data-name=\"founding date label\">\n                    Từ 1975\n                </span>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-4 text-[12px] text-[#334135]\" data-kid=\"1-1-2-3\" data-name=\"user actions navigation bar\">\n                <a class=\"hidden items-center gap-1.5 transition hover:text-[#885200] xl:flex\" data-kid=\"1-1-2-3-1\" data-name=\"favorites link\" href=\"#favorites\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-1-2-3-1-1\" data-name=\"heart icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"14\">\n                        <path d=\"M20.8 8.7c0 5.3-8.8 10.3-8.8 10.3S3.2 14 3.2 8.7A4.7 4.7 0 0 1 12 6.2a4.7 4.7 0 0 1 8.8 2.5Z\">\n                        </path>\n                    </svg>\n                    Yêu thích\n                </a>\n                <a class=\"hidden items-center gap-1.5 transition hover:text-[#885200] xl:flex\" data-kid=\"1-1-2-3-2\" data-name=\"cart link\" href=\"#cart\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-1-2-3-2-1\" data-name=\"shopping cart icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"14\">\n                        <path d=\"M4 5h2l1.6 10.1a2 2 0 0 0 2 1.7h7.8a2 2 0 0 0 1.9-1.4L21 8H7\">\n                        </path>\n                        <circle cx=\"10\" cy=\"20\" r=\"1\">\n                        </circle>\n                        <circle cx=\"18\" cy=\"20\" r=\"1\">\n                        </circle>\n                    </svg>\n                    Giỏ hàng\n                </a>\n                <a class=\"flex items-center gap-2 font-semibold\" data-kid=\"1-1-2-3-3\" data-name=\"account link\" href=\"#account\">\n                    <span class=\"flex h-6 w-6 items-center justify-center rounded-full bg-[#1e2d24] text-white\" data-kid=\"1-1-2-3-3-1\" data-name=\"user icon container\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-1-2-3-3-1-1\" data-name=\"user profile icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <circle cx=\"12\" cy=\"8\" r=\"3.2\">\n                            </circle>\n                            <path d=\"M5.5 20c.7-3.4 3-5.2 6.5-5.2s5.8 1.8 6.5 5.2\">\n                            </path>\n                        </svg>\n                    </span>\n                    Thành viên\n                </a>\n            </div>\n        </div>\n        <nav aria-label=\"Điều hướng chính\" class=\"border-t border-[#f0ece6] px-4 sm:px-6\" data-kid=\"1-1-3\" data-name=\"main navigation bar\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center gap-6 overflow-x-auto whitespace-nowrap py-3 text-[11px] text-[#434844]\" data-kid=\"1-1-3-1\" data-name=\"navigation link container\">\n                <a class=\"font-medium text-[#1e2d24]\" data-kid=\"1-1-3-1-1\" data-name=\"home link\" href=\"#home\">\n                    Trang chủ\n                </a>\n                <a data-kid=\"1-1-3-1-2\" data-name=\"catalog link\" href=\"#catalog\">\n                    Danh mục sách\n                </a>\n                <a data-kid=\"1-1-3-1-3\" data-name=\"advanced search link\" href=\"#search\">\n                    Tìm kiếm nâng cao\n                </a>\n                <a data-kid=\"1-1-3-1-4\" data-name=\"literature link\" href=\"#literature\">\n                    Văn học\n                </a>\n                <a data-kid=\"1-1-3-1-5\" data-name=\"business link\" href=\"#business\">\n                    Kinh tế\n                </a>\n                <a data-kid=\"1-1-3-1-6\" data-name=\"mind link\" href=\"#mind\">\n                    Tâm lý\n                </a>\n                <a data-kid=\"1-1-3-1-7\" data-name=\"rare books link\" href=\"#rare\">\n                    Sách hiếm\n                </a>\n                <a data-kid=\"1-1-3-1-8\" data-name=\"sale books link\" href=\"#sale\">\n                    Sách giảm giá\n                </a>\n                <a data-kid=\"1-1-3-1-9\" data-name=\"checkout link\" href=\"#checkout\">\n                    Giỏ hàng & Thanh toán\n                </a>\n            </div>\n        </nav>\n    </header>\n    <main class=\"px-4 py-12 sm:px-6 lg:px-10 lg:py-16\" data-kid=\"1-2\" data-name=\"main page content\" id=\"top\">\n        <div class=\"mx-auto max-w-[1080px]\" data-kid=\"1-2-1\" data-name=\"recovery page layout container\">\n            <nav aria-label=\"Đường dẫn\" class=\"mb-8 flex items-center gap-2 text-[12px] text-[#737873]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation bar\">\n                <a data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb home link\" href=\"#home\">\n                    Trang chủ\n                </a>\n                <span aria-hidden=\"true\" class=\"text-[#c27803]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator one\">\n                    /\n                </span>\n                <a data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb account link\" href=\"#account\">\n                    Tài khoản\n                </a>\n                <span aria-hidden=\"true\" class=\"text-[#c27803]\" data-kid=\"1-2-1-1-4\" data-name=\"breadcrumb separator two\">\n                    /\n                </span>\n                <span aria-current=\"page\" class=\"text-[#1e2d24]\" data-kid=\"1-2-1-1-5\" data-name=\"current page breadcrumb label\">\n                    Khôi phục mật khẩu\n                </span>\n            </nav>\n            <div class=\"grid overflow-hidden border border-[#e6dec8] bg-white lg:grid-cols-[minmax(0,1.28fr)_minmax(300px,0.72fr)]\" data-kid=\"1-2-1-2\" data-name=\"recovery form content grid\">\n                <article aria-labelledby=\"recovery-title\" class=\"p-7 sm:p-10 lg:p-14\" data-kid=\"1-2-1-2-1\" data-name=\"recovery form article\">\n                    <div class=\"mb-9 flex items-center gap-3 text-[10px] font-semibold tracking-[0.16em] text-[#885200]\" data-kid=\"1-2-1-2-1-1\" data-name=\"section metadata container\">\n                        <span aria-hidden=\"true\" class=\"h-px w-8 bg-[#c27803]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"decorative horizontal rule\">\n                        </span>\n                        TÀI KHOẢN & BẢO TỒN\n                    </div>\n                    <h1 class=\"ptp-display max-w-[520px] text-[32px] font-semibold leading-[1.24] tracking-[-0.01em] text-[#1e2d24] sm:text-[38px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"recovery headline\" id=\"recovery-title\">\n                        Khôi phục quyền truy cập\n                    </h1>\n                    <p class=\"mt-5 max-w-[520px] text-[15px] leading-7 text-[#5a685d]\" data-kid=\"1-2-1-2-1-3\" data-name=\"recovery instruction text\">\n                        Nhập địa chỉ email bạn đã dùng để đăng ký. Chúng tôi sẽ gửi một liên kết để bạn đặt lại mật khẩu và trở lại với giá sách của mình.\n                    </p>\n                    <form action=\"#\" class=\"mt-9 max-w-[520px]\" data-kid=\"1-2-1-2-1-4\" data-name=\"recovery form\" method=\"post\">\n                        <label class=\"mb-2 block text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"email input label\" for=\"recovery-email\">\n                            Địa chỉ email\n                        </label>\n                        <input aria-describedby=\"email-help\" autocomplete=\"email\" class=\"w-full rounded-sm border border-[#c3c8c2] bg-[#f4efea] px-4 py-3.5 text-[14px] text-[#1e2d24] outline-none placeholder:text-[#8b938d] focus:border-[#c27803] focus:ring-1 focus:ring-[#c27803]\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"email input field\" id=\"recovery-email\" name=\"email\" placeholder=\"ban@example.com\" required=\"\" type=\"email\"/>\n                        <p class=\"mt-1 text-[11px] leading-5 text-[#737873]\" data-kid=\"1-2-1-2-1-4-3\" data-name=\"email help text\" id=\"email-help\">\n                            Liên kết khôi phục có hiệu lực trong 30 phút.\n                        </p>\n                        <button class=\"mt-6 flex w-full items-center justify-center gap-3 rounded-sm bg-[#1e2d24] px-5 py-3.5 text-[13px] font-semibold text-white transition hover:bg-[#2c4436] focus:outline-none focus:ring-2 focus:ring-[#c27803] focus:ring-offset-2\" data-kid=\"1-2-1-2-1-4-4\" data-name=\"submit recovery email button\" type=\"submit\">\n                            <span data-kid=\"1-2-1-2-1-4-4-1\" data-name=\"button label text\">\n                                Gửi liên kết khôi phục\n                            </span>\n                            <svg aria-hidden=\"true\" data-kid=\"1-2-1-2-1-4-4-2\" data-name=\"arrow right icon\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"16\">\n                                <path d=\"M4 12h15M13 6l6 6-6 6\">\n                                </path>\n                            </svg>\n                        </button>\n                    </form>\n                    <a class=\"mt-6 inline-flex items-center gap-2 text-[12px] font-semibold text-[#1e2d24] underline decoration-[#c27803] decoration-1 underline-offset-4 transition hover:text-[#885200]\" data-kid=\"1-2-1-2-1-5\" data-name=\"back to login link\" href=\"#login\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-2-1-2-1-5-1\" data-name=\"arrow left icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"14\">\n                            <path d=\"M20 12H5M11 6l-6 6 6 6\">\n                            </path>\n                        </svg>\n                        Quay lại đăng nhập\n                    </a>\n                    <div class=\"mt-10 border-t border-[#e6dec8] pt-5 text-[11px] leading-5 text-[#5a685d]\" data-kid=\"1-2-1-2-1-6\" data-name=\"privacy note container\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-1-2-1-6-1\" data-name=\"privacy note icon and text block\">\n                            <svg aria-hidden=\"true\" class=\"mt-0.5 shrink-0 text-[#885200]\" data-kid=\"1-2-1-2-1-6-1-1\" data-name=\"shield check icon\" fill=\"none\" height=\"15\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"15\">\n                                <path d=\"M12 3 4.5 6.5v5.2c0 4.4 3.1 7.7 7.5 9.3 4.4-1.6 7.5-4.9 7.5-9.3V6.5L12 3Z\">\n                                </path>\n                                <path d=\"m9 12 2 2 4-4\">\n                                </path>\n                            </svg>\n                            <p data-kid=\"1-2-1-2-1-6-1-2\" data-name=\"privacy note text\">\n                                <span class=\"font-semibold text-[#1e2d24]\" data-kid=\"1-2-1-2-1-6-1-2-1\" data-name=\"privacy note emphasis text\">\n                                    Ghi chú riêng tư.\n                                </span>\n                                Email của bạn chỉ được dùng để xác nhận quyền sở hữu tài khoản. The Page Turner không chia sẻ thông tin này cho bên thứ ba.\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <aside aria-labelledby=\"archive-panel-title\" class=\"relative overflow-hidden bg-[#1e2d24] p-7 text-[#f2f0ed] sm:p-10 lg:p-12\" data-kid=\"1-2-1-2-2\" data-name=\"aside archive information panel\">\n                    <div aria-hidden=\"true\" class=\"absolute right-7 top-7 h-24 w-28 border-r border-t border-[#b9cbbe]/25\" data-kid=\"1-2-1-2-2-1\" data-name=\"decorative corner lines\">\n                        <span class=\"absolute right-0 top-0 h-1.5 w-1.5 bg-[#c27803]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"decorative corner dot\">\n                        </span>\n                    </div>\n                    <div class=\"relative flex h-full flex-col justify-between gap-12\" data-kid=\"1-2-1-2-2-2\" data-name=\"panel text content container\">\n                        <div data-kid=\"1-2-1-2-2-2-1\" data-name=\"panel headline group\">\n                            <p class=\"text-[10px] font-semibold tracking-[0.18em] text-[#b9cbbe]\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"panel category label\">\n                                HỒ SƠ LƯU TRỮ · 01\n                            </p>\n                            <h2 class=\"ptp-display mt-8 text-[25px] leading-[1.35] text-[#f2f0ed]\" data-kid=\"1-2-1-2-2-2-1-2\" data-name=\"panel headline\" id=\"archive-panel-title\">\n                                Giá sách của bạn luôn được bảo toàn.\n                            </h2>\n                            <p class=\"mt-5 text-[13px] leading-6 text-[#d5e7d9]/80\" data-kid=\"1-2-1-2-2-2-1-3\" data-name=\"panel description text\">\n                                Mỗi tài khoản là một phần trong hành trình sưu tầm riêng. Khi bạn khôi phục quyền truy cập, các chứng thư điện tử và danh mục sách cá nhân vẫn ở đúng vị trí.\n                            </p>\n                            <div class=\"mt-9 border-y border-[#b9cbbe]/20 py-4 text-[11px]\" data-kid=\"1-2-1-2-2-2-1-4\" data-name=\"archive features list\">\n                                <div class=\"flex items-center gap-3 border-b border-[#b9cbbe]/15 pb-3\" data-kid=\"1-2-1-2-2-2-1-4-1\" data-name=\"feature one row\">\n                                    <span class=\"text-[#fea93e]\" data-kid=\"1-2-1-2-2-2-1-4-1-1\" data-name=\"feature index number one\">\n                                        01\n                                    </span>\n                                    <span class=\"text-[#f2f0ed]/90\" data-kid=\"1-2-1-2-2-2-1-4-1-2\" data-name=\"feature title one\">\n                                        Chứng thư điện tử\n                                    </span>\n                                    <span class=\"ml-auto text-[#b9cbbe]\" data-kid=\"1-2-1-2-2-2-1-4-1-3\" data-name=\"feature status one\">\n                                        Được giữ nguyên\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 pt-3\" data-kid=\"1-2-1-2-2-2-1-4-2\" data-name=\"feature two row\">\n                                    <span class=\"text-[#fea93e]\" data-kid=\"1-2-1-2-2-2-1-4-2-1\" data-name=\"feature index number two\">\n                                        02\n                                    </span>\n                                    <span class=\"text-[#f2f0ed]/90\" data-kid=\"1-2-1-2-2-2-1-4-2-2\" data-name=\"feature title two\">\n                                        Giá sách cá nhân\n                                    </span>\n                                    <span class=\"ml-auto text-[#b9cbbe]\" data-kid=\"1-2-1-2-2-2-1-4-2-3\" data-name=\"feature status two\">\n                                        Đồng bộ an toàn\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"border-t border-[#b9cbbe]/25 pt-6\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"panel footer section\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"security assurance block\">\n                                <span aria-hidden=\"true\" class=\"mt-1 text-[14px] text-[#fea93e]\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"star icon\">\n                                    ✦\n                                </span>\n                                <p class=\"text-[12px] leading-5 text-[#f2f0ed]/80\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"security assurance text\">\n                                    Bảo mật được chúng tôi gìn giữ như một trang sách quý: kín đáo, rõ ràng và có thể kiểm chứng.\n                                </p>\n                            </div>\n                            <p class=\"mt-7 text-[10px] tracking-[0.15em] text-[#b9cbbe]\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"panel footer identity text\">\n                                THE PAGE TURNER · HÀ NỘI\n                            </p>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </div>\n    </main>\n    <footer class=\"border-t border-[#e6dec8] bg-[#f5f3f0] px-6 py-12\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto grid max-w-[1200px] gap-10 md:grid-cols-4\" data-kid=\"1-3-1\" data-name=\"footer links grid\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer brand column\">\n                <p class=\"ptp-display text-[15px] text-[#1e2d24]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand name\">\n                    The Page Turner\n                </p>\n                <p class=\"mt-3 text-[12px] leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-2\" data-name=\"footer description text\">\n                    Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách cũ là một chứng nhân của thời gian.\n                </p>\n                <p class=\"mt-4 flex items-center gap-2 text-[12px] text-[#5a685d]\" data-kid=\"1-3-1-1-3\" data-name=\"footer location label\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-3-1-1-3-1\" data-name=\"map pin icon\" fill=\"none\" height=\"13\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"13\">\n                        <path d=\"M5 19h14M7 19V7l5-3 5 3v12M9 9h6M9 12h6\">\n                        </path>\n                    </svg>\n                    Tiệm sách độc lập Hà Nội\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\" data-name=\"policy links column\">\n                <p class=\"mb-3 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-2-1\" data-name=\"policy title\">\n                    Hỗ trợ & Chính sách\n                </p>\n                <p class=\"text-[12px] leading-6 text-[#5a685d]\" data-kid=\"1-3-1-2-2\" data-name=\"policy links\">\n                    Quy chuẩn phân loại tình trạng sách\n                    <br data-kid=\"1-3-1-2-2-1\" data-name=\"line break one\"/>\n                    Chính sách kiểm tra & đổi trả 7 ngày\n                    <br data-kid=\"1-3-1-2-2-2\" data-name=\"line break two\"/>\n                    Giao hàng & đóng gói chuyên dụng\n                    <br data-kid=\"1-3-1-2-2-3\" data-name=\"line break three\"/>\n                    Ký gửi & thu mua sách cũ hiếm\n                </p>\n            </div>\n            <div class=\"ptp-footer-contact\" data-kid=\"1-3-1-3\" data-name=\"contact information column\">\n                <p class=\"mb-3 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-3-1\" data-name=\"contact title\">\n                    Liên hệ tiệm sách\n                </p>\n                <p class=\"text-[11px] leading-6 text-[#5a685d]\" data-kid=\"1-3-1-3-2\" data-name=\"contact details list\">\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-3-1-3-2-1\" data-name=\"address line\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"location marker icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <path d=\"M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z\">\n                            </path>\n                            <circle cx=\"12\" cy=\"10\" r=\"2\">\n                            </circle>\n                        </svg>\n                        42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                    </span>\n                    <br data-kid=\"1-3-1-3-2-2\" data-name=\"line break four\"/>\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-3-1-3-2-3\" data-name=\"hotline line\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-3-1-3-2-3-1\" data-name=\"phone handset icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <path d=\"M6.5 4.5h3l1.3 4-2 1.5a15 15 0 0 0 5.2 5.2l1.5-2 4 1.3v3c0 1-1 1.8-2 1.8C11 19.3 4.7 13 4.7 6.5c0-1 0.8-2 1.8-2Z\">\n                            </path>\n                        </svg>\n                        Hotline: 0988 123 456\n                    </span>\n                    <br data-kid=\"1-3-1-3-2-4\" data-name=\"line break five\"/>\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-3-1-3-2-5\" data-name=\"email line\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-3-1-3-2-5-1\" data-name=\"envelope icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <rect height=\"14\" rx=\"1.5\" width=\"18\" x=\"3\" y=\"5\">\n                            </rect>\n                            <path d=\"m4 7 8 6 8-6\">\n                            </path>\n                        </svg>\n                        thuthu@thepageturner.vn\n                    </span>\n                    <br data-kid=\"1-3-1-3-2-6\" data-name=\"line break six\"/>\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-3-1-3-2-7\" data-name=\"hours line\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-3-1-3-2-7-1\" data-name=\"clock icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <circle cx=\"12\" cy=\"12\" r=\"8.5\">\n                            </circle>\n                            <path d=\"M12 7v5l3 2\">\n                            </path>\n                        </svg>\n                        Mở cửa: 08:30 – 21:30 hàng ngày\n                    </span>\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-4\" data-name=\"newsletter signup column\">\n                <p class=\"mb-3 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-4-1\" data-name=\"newsletter title\">\n                    Bản tin Sách Hiếm\n                </p>\n                <p class=\"mb-2 text-[12px] leading-5 text-[#5a685d]\" data-kid=\"1-3-1-4-2\" data-name=\"newsletter description\">\n                    Nhận danh mục bản tuyển chọn, sách cũ ký và bản in đầu phát hành mỗi tuần.\n                </p>\n                <form action=\"#\" data-kid=\"1-3-1-4-3\" data-name=\"newsletter form\" method=\"post\">\n                    <label class=\"sr-only\" data-kid=\"1-3-1-4-3-1\" data-name=\"newsletter email label\" for=\"newsletter-email\">\n                        Địa chỉ email nhận tin\n                    </label>\n                    <input class=\"w-full rounded-sm border border-[#e6dec8] bg-[#fbf9f6] px-3 py-2 text-[11px] text-[#1e2d24] outline-none placeholder:text-[#737873] focus:border-[#c27803] focus:ring-1 focus:ring-[#c27803]\" data-kid=\"1-3-1-4-3-2\" data-name=\"newsletter email input\" id=\"newsletter-email\" name=\"newsletter\" placeholder=\"Địa chỉ email của bạn...\" type=\"email\"/>\n                    <button class=\"mt-2 w-full rounded-sm bg-[#1e2d24] px-4 py-2 text-[11px] font-semibold text-white transition hover:bg-[#2c4436] focus:outline-none focus:ring-2 focus:ring-[#c27803] focus:ring-offset-2\" data-kid=\"1-3-1-4-3-3\" data-name=\"newsletter subscribe button\" type=\"submit\">\n                        Đăng ký nhận tin\n                    </button>\n                </form>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-10 flex max-w-[1200px] flex-col gap-3 border-t border-[#e6dec8] pt-5 text-[10px] text-[#737873] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-2\" data-name=\"copyright and legal section\">\n            <span data-kid=\"1-3-2-1\" data-name=\"copyright notice text\">\n                © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n            </span>\n            <span data-kid=\"1-3-2-2\" data-name=\"footer legal links text\">\n                Điều khoản dịch vụ    Chính sách bảo mật    Chứng thư ấn bản\n            </span>\n        </div>\n    </footer>\n</div>\n",
