      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0');\n.font-body{font-family:'Be Vietnam Pro',sans-serif}.font-display{font-family:'Playfair Display',serif}.material-symbols-outlined{font-family:'Material Symbols Outlined';font-weight:400;font-style:normal;font-size:1em;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;word-wrap:normal;direction:ltr;-webkit-font-feature-settings:'liga';-webkit-font-smoothing:antialiased}.line-clamp-2{-webkit-line-clamp:3!important;line-clamp:3!important}@media (min-width:768px){header input[type='search']{padding-right:12rem!important}}@media (max-width:767px){section[aria-label='Chủ đề văn học Việt Nam']{-webkit-mask-image:linear-gradient(to right,#000 0%,#000 calc(100% - 30px),transparent 100%);mask-image:linear-gradient(to right,#000 0%,#000 calc(100% - 30px),transparent 100%)}}\n</style>\n<div class=\"w-full bg-[#fbf9f6] font-body text-[#1b1c1a]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"w-full\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"border-b border-[#e6dec8] bg-[#f4efea] px-4 py-2 text-[11px] leading-4 text-[#5a685d] sm:px-6\" data-kid=\"1-1-1\" data-name=\"top utility bar\">\n            <div class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-4\" data-kid=\"1-1-1-1\" data-name=\"utility bar content wrapper\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-1\" data-name=\"utility bar left content\">\n                    <span class=\"material-symbols-outlined text-[15px] text-[#c27803]\" data-kid=\"1-1-1-1-1-1\" data-name=\"verified user icon\">\n                        verified_user\n                    </span>\n                    <span data-kid=\"1-1-1-1-1-2\" data-name=\"store policy text\">\n                        Cam kết 100% ảnh thật chụp trực tiếp tình trạng từng cuốn sách • Kiểm tra hàng trước khi thanh toán • Đổi trả miễn phí 7 ngày\n                    </span>\n                </div>\n                <div class=\"hidden shrink-0 items-center gap-3 md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"utility bar right content\">\n                    <span data-kid=\"1-1-1-1-2-1\" data-name=\"hanoi working hours text\">\n                        Hà Nội: 08:30 – 21:30\n                    </span>\n                    <span class=\"text-[#c3c8c2]\" data-kid=\"1-1-1-1-2-2\" data-name=\"separator text\">\n                        |\n                    </span>\n                    <span data-kid=\"1-1-1-1-2-3\" data-name=\"hotline number text\">\n                        Hotline: 0988 123 456\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"border-b border-[#e6dec8] bg-[#fbf9f6] px-4 py-4 sm:px-6 lg:py-5\" data-kid=\"1-1-2\" data-name=\"navigation header\">\n            <div class=\"mx-auto flex max-w-[1320px] items-center gap-4 lg:gap-6\" data-kid=\"1-1-2-1\" data-name=\"navigation header content wrapper\">\n                <a aria-label=\"The Page Turner\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded bg-[#1e2d24] text-[#ffddbb]\" data-kid=\"1-1-2-1-1-1\" data-name=\"brand logo icon container\">\n                        <span class=\"material-symbols-outlined text-[22px]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"book icon\">\n                            menu_book\n                        </span>\n                    </span>\n                    <span class=\"hidden sm:block\" data-kid=\"1-1-2-1-1-2\" data-name=\"brand text container\">\n                        <span class=\"font-display block text-[21px] leading-none tracking-[-.02em] text-[#1e2d24]\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"brand name heading\">\n                            The Page Turner\n                        </span>\n                        <span class=\"mt-1 block text-[10px] font-semibold uppercase tracking-[.17em] text-[#5a685d]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"brand subtitle text\">\n                            Sách cũ & Quý hiếm\n                        </span>\n                    </span>\n                </a>\n                <div class=\"hidden min-w-0 flex-1 md:block\" data-kid=\"1-1-2-1-2\" data-name=\"desktop search field container\">\n                    <div class=\"relative flex items-center\" data-kid=\"1-1-2-1-2-1\" data-name=\"search input container\">\n                        <span class=\"material-symbols-outlined absolute left-3.5 text-[19px] text-[#5a685d]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"search magnifying glass icon\">\n                            search\n                        </span>\n                        <input aria-label=\"Tìm kiếm sách\" class=\"w-full rounded border border-[#e6dec8] bg-[#f4efea] py-3 pl-10 pr-36 text-[13px] text-[#1e2d24] outline-none placeholder:text-[#5a685d] focus:border-[#c27803]\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"search input field\" placeholder=\"Tìm kiếm sách, tác giả, nhà xuất bản, ISBN...\" type=\"search\"/>\n                        <div class=\"absolute right-2 flex items-center gap-1\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"quick tags container\">\n                            <span class=\"rounded bg-[#eae8e5] px-2 py-1 text-[10px] text-[#5a685d]\" data-kid=\"1-1-2-1-2-1-3-1\" data-name=\"quick tag one\">\n                                Kinh tế học\n                            </span>\n                            <span class=\"rounded bg-[#eae8e5] px-2 py-1 text-[10px] text-[#5a685d]\" data-kid=\"1-1-2-1-2-1-3-2\" data-name=\"quick tag two\">\n                                Trước 1975\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"ml-auto flex shrink-0 items-center gap-3 text-[#434844] sm:gap-4\" data-kid=\"1-1-2-1-3\" data-name=\"user action icons container\">\n                    <a aria-label=\"Yêu thích\" class=\"relative\" data-kid=\"1-1-2-1-3-1\" data-name=\"wishlist link\" href=\"#\">\n                        <span class=\"material-symbols-outlined text-[21px]\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"wishlist icon\">\n                            bookmark_border\n                        </span>\n                        <span class=\"absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-[#c27803] text-[9px] text-white\" data-kid=\"1-1-2-1-3-1-2\" data-name=\"wishlist count badge\">\n                            3\n                        </span>\n                    </a>\n                    <a aria-label=\"Giỏ hàng\" class=\"relative\" data-kid=\"1-1-2-1-3-2\" data-name=\"cart link\" href=\"#\">\n                        <span class=\"material-symbols-outlined text-[21px]\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"cart icon\">\n                            local_mall\n                        </span>\n                        <span class=\"absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-[#c27803] text-[9px] text-white\" data-kid=\"1-1-2-1-3-2-2\" data-name=\"cart count badge\">\n                            1\n                        </span>\n                    </a>\n                    <a aria-label=\"Thành viên\" class=\"hidden items-center gap-2 lg:flex\" data-kid=\"1-1-2-1-3-3\" data-name=\"member account link\" href=\"#\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#1e2d24] text-white\" data-kid=\"1-1-2-1-3-3-1\" data-name=\"member icon container\">\n                            <span class=\"material-symbols-outlined text-[17px]\" data-kid=\"1-1-2-1-3-3-1-1\" data-name=\"person icon\">\n                                person\n                            </span>\n                        </span>\n                        <span class=\"text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-1-2-1-3-3-2\" data-name=\"member link text\">\n                            Thành viên\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"mx-auto mt-3 max-w-[1320px] md:hidden\" data-kid=\"1-1-2-2\" data-name=\"mobile search field container\">\n                <div class=\"relative flex items-center\" data-kid=\"1-1-2-2-1\" data-name=\"mobile search input wrapper\">\n                    <span class=\"material-symbols-outlined absolute left-3 text-[18px] text-[#5a685d]\" data-kid=\"1-1-2-2-1-1\" data-name=\"mobile search icon\">\n                        search\n                    </span>\n                    <input aria-label=\"Tìm kiếm sách\" class=\"w-full rounded border border-[#e6dec8] bg-[#f4efea] py-2.5 pl-9 pr-3 text-[12px] outline-none placeholder:text-[#5a685d] focus:border-[#c27803]\" data-kid=\"1-1-2-2-1-2\" data-name=\"mobile search input field\" placeholder=\"Tìm kiếm sách, tác giả, ISBN...\" type=\"search\"/>\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Điều hướng chính\" class=\"overflow-x-auto whitespace-nowrap border-b border-[#e6dec8] bg-white px-4 sm:px-6\" data-kid=\"1-1-3\" data-name=\"main navigation bar\">\n            <div class=\"mx-auto flex max-w-[1320px] items-center gap-6 py-3 text-[12px] font-semibold text-[#5a685d] sm:gap-7\" data-kid=\"1-1-3-1\" data-name=\"navigation menu links wrapper\">\n                <a class=\"py-1\" data-kid=\"1-1-3-1-1\" data-name=\"home link\" href=\"#\">\n                    Trang chủ\n                </a>\n                <a aria-current=\"page\" class=\"border-b-2 border-[#c27803] py-1 text-[#885200]\" data-kid=\"1-1-3-1-2\" data-name=\"book categories link\" href=\"#danh-muc\">\n  