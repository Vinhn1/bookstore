en\" data-kid=\"1-2-4\" data-name=\"librarian service promotion section\">\n            <div class=\"max-w-[690px]\" data-kid=\"1-2-4-1\" data-name=\"promotion info container\">\n                <div class=\"mb-2 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[.16em] text-[#ffb867]\" data-kid=\"1-2-4-1-1\" data-name=\"service label container\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-1\" data-lucide=\"bookmark-plus\" data-name=\"service icon\">\n                    </i>\n                    Dịch vụ Thủ thư · tìm kiếm theo yêu cầu\n                </div>\n                <h2 class=\"pt-serif text-[23px] leading-tight sm:text-[25px]\" data-kid=\"1-2-4-1-2\" data-name=\"service section heading\" id=\"librarian-title\">\n                    Không tìm thấy bản in bạn mong muốn?\n                </h2>\n                <p class=\"mt-2 text-[12px] leading-5 text-[#d5e0d5] sm:text-[13px]\" data-kid=\"1-2-4-1-3\" data-name=\"service section description\">\n                    Lưu một tìm kiếm để chúng tôi báo khi có bản phù hợp, hoặc nhờ thủ thư tìm giúp một cuốn cụ thể trong mạng lưới sưu tầm.\n                </p>\n            </div>\n            <div class=\"flex shrink-0 flex-wrap gap-2\" data-kid=\"1-2-4-2\" data-name=\"service call-to-action button container\">\n                <button class=\"pt-focus rounded-[4px] bg-[#fea93e] px-4 py-2.5 text-[11px] font-semibold text-[#2b1700]\" data-kid=\"1-2-4-2-1\" data-name=\"save search button\">\n                    Lưu tìm kiếm này\n                </button>\n                <button class=\"pt-focus flex items-center gap-1.5 rounded-[4px] border border-[#b9cbbe] px-4 py-2.5 text-[11px] font-semibold text-white\" data-kid=\"1-2-4-2-2\" data-name=\"contact librarian button\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-4-2-2-1\" data-lucide=\"message-circle\" data-name=\"message icon\">\n                    </i>\n                    Nhắn với thủ thư\n                </button>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#e6dec8] bg-[#f5f3f0]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto max-w-[1200px] px-4 py-10 sm:px-6\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <div class=\"grid gap-8 md:grid-cols-4\" data-kid=\"1-3-1-1\" data-name=\"footer grid columns\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <div class=\"pt-serif text-[21px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-1-1\" data-name=\"site footer title\">\n                        The Page Turner\n                    </div>\n                    <p class=\"mt-3 max-w-[245px] text-[12px] leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-1-2\" data-name=\"site mission statement\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách là một chứng nhân của thời gian.\n                    </p>\n                    <div class=\"mt-4 flex items-center gap-1.5 text-[11px] text-[#885200]\" data-kid=\"1-3-1-1-1-3\" data-name=\"footer location note\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-3-1-1-1-3-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\">\n                        </i>\n                        Tiệm sách độc lập Hà Nội\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"footer links column\">\n                    <h3 class=\"text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-2-1\" data-name=\"footer column heading\">\n                        Hỗ trợ & Chính sách\n                    </h3>\n                    <ul class=\"mt-3 space-y-2 text-[12px] leading-4 text-[#5a685d]\" data-kid=\"1-3-1-1-2-2\" data-name=\"footer list\">\n                        <li data-kid=\"1-3-1-1-2-2-1\" data-name=\"footer link\">\n                            Quy chuẩn phân loại tình trạng sách\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-2\" data-name=\"footer link\">\n                            Chính sách kiểm tra & đổi trả 7 ngày\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-3\" data-name=\"footer link\">\n                            Giao hàng & đóng gói chuyên dụng\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-4\" data-name=\"footer link\">\n                            Ký gửi & thu mua sách hiếm\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-5\" data-name=\"footer link\">\n                            Hướng dẫn đặt hàng và thanh toán\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer contact column\">\n                    <h3 class=\"text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-3-1\" data-name=\"footer column heading\">\n                        Liên hệ tiệm sách\n                    </h3>\n                    <ul class=\"mt-3 space-y-2 text-[12px] leading-4 text-[#5a685d]\" data-kid=\"1-3-1-1-3-2\" data-name=\"footer contact info list\">\n                        <li class=\"flex gap-1.5\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"footer contact link\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0\" data-kid=\"1-3-1-1-3-2-1-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-3-2-1-2\" data-name=\"footer address\">\n                                42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                            </span>\n                        </li>\n                        <li class=\"flex gap-1.5\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"footer contact link\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0\" data-kid=\"1-3-1-1-3-2-2-1\" data-lucide=\"phone\" data-name=\"phone icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-3-2-2-2\" data-name=\"footer phone number\">\n                                Hotline: 0988 123 456\n                            </span>\n                        </li>\n                        <li class=\"flex gap-1.5\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"footer contact link\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0\" data-kid=\"1-3-1-1-3-2-3-1\" data-lucide=\"mail\" data-name=\"mail icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-3-2-3-2\" data-name=\"footer email address\">\n                                thuthu@thepageturner.vn\n                            </span>\n                        </li>\n                        <li class=\"flex gap-1.5\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"footer contact link\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0\" data-kid=\"1-3-1-1-3-2-4-1\" data-lucide=\"clock-3\" data-name=\"clock icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-1-3-2-4-2\" data-name=\"footer hours text\">\n                                Mở cửa: 08:30 – 21:30 hàng ngày\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"footer newsletter column\">\n                    <h3 class=\"text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-4-1\" data-name=\"footer column heading\">\n                        Bản tin Sách Hiếm\n                    </h3>\n                    <p class=\"mt-3 text-[12px] leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-4-2\" data-name=\"footer newsletter description\">\n                        Nhận danh mục bản tuyển chọn, sách có ký và bản in đầu phát hành mỗi sáng thứ Bảy.\n                    </p>\n                    <div class=\"mt-4 flex h-9 items-center rounded-[4px] border border-[#e6dec8] bg-white px-3 text-[11px] text-[#8b918b]\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter input field\">\n                        Địa chỉ email của bạn...\n                    </div>\n                    <button class=\"pt-focus mt-2 w-full rounded-[4px] bg-[#1e2d24] py-2 text-[11px] font-semibold text-white\" data-kid=\"1-3-1-1-4-4\" data-name=\"newsletter signup button\">\n                        Đăng ký nhận tin\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-9 flex flex-col gap-3 border-t border-[#e6dec8] pt-4 text-[10px] text-[#5a685d] md:flex-row md:items-center md:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer copyright section\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </span>\n                <span class=\"flex flex-wrap gap-x-5 gap-y-1\" data-kid=\"1-3-1-2-2\" data-name=\"legal links group\">\n                    Điều khoản dịch vụ\n                    <span data-kid=\"1-3-1-2-2-1\" data-name=\"legal link\">\n                        Chính sách bảo mật\n                    </span>\n                    <span data-kid=\"1-3-1-2-2-2\" data-name=\"legal link\">\n                        Chứng thực ấn bản\n                    </span>\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    if (window.lucide) { window.lucide.createIcons(); }\n</script>\n",
