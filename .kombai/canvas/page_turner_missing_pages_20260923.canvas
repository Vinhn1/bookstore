      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap');\n\n.font-editorial { font-family: 'Playfair Display', serif; }\n.font-interface { font-family: 'Be Vietnam Pro', sans-serif; }\n.support-page details > summary { list-style: none; }\n.support-page details > summary::-webkit-details-marker { display: none; }\n.support-page details[open] .faq-plus { transform: rotate(45deg); }\n</style>\n<div class=\"support-page bg-[#fbf9f6] font-interface text-[#1b1c1a]\" data-kid=\"1\" data-name=\"support page container\">\n    <header class=\"border-b border-[#e6dec8] bg-[#fbf9f6]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center justify-between gap-4 border-b border-[#e6dec8] py-2 text-[11px] leading-4 text-[#5a685d] sm:text-xs\" data-kid=\"1-1-1-1\" data-name=\"header top info bar\">\n                <p class=\"truncate\" data-kid=\"1-1-1-1-1\" data-name=\"trust promise text\">\n                    Cam kết 100% ấn thật · Kiểm tra hàng trước khi thanh toán\n                </p>\n                <div class=\"hidden shrink-0 items-center gap-4 sm:flex\" data-kid=\"1-1-1-1-2\" data-name=\"contact info container\">\n                    <span data-kid=\"1-1-1-1-2-1\" data-name=\"business hours text\">\n                        Hà Nội 08:30 – 21:30\n                    </span>\n                    <span class=\"text-[#c27803]\" data-kid=\"1-1-1-1-2-2\" data-name=\"separator dot\">\n                        •\n                    </span>\n                    <span data-kid=\"1-1-1-1-2-3\" data-name=\"hotline number text\">\n                        Hotline: 0988 123 456\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-x-5 gap-y-3 border-b border-[#e6dec8] py-4 lg:flex-nowrap\" data-kid=\"1-1-1-2\" data-name=\"header main row\">\n                <a aria-label=\"The Page Turner - Trang chủ\" class=\"w-[170px] shrink-0 text-[#1e2d24]\" data-kid=\"1-1-1-2-1\" data-name=\"brand logo and tagline link\" href=\"#top\">\n                    <div class=\"font-editorial text-[20px] leading-none sm:text-[22px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"brand name\">\n                        The Page Turner\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold uppercase tracking-[0.2em] text-[#5a685d]\" data-kid=\"1-1-1-2-1-2\" data-name=\"brand tagline\">\n                        Sách cũ & quý hiếm\n                    </div>\n                </a>\n                <form action=\"#faq\" class=\"order-3 flex w-full items-center border border-[#e6dec8] bg-[#f4efea] focus-within:border-[#c27803] focus-within:ring-2 focus-within:ring-[#c27803]/15 lg:order-none lg:flex-1\" data-kid=\"1-1-1-2-2\" data-name=\"main search form\" role=\"search\">\n                    <label class=\"sr-only\" data-kid=\"1-1-1-2-2-1\" data-name=\"search label\" for=\"catalog-search\">\n                        Tìm kiếm trong danh mục sách\n                    </label>\n                    <span aria-hidden=\"true\" class=\"flex h-10 w-10 shrink-0 items-center justify-center text-[#c27803]\" data-kid=\"1-1-1-2-2-2\" data-name=\"search icon wrapper\">\n                        <svg class=\"h-4 w-4\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                            <circle cx=\"10.8\" cy=\"10.8\" r=\"6.4\">\n                            </circle>\n                            <path d=\"m16 16 4.5 4.5\">\n                            </path>\n                        </svg>\n                    </span>\n                    <input class=\"min-w-0 flex-1 bg-transparent py-2.5 pr-3 text-xs text-[#1e2d24] outline-hidden placeholder:text-[#6b736d] sm:text-sm\" data-kid=\"1-1-1-2-2-3\" data-name=\"search input field\" id=\"catalog-search\" placeholder=\"Tìm kiếm sách, tác giả, nhà xuất bản & lịch sử\"/>\n                    <span class=\"hidden border-l border-[#e6dec8] px-4 py-2.5 text-[10px] text-[#5a685d] sm:block\" data-kid=\"1-1-1-2-2-4\" data-name=\"search category tag\">\n                        Trước 1975\n                    </span>\n                </form>\n                <div class=\"ml-auto flex items-center gap-3 text-[11px] text-[#334135] sm:gap-4\" data-kid=\"1-1-1-2-3\" data-name=\"user actions container\">\n                    <a class=\"hidden items-center gap-1.5 sm:flex\" data-kid=\"1-1-1-2-3-1\" data-name=\"wishlist link\" href=\"#contact\">\n                        <svg class=\"h-4 w-4 text-[#c27803]\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"heart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M20.8 8.7c0 5.1-8.8 10.1-8.8 10.1S3.2 13.8 3.2 8.7a4.5 4.5 0 0 1 8.8-1.4 4.5 4.5 0 0 1 8.8 1.4Z\">\n                            </path>\n                        </svg>\n                        <span data-kid=\"1-1-1-2-3-1-2\" data-name=\"wishlist label\">\n                            Yêu thích\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-1.5\" data-kid=\"1-1-1-2-3-2\" data-name=\"cart link\" href=\"#contact\">\n                        <svg class=\"h-4 w-4 text-[#c27803]\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"shopping bag icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M4.5 6.5h15l-1.2 8.1H6.2L4.5 6.5Z\">\n                            </path>\n                            <path d=\"M4.5 6.5 3.7 4H2.2M8.2 18.3h.1m7.7 0h.1\">\n                            </path>\n                        </svg>\n                        <span data-kid=\"1-1-1-2-3-2-2\" data-name=\"cart label\">\n                            Giỏ hàng\n                        </span>\n                    </a>\n                    <a class=\"rounded-full bg-[#1e2d24] px-3 py-1.5 text-[10px] font-semibold text-white\" data-kid=\"1-1-1-2-3-3\" data-name=\"member portal link\" href=\"#contact\">\n                        Thành viên\n                    </a>\n                </div>\n            </div>\n            <nav aria-label=\"Điều hướng chính\" class=\"flex flex-wrap items-center gap-x-5 gap-y-2 py-3 text-[11px] text-[#334135] sm:text-xs\" data-kid=\"1-1-1-3\" data-name=\"main navigation bar\">\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-1\" data-name=\"navigation link home\" href=\"#top\">\n                    Trang chủ\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-2\" data-name=\"navigation link categories\" href=\"#topics\">\n                    Danh mục sách\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-3\" data-name=\"navigation link search\" href=\"#topics\">\n                    Tìm kiếm nâng cao\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-4\" data-name=\"navigation link literature\" href=\"#topics\">\n                    Văn học\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-5\" data-name=\"navigation link economics\" href=\"#topics\">\n                    Kinh tế\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-6\" data-name=\"navigation link psychology\" href=\"#topics\">\n                    Tâm lý\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-7\" data-name=\"navigation link rare books\" href=\"#topics\">\n                    Sách hiếm\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-8\" data-name=\"navigation link discount books\" href=\"#topics\">\n                    Sách giảm giá\n                </a>\n                <a class=\"hover:text-[#c27803]\" data-kid=\"1-1-1-3-9\" data-name=\"navigation link shipping\" href=\"#contact\">\n                    Gói hàng & Thanh toán\n                </a>\n                <a class=\"border-b border-[#c27803] pb-1 font-semibold text-[#c27803]\" data-kid=\"1-1-1-3-10\" data-name=\"navigation link support faq\" href=\"#top\">\n                    Hỗ trợ & FAQ\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section class=\"mx-auto max-w-[1320px] px-4 pb-14 pt-8 sm:px-6 sm:pt-10 lg:px-10 lg:pb-20\" data-kid=\"1-2-1\" data-name=\"support hero section\">\n            <div aria-label=\"Breadcrumb\" class=\"mb-8 flex items-center gap-2 text-[11px] text-[#5a685d]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\">\n                <a class=\"hover:text-[#1e2d24]\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb home link\" href=\"#top\">\n                    Trang chủ\n                </a>\n                <span aria-hidden=\"true\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"text-[#1e2d24]\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page\">\n                    Hỗ trợ & FAQ\n                </span>\n            </div>\n            <div class=\"grid items-center gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16\" data-kid=\"1-2-1-2\" data-name=\"hero content grid\">\n                <div class=\"max-w-[600px]\" data-kid=\"1-2-1-2-1\" data-name=\"hero text content\">\n                    <p class=\"mb-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#c27803] sm:text-[11px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero pre-headline\">\n                        Thư viện hướng dẫn · The Page Turner\n                    </p>\n                    <h1 class=\"font-editorial text-[38px] leading-[1.12] tracking-[-0.02em] text-[#1e2d24] sm:text-[48px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero main headline\">\n                        Trung tâm hỗ trợ\n                        <br class=\"hidden sm:block\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"headline line break\"/>\n                        thủ thư\n                    </h1>\n                    <p class=\"mt-5 max-w-[520px] text-[14px] leading-7 text-[#5a685d] sm:text-[15px]\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero description\">\n                        Tìm câu trả lời cho đơn sách, tình trạng ấn bản và cách bảo quản. Chúng tôi luôn sẵn lòng giúp bạn chọn đúng một cuốn sách đáng giữ.\n                    </p>\n                    <div class=\"mt-7 flex flex-wrap items-center gap-4 text-[11px] text-[#5a685d]\" data-kid=\"1-2-1-2-1-4\" data-name=\"hero benefits list\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"benefit item\">\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#c27803] text-[10px] text-[#c27803]\" data-kid=\"1-2-1-2-1-4-1-1\" data-name=\"checkmark icon\">\n                                ✓\n                            </span>\n                            Mô tả tình trạng minh bạch\n                        </span>\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"benefit item\">\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#c27803] text-[10px] text-[#c27803]\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"checkmark icon\">\n                                ✓\n                            </span>\n                            Hỗ trợ 7 ngày trong tuần\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative border border-[#e6dec8] bg-[#f4efea] p-5 sm:p-7\" data-kid=\"1-2-1-2-2\" data-name=\"hero search container\">\n                    <div class=\"absolute -top-3 left-5 bg-[#c27803] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-white sm:left-7\" data-kid=\"1-2-1-2-2-1\" data-name=\"search section label\">\n                        Tìm nhanh câu trả lời\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"1-2-1-2-2-2\" data-name=\"hero search inner\">\n                        <label class=\"mb-2 block text-[12px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"support search label\" for=\"support-query\">\n                            Bạn đang cần tìm điều gì?\n                        </label>\n                        <form action=\"#faq\" class=\"flex flex-col gap-2.5 sm:flex-row\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"support search form\" id=\"support-search\">\n                            <div class=\"flex min-w-0 flex-1 items-center border border-[#e6dec8] bg-[#fbf9f6] focus-within:border-[#c27803] focus-within:ring-2 focus-within:ring-[#c27803]/15\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"search input wrapper\">\n                                <span aria-hidden=\"true\" class=\"flex h-11 w-10 shrink-0 items-center justify-center text-[#c27803]\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"search icon wrapper\">\n                                    <svg class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-2-2-1-1-1\" data-name=\"magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                                        <circle cx=\"10.8\" cy=\"10.8\" r=\"6.4\">\n                                        </circle>\n                                        <path d=\"m16 16 4.5 4.5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <input class=\"min-w-0 flex-1 bg-transparent py-3 pr-2 text-xs text-[#1e2d24] outline-hidden placeholder:text-[#7b817b]\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"support search input\" id=\"support-query\" placeholder=\"Ví dụ: đổi trả sách, phí giao hàng…\"/>\n                            </div>\n                            <button class=\"bg-[#1e2d24] px-5 py-3 text-xs font-semibold text-white transition hover:bg-[#2b4235]\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"support search button\" type=\"submit\">\n                                Tìm kiếm\n                            </button>\n                        </form>\n                        <div class=\"mt-4 flex flex-wrap items-center gap-2 text-[11px] text-[#6d4100]\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"search suggestions container\">\n                            <span class=\"mr-1 text-[#5a685d]\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"suggestions label\">\n                                Gợi ý:\n                            </span>\n                            <a class=\"border border-[#d9c7aa] bg-[#fbf9f6] px-2.5 py-1.5 hover:border-[#c27803]\" data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"suggestion tag\" href=\"#faq\">\n                                Đổi trả\n                            </a>\n                            <a class=\"border border-[#d9c7aa] bg-[#fbf9f6] px-2.5 py-1.5 hover:border-[#c27803]\" data-kid=\"1-2-1-2-2-2-3-3\" data-name=\"suggestion tag\" href=\"#faq\">\n                                Theo dõi đơn\n                            </a>\n                            <a class=\"border border-[#d9c7aa] bg-[#fbf9f6] px-2.5 py-1.5 hover:border-[#c27803]\" data-kid=\"1-2-1-2-2-2-3-4\" data-name=\"suggestion tag\" href=\"#faq\">\n                                Chứng thư\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[#e6dec8] bg-[#f5f3f0]\" data-kid=\"1-2-2\" data-name=\"topics section\" id=\"topics\">\n            <div class=\"mx-auto max-w-[1320px] px-4 py-12 sm:px-6 sm:py-14 lg:px-10\" data-kid=\"1-2-2-1\" data-name=\"topics section container\">\n                <div class=\"flex flex-col gap-3 border-b border-[#e6dec8] pb-5 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"section header container\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"section title group\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#c27803]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"section pre-headline\">\n                            Mục lục hỗ trợ\n                        </p>\n                        <h2 class=\"mt-2 font-editorial text-[28px] leading-tight text-[#1e2d24] sm:text-[32px]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"section main headline\">\n                            Bạn cần giúp về điều gì?\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[320px] text-[12px] leading-5 text-[#5a685d] sm:text-right\" data-kid=\"1-2-2-1-1-2\" data-name=\"section description text\">\n                        Những hướng dẫn ngắn gọn, viết riêng cho người yêu sách và người sưu tầm.\n                    </p>\n                </div>\n                <div class=\"mt-6 grid gap-5 sm:grid-cols-2 md:grid-cols-12 md:gap-6\" data-kid=\"1-2-2-1-2\" data-name=\"cards grid container\">\n                    <a class=\"group border border-[#e6dec8] bg-[#fbf9f6] p-5 transition hover:-translate-y-0.5 hover:border-[#c27803] hover:shadow-[0_8px_20px_-4px_rgba(30,45,36,0.08)] sm:col-span-1 sm:p-6 md:col-span-7\" data-kid=\"1-2-2-1-2-1\" data-name=\"topic card\" href=\"#faq\">\n                        <div aria-hidden=\"true\" class=\"mb-7 flex items-center gap-3 text-[#c27803]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"card header decoration\">\n                            <span class=\"font-editorial text-[22px] leading-none text-[#1e2d24]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"card number\">\n                                01\n                            </span>\n                            <span class=\"h-px w-8 bg-[#c27803]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"card decorative line\">\n                            </span>\n                        </div>\n                        <h3 class=\"font-editorial text-[19px] leading-6 text-[#1e2d24]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"card title\">\n                            Đặt hàng &\n                            <br data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"card title break\"/>\n                            thanh toán\n                        </h3>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"card description\">\n                            Phương thức trả tiền, mã giảm giá và hóa đơn.\n                        </p>\n                        <span class=\"mt-6 inline-flex items-center gap-2 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-2-1-2-1-4\" data-name=\"card link text\">\n                            Xem hướng dẫn\n                            <span class=\"transition group-hover:translate-x-1\" data-kid=\"1-2-2-1-2-1-4-1\" data-name=\"arrow icon\">\n                                →\n                            </span>\n                        </span>\n                    </a>\n                    <a class=\"group border border-[#e6dec8] bg-[#fbf9f6] p-5 transition hover:-translate-y-0.5 hover:border-[#c27803] hover:shadow-[0_8px_20px_-4px_rgba(30,45,36,0.08)] sm:col-span-1 sm:p-6 md:col-span-5\" data-kid=\"1-2-2-1-2-2\" data-name=\"topic card\" href=\"#faq\">\n                        <div aria-hidden=\"true\" class=\"mb-7 flex items-center gap-3 text-[#c27803]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"card header decoration\">\n                            <span class=\"font-editorial text-[22px] leading-none text-[#1e2d24]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"card number\">\n                                02\n                            </span>\n                            <span class=\"h-px w-8 bg-[#c27803]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"card decorative line\">\n                            </span>\n                        </div>\n                        <h3 class=\"font-editorial text-[19px] leading-6 text-[#1e2d24]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"card title\">\n                            Giao nhận &\n                            <br data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"card title break\"/>\n                            đóng gói\n                        </h3>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"card description\">\n                            Thời gian giao, phí vận chuyển và cách bọc sách.\n                        </p>\n                        <span class=\"mt-6 inline-flex items-center gap-2 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"card link text\">\n                            Xem hướng dẫn\n                            <span class=\"transition group-hover:translate-x-1\" data-kid=\"1-2-2-1-2-2-4-1\" data-name=\"arrow icon\">\n                                →\n                            </span>\n                        </span>\n                    </a>\n                    <a class=\"group border border-[#e6dec8] bg-[#fbf9f6] p-5 transition hover:-translate-y-0.5 hover:border-[#c27803] hover:shadow-[0_8px_20px_-4px_rgba(30,45,36,0.08)] sm:col-span-1 sm:p-6 md:col-span-5\" data-kid=\"1-2-2-1-2-3\" data-name=\"topic card\" href=\"#faq\">\n                        <div aria-hidden=\"true\" class=\"mb-7 flex items-center gap-3 text-[#c27803]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"card header decoration\">\n                            <span class=\"font-editorial text-[22px] leading-none text-[#1e2d24]\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"card number\">\n                                03\n                            </span>\n                            <span class=\"h-px w-8 bg-[#c27803]\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"card decorative line\">\n                            </span>\n                        </div>\n                        <h3 class=\"font-editorial text-[19px] leading-6 text-[#1e2d24]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"card title\">\n                            Tình trạng sách\n                            <br data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"card title break\"/>\n                            & đổi trả\n                        </h3>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"card description\">\n                            Đọc bảng thẩm định và cách yêu cầu đổi trả.\n                        </p>\n                        <span class=\"mt-6 inline-flex items-center gap-2 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-2-1-2-3-4\" data-name=\"card link text\">\n                            Xem hướng dẫn\n                            <span class=\"transition group-hover:translate-x-1\" data-kid=\"1-2-2-1-2-3-4-1\" data-name=\"arrow icon\">\n                                →\n                            </span>\n                        </span>\n                    </a>\n                    <a class=\"group border border-[#e6dec8] bg-[#fbf9f6] p-5 transition hover:-translate-y-0.5 hover:border-[#c27803] hover:shadow-[0_8px_20px_-4px_rgba(30,45,36,0.08)] sm:col-span-1 sm:p-6 md:col-span-7\" data-kid=\"1-2-2-1-2-4\" data-name=\"topic card\" href=\"#faq\">\n                        <div aria-hidden=\"true\" class=\"mb-7 flex items-center gap-3 text-[#c27803]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"card header decoration\">\n                            <span class=\"font-editorial text-[22px] leading-none text-[#1e2d24]\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"card number\">\n                                04\n                            </span>\n                            <span class=\"h-px w-8 bg-[#c27803]\" data-kid=\"1-2-2-1-2-4-1-2\" data-name=\"card decorative line\">\n                            </span>\n                        </div>\n                        <h3 class=\"font-editorial text-[19px] leading-6 text-[#1e2d24]\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"card title\">\n                            Chứng thư &\n                            <br data-kid=\"1-2-2-1-2-4-2-1\" data-name=\"card title break\"/>\n                            nguồn gốc\n                        </h3>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"card description\">\n                            Xác thực ấn bản, lịch sử sở hữu và chứng thư.\n                        </p>\n                        <span class=\"mt-6 inline-flex items-center gap-2 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-2-1-2-4-4\" data-name=\"card link text\">\n                            Xem hướng dẫn\n                            <span class=\"transition group-hover:translate-x-1\" data-kid=\"1-2-2-1-2-4-4-1\" data-name=\"arrow icon\">\n                                →\n                            </span>\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1320px] px-4 py-14 sm:px-6 sm:py-16 lg:px-10 lg:py-20\" data-kid=\"1-2-3\" data-name=\"faq section\" id=\"faq\">\n            <div class=\"grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16\" data-kid=\"1-2-3-1\" data-name=\"faq content grid\">\n                <div class=\"max-w-[330px]\" data-kid=\"1-2-3-1-1\" data-name=\"faq intro column\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#c27803]\" data-kid=\"1-2-3-1-1-1\" data-name=\"faq pre-headline\">\n                        Câu hỏi thường gặp\n                    </p>\n                    <h2 class=\"mt-3 font-editorial text-[30px] leading-[1.16] text-[#1e2d24] sm:text-[34px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"faq main headline\">\n                        Giải đáp trước khi\n                        <br class=\"hidden sm:block\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"headline line break\"/>\n                        bạn đặt sách\n                    </h2>\n                    <p class=\"mt-5 text-[13px] leading-6 text-[#5a685d]\" data-kid=\"1-2-3-1-1-3\" data-name=\"faq description\">\n                        Nếu chưa tìm thấy điều bạn cần, thủ thư của chúng tôi sẽ trả lời trong giờ làm việc.\n                    </p>\n                    <a class=\"mt-7 inline-flex items-center gap-2 border-b border-[#1e2d24] pb-1 text-xs font-semibold text-[#1e2d24] hover:border-[#c27803] hover:text-[#c27803]\" data-kid=\"1-2-3-1-1-4\" data-name=\"contact link\" href=\"#contact\">\n                        Liên hệ thủ thư\n                        <span data-kid=\"1-2-3-1-1-4-1\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <div class=\"mt-10 border-l-2 border-[#c27803] pl-4 text-[11px] leading-5 text-[#5a685d]\" data-kid=\"1-2-3-1-1-5\" data-name=\"faq helper tip\">\n                        Mẹo nhỏ: hãy chuẩn bị mã đơn hàng hoặc tên sách để chúng tôi hỗ trợ nhanh hơn.\n                    </div>\n                </div>\n                <div class=\"divide-y divide-[#e6dec8] border-y border-[#e6dec8]\" data-kid=\"1-2-3-1-2\" data-name=\"faq list container\">\n                    <details class=\"group py-5\" data-kid=\"1-2-3-1-2-1\" data-name=\"faq item\" open=\"\">\n                        <summary class=\"flex cursor-pointer items-start justify-between gap-4 text-[13px] font-semibold leading-5 text-[#1e2d24]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"faq summary\">\n                            <span data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"faq question text\">\n                                Tôi có thể thanh toán bằng hình thức nào?\n                            </span>\n                            <span class=\"faq-plus flex h-5 w-5 shrink-0 items-center justify-center border border-[#c27803] text-[15px] font-normal leading-none text-[#c27803] transition\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"plus icon\">\n                                +\n                            </span>\n                        </summary>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"faq answer text\">\n                            Bạn có thể chuyển khoản, thanh toán khi nhận hàng hoặc dùng Visa, Mastercard, JCB và ví điện tử. Đơn được xác nhận sau khi thanh toán thành công.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-2-3-1-2-2\" data-name=\"faq item\" open=\"\">\n                        <summary class=\"flex cursor-pointer items-start justify-between gap-4 text-[13px] font-semibold leading-5 text-[#1e2d24]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"faq summary\">\n                            <span data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"faq question text\">\n                                Sách được bọc và gửi đi như thế nào?\n                            </span>\n                            <span class=\"faq-plus flex h-5 w-5 shrink-0 items-center justify-center border border-[#c27803] text-[15px] font-normal leading-none text-[#c27803] transition\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"plus icon\">\n                                +\n                            </span>\n                        </summary>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"faq answer text\">\n                            Mỗi cuốn được kiểm tra lần cuối, bọc chống ẩm, chèn góc và đặt trong hộp cứng. Đơn nội thành Hà Nội thường đến trong 1–2 ngày.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-2-3-1-2-3\" data-name=\"faq item\" open=\"\">\n                        <summary class=\"flex cursor-pointer items-start justify-between gap-4 text-[13px] font-semibold leading-5 text-[#1e2d24]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"faq summary\">\n                            <span data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"faq question text\">\n                                “Tốt (85%)” trên trang sách có nghĩa là gì?\n                            </span>\n                            <span class=\"faq-plus flex h-5 w-5 shrink-0 items-center justify-center border border-[#c27803] text-[15px] font-normal leading-none text-[#c27803] transition\" data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"plus icon\">\n                                +\n                            </span>\n                        </summary>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"faq answer text\">\n                            Đó là mức đánh giá tổng hợp về bìa, gáy, ruột và độ sạch của sách. Mọi dấu vết đáng chú ý đều được ghi rõ trong phần mô tả.\n                        </p>\n                    </details>\n                    <details class=\"group py-5\" data-kid=\"1-2-3-1-2-4\" data-name=\"faq item\" open=\"\">\n                        <summary class=\"flex cursor-pointer items-start justify-between gap-4 text-[13px] font-semibold leading-5 text-[#1e2d24]\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"faq summary\">\n                            <span data-kid=\"1-2-3-1-2-4-1-1\" data-name=\"faq question text\">\n                                Tôi có được đổi sách nếu nhận hàng không đúng mô tả?\n                            </span>\n                            <span class=\"faq-plus flex h-5 w-5 shrink-0 items-center justify-center border border-[#c27803] text-[15px] font-normal leading-none text-[#c27803] transition\" data-kid=\"1-2-3-1-2-4-1-2\" data-name=\"plus icon\">\n                                +\n                            </span>\n                        </summary>\n                        <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"faq answer text\">\n                            Có. Hãy liên hệ trong vòng 7 ngày kể từ khi nhận hàng nếu sách có lỗi không được ghi trong mô tả và giữ lại bao bì ban đầu.\n                        </p>\n                    </details>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1320px] px-4 pb-14 sm:px-6 sm:pb-16 lg:px-10\" data-kid=\"1-2-4\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"grid gap-8 border-t-2 border-[#c27803] bg-[#1e2d24] p-6 text-[#fbf9f6] sm:p-8 lg:grid-cols-[1.08fr_0.92fr] lg:p-10\" data-kid=\"1-2-4-1\" data-name=\"contact section grid\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"contact info block\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d5e7d9]\" data-kid=\"1-2-4-1-1-1\" data-name=\"contact pre-headline\">\n                        Bạn vẫn cần một người đọc cùng?\n                    </p>\n                    <h2 class=\"mt-3 max-w-[540px] font-editorial text-[30px] leading-[1.18] sm:text-[36px]\" data-kid=\"1-2-4-1-1-2\" data-name=\"contact main headline\">\n                        Hãy hỏi thủ thư của chúng tôi.\n                    </h2>\n                    <p class=\"mt-4 max-w-[520px] text-[13px] leading-6 text-[#b9cbbe] sm:text-sm\" data-kid=\"1-2-4-1-1-3\" data-name=\"contact description\">\n                        Từ một bản in khó tìm đến câu hỏi về tình trạng sách, đội ngũ The Page Turner sẽ trả lời bằng sự cẩn trọng dành cho từng cuốn.\n                    </p>\n                    <div class=\"mt-7 flex flex-wrap gap-3\" data-kid=\"1-2-4-1-1-4\" data-name=\"contact methods buttons\">\n                        <a class=\"bg-[#c27803] px-4 py-3 text-xs font-semibold text-white transition hover:bg-[#a86600]\" data-kid=\"1-2-4-1-1-4-1\" data-name=\"email link button\" href=\"mailto:thuthu@thepageturner.vn\">\n                            Gửi câu hỏi qua email\n                        </a>\n                        <a class=\"border border-[#b9cbbe] px-4 py-3 text-xs font-semibold text-[#fbf9f6] transition hover:border-[#fea93e] hover:text-[#fea93e]\" data-kid=\"1-2-4-1-1-4-2\" data-name=\"phone link button\" href=\"tel:+84988123456\">\n                            Gọi 0988 123 456\n                        </a>\n                    </div>\n                </div>\n                <div class=\"border-t border-[#526257] pt-5 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0\" data-kid=\"1-2-4-1-2\" data-name=\"contact details list\">\n                    <div class=\"border-b border-[#526257] pb-4\" data-kid=\"1-2-4-1-2-1\" data-name=\"detail item row\">\n                        <p class=\"text-[10px] uppercase tracking-[0.15em] text-[#b9cbbe]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"label text\">\n                            Hotline thủ thư\n                        </p>\n                        <p class=\"mt-1 font-editorial text-[25px]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"phone number value\">\n                            0988 123 456\n                        </p>\n                    </div>\n                    <div class=\"border-b border-[#526257] py-4\" data-kid=\"1-2-4-1-2-2\" data-name=\"detail item row\">\n                        <p class=\"text-[10px] uppercase tracking-[0.15em] text-[#b9cbbe]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"label text\">\n                            Email\n                        </p>\n                        <p class=\"mt-1 break-all text-sm\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"email address value\">\n                            thuthu@thepageturner.vn\n                        </p>\n                    </div>\n                    <div class=\"pt-4\" data-kid=\"1-2-4-1-2-3\" data-name=\"detail item row\">\n                        <p class=\"text-[10px] uppercase tracking-[0.15em] text-[#b9cbbe]\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"label text\">\n                            Giờ hỗ trợ\n                        </p>\n                        <p class=\"mt-1 text-sm\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"operating hours value\">\n                            08:30 – 21:30 · Thứ Hai – Chủ Nhật\n                        </p>\n                        <p class=\"mt-2 text-[11px] text-[#b9cbbe]\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"closing remark text\">\n                            Phản hồi trong ngày với các câu hỏi gửi trước 18:00.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-6 flex flex-col gap-4 border border-[#e6dec8] bg-[#f4efea] p-5 sm:flex-row sm:items-start sm:gap-5 sm:p-6\" data-kid=\"1-2-4-2\" data-name=\"policy highlight block\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 shrink-0 items-center justify-center text-xl text-[#c27803]\" data-kid=\"1-2-4-2-1\" data-name=\"checkmark icon\">\n                    ✓\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-2\" data-name=\"policy description container\">\n                    <h3 class=\"font-editorial text-[19px] text-[#1e2d24]\" data-kid=\"1-2-4-2-2-1\" data-name=\"policy title\">\n                        Đổi trả rõ ràng, giữ sách an tâm\n                    </h3>\n                    <p class=\"mt-1 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-2-4-2-2-2\" data-name=\"policy summary text\">\n                        Bạn có thể yêu cầu đổi hoặc trả trong 7 ngày nếu sách có lỗi không được ghi trong mô tả. Vui lòng giữ nguyên bao bì và liên hệ chúng tôi trước khi gửi lại.\n                    </p>\n                </div>\n                <a class=\"shrink-0 self-start pt-1 text-xs font-semibold text-[#1e2d24] hover:text-[#c27803] sm:self-center\" data-kid=\"1-2-4-2-3\" data-name=\"policy link\" href=\"#faq\">\n                    Xem chính sách\n                    <span data-kid=\"1-2-4-2-3-1\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#e6dec8] bg-[#f5f3f0]\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"mx-auto max-w-[1320px] px-4 pb-5 pt-10 sm:px-6 lg:px-10\" data-kid=\"1-3-1\" data-name=\"footer wrapper\">\n            <div class=\"grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.15fr_1fr_1fr_1.05fr]\" data-kid=\"1-3-1-1\" data-name=\"footer grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <div class=\"font-editorial text-[19px] text-[#1e2d24]\" data-kid=\"1-3-1-1-1-1\" data-name=\"brand name\">\n                        The Page Turner\n                    </div>\n                    <p class=\"mt-3 max-w-[250px] text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-1-2\" data-name=\"brand description\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua nhiều thế hệ, bằng sự cẩn trọng dành cho từng cuốn sách.\n                    </p>\n                    <a class=\"mt-4 inline-flex items-center gap-2 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-1-3\" data-name=\"brand location link\" href=\"#top\">\n                        ⌁ Tiệm sách độc lập Hà Nội\n                    </a>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"footer policies column\">\n                    <h3 class=\"text-xs font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-2-1\" data-name=\"column title\">\n                        Hỗ trợ & Chính sách\n                    </h3>\n                    <div class=\"mt-3 space-y-2 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-2-2\" data-name=\"policies list\">\n                        <a class=\"block hover:text-[#c27803]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"policy link\" href=\"#faq\">\n                            Quy chuẩn phân loại tình trạng sách\n                        </a>\n                        <a class=\"block hover:text-[#c27803]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"policy link\" href=\"#faq\">\n                            Chính sách kiểm tra & đổi trả\n                        </a>\n                        <a class=\"block hover:text-[#c27803]\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"policy link\" href=\"#faq\">\n                            Giao hàng & đóng gói chuyên dụng\n                        </a>\n                        <a class=\"block hover:text-[#c27803]\" data-kid=\"1-3-1-1-2-2-4\" data-name=\"policy link\" href=\"#contact\">\n                            Hướng dẫn đặt hàng & thanh toán\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer contact column\">\n                    <h3 class=\"text-xs font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-3-1\" data-name=\"column title\">\n                        Liên hệ thủ thư\n                    </h3>\n                    <div class=\"mt-3 space-y-2 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-3-2\" data-name=\"contact info list\">\n                        <p data-kid=\"1-3-1-1-3-2-1\" data-name=\"contact info item\">\n                            ⌖ 42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                        </p>\n                        <p data-kid=\"1-3-1-1-3-2-2\" data-name=\"contact info item\">\n                            ◔ Hotline: 0988 123 456\n                        </p>\n                        <p data-kid=\"1-3-1-1-3-2-3\" data-name=\"contact info item\">\n                            ✉ thuthu@thepageturner.vn\n                        </p>\n                        <p data-kid=\"1-3-1-1-3-2-4\" data-name=\"contact info item\">\n                            ◷ Mở cửa: 08:30 – 21:30 hàng ngày\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"footer newsletter column\">\n                    <h3 class=\"text-xs font-semibold text-[#1e2d24]\" data-kid=\"1-3-1-1-4-1\" data-name=\"column title\">\n                        Bản tin sách hiếm\n                    </h3>\n                    <p class=\"mt-3 text-xs leading-5 text-[#5a685d]\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Nhận danh mục mới, câu chuyện phía sau mỗi cuốn và thông báo về bản in đặc biệt.\n                    </p>\n                    <form action=\"#contact\" class=\"mt-3\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter form\">\n                        <label class=\"sr-only\" data-kid=\"1-3-1-1-4-3-1\" data-name=\"email label\" for=\"newsletter-email\">\n                            Địa chỉ email\n                        </label>\n                        <input class=\"w-full border border-[#e6dec8] bg-[#fbf9f6] px-3 py-2.5 text-xs text-[#1e2d24] outline-hidden placeholder:text-[#8b918b] focus:border-[#c27803]\" data-kid=\"1-3-1-1-4-3-2\" data-name=\"email input field\" id=\"newsletter-email\" placeholder=\"Địa chỉ email của bạn…\"/>\n                        <button class=\"mt-2 w-full bg-[#1e2d24] py-2.5 text-xs font-semibold text-white transition hover:bg-[#2b4235]\" data-kid=\"1-3-1-1-4-3-3\" data-name=\"subscribe button\">\n                            Đăng ký nhận tin\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"mt-10 flex flex-col gap-3 border-t border-[#e6dec8] pt-4 text-[10px] leading-4 text-[#8b918b] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer copyright row\">\n                <p data-kid=\"1-3-1-2-1\" data-name=\"copyright notice\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </p>\n                <div class=\"flex flex-wrap gap-x-5 gap-y-1\" data-kid=\"1-3-1-2-2\" data-name=\"footer secondary links\">\n                    <a class=\"hover:text-[#1e2d24]\" data-kid=\"1-3-1-2-2-1\" data-name=\"legal link\" href=\"#top\">\n                        Điều khoản dịch vụ\n                    </a>\n                    <a class=\"hover:text-[#1e2d24]\" data-kid=\"1-3-1-2-2-2\" data-name=\"legal link\" href=\"#top\">\n                        Chính sách bảo mật\n                    </a>\n                    <a class=\"hover:text-[#1e2d24]\" data-kid=\"1-3-1-2-2-3\" data-name=\"legal link\" href=\"#top\">\n                        Chứng thư ấn bản\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n",
