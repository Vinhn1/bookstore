    "var_bc6a366d1df2": {
      "type": "variant",
      "label": "Page Turner — Danh sách yêu thích",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap');\n\n.pt-body { font-family: 'Be Vietnam Pro', sans-serif; }\n.pt-serif { font-family: 'Playfair Display', Georgia, serif; }\n.pt-card { transition: box-shadow .2s ease, transform .2s ease, border-color .2s ease; }\n.pt-card:hover { transform: translateY(-2px); border-color: #c8b994; box-shadow: 0 8px 20px -4px rgba(30,45,36,.08), 0 2px 6px -1px rgba(30,45,36,.04); }\n.book-cover { isolation: isolate; overflow: hidden; box-shadow: inset 13px 0 18px -17px rgba(18,25,20,.95), inset -3px -8px 14px -13px rgba(18,25,20,.8); }\n.book-cover::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .18; background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.16) 0, rgba(255,255,255,.16) 1px, transparent 1px, transparent 4px), repeating-linear-gradient(90deg, rgba(28,25,20,.16) 0, rgba(28,25,20,.16) 1px, transparent 1px, transparent 5px); mix-blend-mode: soft-light; }\n.book-cover::after { content: ''; position: absolute; inset: 0; pointer-events: none; border: 1px solid rgba(246,238,215,.45); box-shadow: inset 3px 0 0 rgba(255,255,255,.08), inset -6px 0 14px -12px rgba(17,21,18,.9); }\n.cover-paper { background: linear-gradient(135deg, #a9684c 0%, #78422f 56%, #3a211d 100%); }\n.cover-green { background: linear-gradient(135deg, #7e9278 0%, #566a58 54%, #24372d 100%); }\n.cover-ink { background: linear-gradient(135deg, #596962 0%, #36433e 55%, #1b2923 100%); }\n.cover-stone { background: linear-gradient(135deg, #cec0a3 0%, #aaa18c 58%, #736a5c 100%); }\n.cover-amber { background: linear-gradient(135deg, #c39a57 0%, #8c6034 55%, #4b3023 100%); }\n.cover-frame { border: 1px solid rgba(248,235,197,.68); box-shadow: inset 0 0 0 4px rgba(42,29,22,.08); }\n.pt-focus:focus { outline: 2px solid #c27803; outline-offset: 1px; }\n</style>\n<div class=\"pt-body min-h-screen w-full bg-[#fbf9f6] text-[#1b1c1a]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#e6dec8] bg-[#fbf9f6]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto max-w-[1200px] px-4 sm:px-6\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <div class=\"flex items-center justify-between gap-4 border-b border-[#e6dec8] py-2 text-[10px] leading-4 text-[#5a685d] sm:text-[11px]\" data-kid=\"1-1-1-1\" data-name=\"header top informational bar\">\n                <p class=\"hidden sm:block\" data-kid=\"1-1-1-1-1\" data-name=\"header promotion text\">\n                    Cam kết 100% ảnh thật được chụp trực tiếp từng cuốn sách\n                    <span class=\"mx-1 text-[#c27803]\" data-kid=\"1-1-1-1-1-1\" data-name=\"decorative separator dot\">\n                        •\n                    </span>\n                    Kiểm tra hàng trước khi thanh toán\n                </p>\n                <p class=\"sm:ml-auto\" data-kid=\"1-1-1-1-2\" data-name=\"header contact info text\">\n                    Hà Nội: 08:30 – 21:30\n                    <span class=\"mx-1 text-[#c27803]\" data-kid=\"1-1-1-1-2-1\" data-name=\"decorative separator dot\">\n                        •\n                    </span>\n                    Hotline: 0988 123 456\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-4 py-4 lg:flex-nowrap\" data-kid=\"1-1-1-2\" data-name=\"header main row\">\n                <div class=\"w-full shrink-0 lg:w-[190px]\" data-kid=\"1-1-1-2-1\" data-name=\"site branding container\">\n                    <div class=\"pt-serif text-[23px] font-semibold leading-none tracking-[-.02em] text-[#1e2d24] sm:text-[25px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"site title\">\n                        The Page Turner\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold tracking-[.16em] text-[#5a685d]\" data-kid=\"1-1-1-2-1-2\" data-name=\"site tagline\">\n                        SÁCH CŨ & QUÝ HIẾM\n                    </div>\n                </div>\n                <div class=\"order-3 flex h-10 w-full items-center gap-2 rounded-[4px] border border-[#e6dec8] bg-[#f4efea] px-2.5 text-[12px] text-[#5a685d] lg:order-none lg:flex-1\" data-kid=\"1-1-1-2-2\" data-name=\"search input field\">\n                    <button class=\"shrink-0 rounded-[2px] border border-[#e6dec8] bg-[#fbf9f6] px-2.5 py-1.5 text-[10px] font-semibold text-[#1e2d24]\" data-kid=\"1-1-1-2-2-1\" data-name=\"search category selector button\">\n                        Tìm theo\n                    </button>\n                    <span class=\"truncate\" data-kid=\"1-1-1-2-2-2\" data-name=\"search placeholder text\">\n                        Tìm kiếm sách, tác giả, nhà xuất bản\n                    </span>\n                    <span class=\"ml-auto text-[#1e2d24]\" data-kid=\"1-1-1-2-2-3\" data-name=\"search icon container\" style=\"font-size:15px\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-2-3-1\" data-lucide=\"search\" data-name=\"search icon\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"ml-auto flex items-center gap-3 text-[11px] text-[#334135] sm:gap-4 sm:text-[12px]\" data-kid=\"1-1-1-2-3\" data-name=\"user actions container\">\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-1-1-2-3-1\" data-name=\"wishlist link\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-1-1\" data-lucide=\"heart\" data-name=\"wishlist icon\">\n                        </i>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"wishlist label\">\n                            Yêu thích\n                        </span>\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-1-1-2-3-2\" data-name=\"shopping cart link\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-2-1\" data-lucide=\"shopping-bag\" data-name=\"shopping cart icon\">\n                        </i>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"shopping cart label\">\n                            Giỏ hàng\n                        </span>\n                    </span>\n                    <span class=\"flex items-center gap-1 rounded-[4px] bg-[#1e2d24] px-2.5 py-2 font-semibold text-white sm:px-3\" data-kid=\"1-1-1-2-3-3\" data-name=\"bookshelf link\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-3-1\" data-lucide=\"book-open\" data-name=\"bookshelf icon\">\n                        </i>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-3-3-2\" data-name=\"bookshelf label\">\n                            Kệ sách của tôi\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Điều hướng chính\" class=\"hidden items-center gap-6 overflow-x-auto whitespace-nowrap border-t border-[#e6dec8] py-3 text-[11px] text-[#334135] lg:flex\" data-kid=\"1-1-1-3\" data-name=\"main navigation bar\">\n                <a data-kid=\"1-1-1-3-1\" data-name=\"navigation link\" href=\"#\">\n                    Trang chủ\n                </a>\n                <a data-kid=\"1-1-1-3-2\" data-name=\"navigation link\" href=\"#\">\n                    Danh mục sách\n                </a>\n                <a data-kid=\"1-1-1-3-3\" data-name=\"navigation link\" href=\"#\">\n                    Tìm kiếm nâng cao\n                </a>\n                <a data-kid=\"1-1-1-3-4\" data-name=\"navigation link\" href=\"#\">\n                    Văn học\n                </a>\n                <a data-kid=\"1-1-1-3-5\" data-name=\"navigation link\" href=\"#\">\n                    Kinh tế\n                </a>\n                <a data-kid=\"1-1-1-3-6\" data-name=\"navigation link\" href=\"#\">\n                    Tâm lý\n                </a>\n                <a data-kid=\"1-1-1-3-7\" data-name=\"navigation link\" href=\"#\">\n                    Sách hiếm\n                </a>\n                <a data-kid=\"1-1-1-3-8\" data-name=\"navigation link\" href=\"#\">\n                    Sách giảm giá\n                </a>\n                <a class=\"border-b-2 border-[#c27803] pb-3 font-semibold text-[#1e2d24]\" data-kid=\"1-1-1-3-9\" data-name=\"active navigation link\" href=\"#\">\n                    Kệ sách cá nhân\n                </a>\n                <a data-kid=\"1-1-1-3-10\" data-name=\"navigation link\" href=\"#\">\n                    Giỏ hàng & Thanh toán\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1200px] px-4 pb-12 pt-5 sm:px-6 lg:pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"flex items-center gap-2 text-[11px] text-[#737873]\" data-kid=\"1-2-1\" data-name=\"breadcrumb navigation bar\">\n            <span data-kid=\"1-2-1-1\" data-name=\"breadcrumb item\">\n                Trang chủ\n            </span>\n            <i class=\"h-3 w-3\" data-kid=\"1-2-1-2\" data-lucide=\"chevron-right\" data-name=\"chevron separator icon\">\n            </i>\n            <span data-kid=\"1-2-1-3\" data-name=\"breadcrumb item\">\n                Kệ sách cá nhân\n            </span>\n            <i class=\"h-3 w-3\" data-kid=\"1-2-1-4\" data-lucide=\"chevron-right\" data-name=\"chevron separator icon\">\n            </i>\n            <span class=\"font-semibold text-[#1e2d24]\" data-kid=\"1-2-1-5\" data-name=\"breadcrumb active item\">\n                Danh sách yêu thích\n            </span>\n        </div>\n        <section aria-label=\"Ngữ cảnh tài khoản\" class=\"mt-5 overflow-hidden rounded-[6px] border border-[#e6dec8] bg-white\" data-kid=\"1-2-2\" data-name=\"account context header\">\n            <div class=\"flex flex-col gap-4 px-4 py-4 sm:px-5 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-2-2-1\" data-name=\"account header layout\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"account profile container\">\n                    <div class=\"grid h-10 w-10 shrink-0 place-items-center rounded-[4px] bg-[#1e2d24] text-white\" data-kid=\"1-2-2-1-1-1\" data-name=\"account avatar icon container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-2-2-1-1-1-1\" data-lucide=\"book-heart\" data-name=\"book heart icon\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-2-1-1-2\" data-name=\"account details container\">\n                        <div class=\"text-[11px] text-[#5a685d]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"account label\">\n                            Tài khoản cá nhân\n                        </div>\n                        <div class=\"mt-0.5 text-[14px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"account name text\">\n                            Nguyễn Hoàng Hải\n                            <span class=\"ml-1.5 rounded-full bg-[#ffddbb] px-2 py-1 text-[10px] font-semibold text-[#673d00]\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"account status badge\">\n                                Thủ thư Danh dự\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <nav aria-label=\"Điều hướng tài khoản\" class=\"flex items-center gap-1 overflow-x-auto pb-1 text-[11px] whitespace-nowrap\" data-kid=\"1-2-2-1-2\" data-name=\"account sub-navigation bar\">\n                    <a class=\"rounded-[4px] px-3 py-2 text-[#5a685d]\" data-kid=\"1-2-2-1-2-1\" data-name=\"account sub-nav link\" href=\"#\">\n                        Tổng quan\n                    </a>\n                    <a class=\"rounded-[4px] bg-[#1e2d24] px-3 py-2 font-semibold text-white\" data-kid=\"1-2-2-1-2-2\" data-name=\"active account sub-nav link\" href=\"#\">\n                        Danh sách yêu thích\n                        <span class=\"ml-1 text-[#ffb867]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"notification badge text\">\n                            12\n                        </span>\n                    </a>\n                    <a class=\"rounded-[4px] px-3 py-2 text-[#5a685d]\" data-kid=\"1-2-2-1-2-3\" data-name=\"account sub-nav link\" href=\"#\">\n                        Đơn hàng\n                    </a>\n                    <a class=\"rounded-[4px] px-3 py-2 text-[#5a685d]\" data-kid=\"1-2-2-1-2-4\" data-name=\"account sub-nav link\" href=\"#\">\n                        Ký gửi & thẩm định\n                    </a>\n                </nav>\n            </div>\n        </section>\n        <section aria-labelledby=\"wishlist-title\" class=\"mt-9\" data-kid=\"1-2-3\" data-name=\"wishlist section\">\n            <div class=\"flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"1-2-3-1\" data-name=\"wishlist header area\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"wishlist title container\">\n                    <div class=\"mb-2 text-[11px] font-semibold uppercase tracking-[.16em] text-[#885200]\" data-kid=\"1-2-3-1-1-1\" data-name=\"section breadcrumb label\">\n                        Kệ sách cá nhân / đã lưu\n                    </div>\n                    <h1 class=\"pt-serif text-[30px] font-semibold leading-[1.15] tracking-[-.02em] text-[#1e2d24] sm:text-[38px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"page title\" id=\"wishlist-title\">\n                        Danh sách yêu thích\n                    </h1>\n                    <p class=\"mt-2 max-w-[660px] text-[13px] leading-5 text-[#5a685d] sm:text-[14px]\" data-kid=\"1-2-3-1-1-3\" data-name=\"page description\">\n                        12 cuốn sách đang chờ một lần đọc đúng lúc — chúng tôi sẽ giữ lại tình trạng và giá hiện tại của từng bản.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-6 border-l-2 border-[#e6dec8] pl-4 sm:gap-8 sm:pl-5\" data-kid=\"1-2-3-1-2\" data-name=\"stats grid container\">\n                    <div data-kid=\"1-2-3-1-2-1\" data-name=\"total books stat\">\n                        <div class=\"text-[24px] font-semibold leading-none text-[#1e2d24]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"stat count text\">\n                            12\n                        </div>\n                        <div class=\"mt-1 text-[11px] text-[#5a685d]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"stat description\">\n                            cuốn đã lưu\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-3-1-2-2\" data-name=\"rare books stat\">\n                        <div class=\"text-[24px] font-semibold leading-none text-[#881337]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"stat count text\">\n                            3\n                        </div>\n                        <div class=\"mt-1 text-[11px] text-[#5a685d]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"stat description\">\n                            bản hiếm\n                        </div>\n                    </div>\n                    <div class=\"hidden sm:block\" data-kid=\"1-2-3-1-2-3\" data-name=\"displayed books stat\">\n                        <div class=\"text-[24px] font-semibold leading-none text-[#885200]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"stat count text\">\n                            4\n                        </div>\n                        <div class=\"mt-1 text-[11px] text-[#5a685d]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"stat description\">\n                            đang hiển thị\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div aria-label=\"Tìm kiếm và sắp xếp\" class=\"mt-7 flex flex-wrap items-center gap-3 rounded-[6px] border border-[#e6dec8] bg-[#f4efea] p-3\" data-kid=\"1-2-3-2\" data-name=\"wishlist utility bar\">\n                <label class=\"flex h-10 min-w-[220px] flex-1 items-center gap-2 rounded-[4px] border border-[#e6dec8] bg-[#fbf9f6] px-3 text-[12px] text-[#5a685d] sm:min-w-[300px]\" data-kid=\"1-2-3-2-1\" data-name=\"list search field\">\n                    <i class=\"h-4 w-4 text-[#1e2d24]\" data-kid=\"1-2-3-2-1-1\" data-lucide=\"search\" data-name=\"search icon\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"1-2-3-2-1-2\" data-name=\"search placeholder text\">\n                        Tìm trong danh sách đã lưu\n                    </span>\n                </label>\n                <button class=\"flex h-10 items-center gap-2 rounded-[4px] border border-[#e6dec8] bg-[#fbf9f6] px-3 text-[11px] text-[#334135]\" data-kid=\"1-2-3-2-2\" data-name=\"sort button\">\n                    Sắp xếp:\n                    <span class=\"font-semibold\" data-kid=\"1-2-3-2-2-1\" data-name=\"active sort text\">\n                        Mới lưu nhất\n                    </span>\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-3-2-2-2\" data-lucide=\"chevron-down\" data-name=\"dropdown icon\">\n                    </i>\n                </button>\n                <button class=\"flex h-10 items-center gap-2 rounded-[4px] border border-[#1e2d24] bg-[#fbf9f6] px-4 text-[11px] font-semibold text-[#1e2d24]\" data-kid=\"1-2-3-2-3\" data-name=\"filter button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-3-2-3-1\" data-lucide=\"sliders-horizontal\" data-name=\"filter icon\">\n                    </i>\n                    Bộ lọc\n                </button>\n            </div>\n            <div aria-label=\"Bộ lọc danh sách\" class=\"mt-6 flex flex-wrap gap-2\" data-kid=\"1-2-3-3\" data-name=\"list filters container\">\n                <button class=\"rounded-full border border-[#1e2d24] bg-[#1e2d24] px-3 py-1.5 text-[11px] font-semibold text-white\" data-kid=\"1-2-3-3-1\"