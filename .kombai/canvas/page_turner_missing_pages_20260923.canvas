lex-1 bg-[var(--forest)]\" data-kid=\"1-4-7-2-2-2-2\" data-name=\"timeline track\">\n                        </div>\n                        <div class=\"flex w-16 shrink-0 flex-col items-center gap-1 text-center\" data-kid=\"1-4-7-2-2-2-3\" data-name=\"timeline step\">\n                            <div class=\"grid h-5 w-5 place-items-center rounded-full bg-[var(--forest)] text-[var(--white)]\" data-kid=\"1-4-7-2-2-2-3-1\" data-name=\"check mark icon\">\n                                ✓\n                            </div>\n                            <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-4-7-2-2-2-3-2\" data-name=\"step label\">\n                                Đã giao\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 rounded-[4px] bg-[var(--paper)] px-3 py-3 text-[10px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-7-2-2-3\" data-name=\"delivery information text\">\n                        Kiện hàng đã được giao an toàn đến\n                        <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-4-7-2-2-3-1\" data-name=\"recipient address\">\n                            Phòng 402, số 18 phố Chân Cầm, Hoàn Kiếm.\n                        </span>\n                        <br data-kid=\"1-4-7-2-2-3-2\" data-name=\"line break\"/>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-7-2-2-3-3\" data-name=\"delivery details text\">\n                            Giao bởi Giao Hàng Nhanh · 18/12/2024, 14:26\n                        </span>\n                    </div>\n                    <button class=\"mt-4 w-full rounded-[4px] border border-[var(--ink)] bg-[var(--white)] px-3 py-2.5 text-[10px] font-semibold text-[var(--ink)]\" data-kid=\"1-4-7-2-2-4\" data-name=\"view receipt button\">\n                        Xem biên nhận\n                    </button>\n                </aside>\n            </div>\n            <div class=\"flex flex-col gap-3 border-t border-[var(--line)] bg-[var(--paper-2)] px-4 py-4 sm:flex-row sm:items-center sm:justify-between md:px-5\" data-kid=\"1-4-7-3\" data-name=\"order footer actions\">\n                <div class=\"text-[10px] text-[var(--muted)]\" data-kid=\"1-4-7-3-1\" data-name=\"order total price container\">\n                    2 sản phẩm\n                    <span class=\"mx-2 text-[var(--line)]\" data-kid=\"1-4-7-3-1-1\" data-name=\"separator\">\n                        ·\n                    </span>\n                    Tổng cộng\n                    <span class=\"ml-1 text-[17px] font-semibold text-[var(--ink)]\" data-kid=\"1-4-7-3-1-2\" data-name=\"order total amount text\">\n                        485.000 ₫\n                    </span>\n                </div>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"1-4-7-3-2\" data-name=\"action buttons container\">\n                    <button class=\"rounded-[4px] border border-[var(--ink)] bg-[var(--white)] px-4 py-2.5 text-[10px] font-semibold text-[var(--ink)]\" data-kid=\"1-4-7-3-2-1\" data-name=\"view details button\">\n                        Xem chi tiết\n                    </button>\n                    <button class=\"rounded-[4px] bg-[var(--forest)] px-4 py-2.5 text-[10px] font-semibold text-[var(--white)]\" data-kid=\"1-4-7-3-2-2\" data-name=\"track shipment button\">\n                        Theo dõi kiện hàng\n                        <span class=\"ml-1\" data-kid=\"1-4-7-3-2-2-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </article>\n        <div class=\"mt-7 flex flex-col gap-3 border border-[var(--line)] bg-[var(--paper-2)] px-4 py-4 text-[10px] leading-5 text-[var(--muted)] md:flex-row md:items-center md:justify-between md:px-5\" data-kid=\"1-4-8\" data-name=\"support banner section\">\n            <div data-kid=\"1-4-8-1\" data-name=\"support info text container\">\n                <span class=\"mr-2 inline-grid h-5 w-5 place-items-center rounded-full bg-[var(--amber)] text-[var(--white)]\" data-kid=\"1-4-8-1-1\" data-name=\"help icon\">\n                    i\n                </span>\n                <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-4-8-1-2\" data-name=\"help emphasis text\">\n                    Cần hỗ trợ với đơn hàng?\n                </span>\n                Đội ngũ The Page Turner sẵn sàng giải đáp từ 08:30 – 21:30 mỗi ngày.\n            </div>\n            <button class=\"w-fit rounded-[4px] border border-[var(--ink)] bg-[var(--white)] px-3 py-2 text-[10px] font-semibold text-[var(--ink)]\" data-kid=\"1-4-8-2\" data-name=\"contact support button\">\n                Gọi 0988 123 456\n            </button>\n        </div>\n    </main>\n    <footer class=\"border-t border-[var(--line)] bg-[var(--paper-3)] px-4 py-9 md:px-10 md:py-10\" data-kid=\"1-5\" data-name=\"footer section\">\n        <div class=\"mx-auto grid max-w-[1200px] gap-8 text-[10px] leading-5 text-[var(--muted)] sm:grid-cols-2 lg:grid-cols-4 lg:gap-12\" data-kid=\"1-5-1\" data-name=\"footer content grid\">\n            <div data-kid=\"1-5-1-1\" data-name=\"about store column\">\n                <div class=\"font-[var(--display)] text-[15px] text-[var(--ink)]\" data-kid=\"1-5-1-1-1\" data-name=\"store name\">\n                    The Page Turner\n                </div>\n                <p class=\"mt-3\" data-kid=\"1-5-1-1-2\" data-name=\"about store description text\">\n                    Nơi gìn giữ và trao gửi những giá trị tri thức qua năm tháng. Mỗi cuốn sách là một chứng nhân của thời gian, được thẩm định tỉ mỉ và tuyển chọn cẩn trọng.\n                </p>\n                <p class=\"mt-3 font-semibold text-[var(--ink)]\" data-kid=\"1-5-1-1-3\" data-name=\"location tag text\">\n                    ⌖ Tiệm sách độc lập Hà Nội\n                </p>\n            </div>\n            <div data-kid=\"1-5-1-2\" data-name=\"support links column\">\n                <div class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-5-1-2-1\" data-name=\"column heading\">\n                    Hỗ trợ & Chính sách\n                </div>\n                <p class=\"mt-3\" data-kid=\"1-5-1-2-2\" data-name=\"policy links list\">\n                    Quy chuẩn phân loại tình trạng sách\n                    <br data-kid=\"1-5-1-2-2-1\" data-name=\"line break\"/>\n                    Chính sách kiểm tra & đổi trả 7 ngày\n                    <br data-kid=\"1-5-1-2-2-2\" data-name=\"line break\"/>\n                    Giao hàng & đóng gói chuyên dụng\n                    <br data-kid=\"1-5-1-2-2-3\" data-name=\"line break\"/>\n                    Ký gửi & thu mua sách cũ hiếm\n                </p>\n            </div>\n            <div data-kid=\"1-5-1-3\" data-name=\"contact info column\">\n                <div class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-5-1-3-1\" data-name=\"column heading\">\n                    Liên hệ tiệm sách\n                </div>\n                <p class=\"mt-3\" data-kid=\"1-5-1-3-2\" data-name=\"contact list\">\n                    ⌖ 42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                    <br data-kid=\"1-5-1-3-2-1\" data-name=\"line break\"/>\n                    ☎ Hotline: 0988 123 456\n                    <br data-kid=\"1-5-1-3-2-2\" data-name=\"line break\"/>\n                    ✉ thuthu@thepageturner.vn\n                    <br data-kid=\"1-5-1-3-2-3\" data-name=\"line break\"/>\n                    ◷ Mở cửa: 08:30 – 21:30 hàng ngày\n                </p>\n            </div>\n            <div data-kid=\"1-5-1-4\" data-name=\"newsletter signup column\">\n                <div class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-5-1-4-1\" data-name=\"column heading\">\n                    Bản tin Sách Hiếm\n                </div>\n                <p class=\"mt-3\" data-kid=\"1-5-1-4-2\" data-name=\"newsletter description text\">\n                    Nhận danh mục bản tuyển chọn, sách cũ ký và bản in đầu phát hành mỗi sáng thứ Bảy.\n                </p>\n                <div class=\"mt-3 flex h-9 items-center rounded-[4px] border border-[var(--line)] bg-[var(--white)] px-3 text-[10px]\" data-kid=\"1-5-1-4-3\" data-name=\"email input field\">\n                    Địa chỉ email của bạn...\n                </div>\n                <button class=\"mt-2 w-full rounded-[4px] bg-[var(--forest)] px-3 py-2 text-[10px] font-semibold text-[var(--white)]\" data-kid=\"1-5-1-4-4\" data-name=\"newsletter subscribe button\">\n                    Đăng ký nhận tin\n                </button>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-8 flex max-w-[1200px] flex-col gap-3 border-t border-[var(--line)] pt-5 text-[9px] text-[var(--muted)] md:flex-row md:items-center md:justify-between\" data-kid=\"1-5-2\" data-name=\"footer bottom bar\">\n            <span data-kid=\"1-5-2-1\" data-name=\"copyright notice text\">\n                © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n            </span>\n            <span data-kid=\"1-5-2-2\" data-name=\"footer secondary links\">\n                Điều khoản dịch vụ\n                <span class=\"mx-2\" data-kid=\"1-5-2-2-1\" data-name=\"separator\">\n                    ·\n                </span>\n                Chính sách bảo mật\n                <span class=\"mx-2\" data-kid=\"1-5-2-2-2\" data-name=\"separator\">\n                    ·\n                </span>\n                Chứng thư ấn bản\n            </span>\n        </div>\n    </footer>\n</div>\n",
