      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n\n.pt-page {\n  --paper: #faf8f5;\n  --forest: #1e2d24;\n  --forest-deep: #16241c;\n  --ink: #334135;\n  --muted: #5a685d;\n  --linen: #f4efea;\n  --thread: #e6dec8;\n  --amber: #c27803;\n  --amber-soft: rgba(194, 120, 3, 0.12);\n  --burgundy: #881337;\n  --white: #ffffff;\n  color: var(--ink);\n  background: var(--paper);\n  font-family: 'Be Vietnam Pro', sans-serif;\n}\n.pt-page .pt-serif { font-family: 'Playfair Display', serif; }\n.pt-page input::placeholder,\n.pt-page textarea::placeholder { color: #879087; opacity: 1; }\n.pt-page input:focus,\n.pt-page textarea:focus,\n.pt-page select:focus { outline: none; border-color: var(--amber); box-shadow: 0 0 0 3px var(--amber-soft); }\n.pt-page select {\n  appearance: none;\n  background-image: linear-gradient(45deg, transparent 50%, var(--forest) 50%), linear-gradient(135deg, var(--forest) 50%, transparent 50%);\n  background-position: calc(100% - 16px) 50%, calc(100% - 11px) 50%;\n  background-size: 5px 5px, 5px 5px;\n  background-repeat: no-repeat;\n}\n</style>\n<div class=\"pt-page w-full overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"border-b border-white/10 bg-[var(--forest)] px-4 py-2 text-[10px] text-white/75 sm:px-6 lg:px-10\" data-kid=\"1-1\" data-name=\"top utility bar\">\n        <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-4\" data-kid=\"1-1-1\" data-name=\"utility bar inner container\">\n            <span class=\"truncate\" data-kid=\"1-1-1-1\" data-name=\"promotional trust text\">\n                Cam kết 100% sách thật · Kiểm tra trước khi thanh toán\n            </span>\n            <span class=\"hidden shrink-0 sm:inline\" data-kid=\"1-1-1-2\" data-name=\"store hours and contact info\">\n                Hà Nội 08:30 – 21:30 · Hotline: 0988 123 456\n            </span>\n        </div>\n    </div>\n    <header class=\"border-b border-[var(--thread)] bg-[var(--paper)]\" data-kid=\"1-2\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1200px] items-center gap-5 px-4 py-4 sm:px-6 lg:gap-8 lg:px-10\" data-kid=\"1-2-1\" data-name=\"header inner flex container\">\n            <div class=\"w-[168px] shrink-0 leading-none sm:w-[188px]\" data-kid=\"1-2-1-1\" data-name=\"brand logo area\">\n                <div class=\"pt-serif text-[21px] font-semibold tracking-[-0.02em] text-[var(--forest)] sm:text-[24px]\" data-kid=\"1-2-1-1-1\" data-name=\"brand title text\">\n                    The Page Turner\n                </div>\n                <div class=\"mt-1 text-[8px] font-semibold uppercase tracking-[0.18em] text-[var(--muted)] sm:text-[9px]\" data-kid=\"1-2-1-1-2\" data-name=\"brand tagline text\">\n                    Hiệu sách cũ & quý hiếm\n                </div>\n            </div>\n            <div class=\"hidden min-w-0 flex-1 items-center border border-[var(--thread)] bg-[var(--linen)] px-4 py-3 text-[12px] text-[var(--muted)] md:flex\" data-kid=\"1-2-1-2\" data-name=\"search input field container\">\n                <span aria-hidden=\"true\" class=\"mr-3 text-[19px] leading-none text-[var(--forest)]\" data-kid=\"1-2-1-2-1\" data-name=\"search magnifying glass icon\">\n                    ⌕\n                </span>\n                <span class=\"truncate\" data-kid=\"1-2-1-2-2\" data-name=\"search placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản & lịch sử\n                </span>\n                <span class=\"ml-auto hidden border-l border-[var(--thread)] pl-3 text-[10px] font-semibold text-[var(--forest)] lg:inline\" data-kid=\"1-2-1-2-3\" data-name=\"search filter badge\">\n                    Trước 1975\n                </span>\n            </div>\n            <div class=\"ml-auto flex items-center gap-3 text-[11px] font-semibold text-[var(--forest)] sm:gap-5\" data-kid=\"1-2-1-3\" data-name=\"header actions group\">\n                <span class=\"hidden lg:inline\" data-kid=\"1-2-1-3-1\" data-name=\"wishlist link\">\n                    ♡ Yêu thích\n                </span>\n                <span class=\"hidden sm:inline\" data-kid=\"1-2-1-3-2\" data-name=\"cart link\">\n                    ♧ Giỏ hàng\n                </span>\n                <span class=\"rounded-full bg-[var(--forest)] px-3 py-2 text-[10px] text-white sm:text-[11px]\" data-kid=\"1-2-1-3-3\" data-name=\"member portal button\">\n                    Thành viên\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Điều hướng chính\" class=\"hidden border-t border-[var(--thread)] lg:block\" data-kid=\"1-2-2\" data-name=\"main navigation bar\">\n            <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-5 px-10 py-3 text-[11px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-2-1\" data-name=\"navigation link container\">\n                <span data-kid=\"1-2-2-1-1\" data-name=\"navigation item link\">\n                    Trang chủ\n                </span>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"navigation item link\">\n                    Danh mục sách\n                </span>\n                <span data-kid=\"1-2-2-1-3\" data-name=\"navigation item link\">\n                    Văn học kinh điển\n                </span>\n                <span data-kid=\"1-2-2-1-4\" data-name=\"navigation item link\">\n                    Lịch sử & triết học\n                </span>\n                <span data-kid=\"1-2-2-1-5\" data-name=\"navigation item link\">\n                    Sách hiếm\n                </span>\n                <span class=\"border-b-2 border-[var(--amber)] pb-2 text-[var(--forest)]\" data-kid=\"1-2-2-1-6\" data-name=\"active navigation item link\">\n                    Ký gửi & thu mua\n                </span>\n                <span data-kid=\"1-2-2-1-7\" data-name=\"navigation item link\">\n                    Về chúng tôi\n                </span>\n            </div>\n        </nav>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main page content area\">\n        <div class=\"mx-auto flex max-w-[1200px] items-center gap-2 px-4 pt-5 text-[11px] text-[var(--muted)] sm:px-6 lg:px-10\" data-kid=\"1-3-1\" data-name=\"breadcrumb navigation bar\">\n            <span data-kid=\"1-3-1-1\" data-name=\"breadcrumb item text\">\n                Trang chủ\n            </span>\n            <span class=\"text-[var(--thread)]\" data-kid=\"1-3-1-2\" data-name=\"breadcrumb separator\">\n                /\n            </span>\n            <span data-kid=\"1-3-1-3\" data-name=\"breadcrumb item text\">\n                Đồng hành cùng sách\n            </span>\n            <span class=\"text-[var(--thread)]\" data-kid=\"1-3-1-4\" data-name=\"breadcrumb separator\">\n                /\n            </span>\n            <span class=\"font-semibold text-[var(--forest)]\" data-kid=\"1-3-1-5\" data-name=\"breadcrumb active item text\">\n                Ký gửi & thu mua sách cũ\n            </span>\n        </div>\n        <section aria-labelledby=\"hero-title\" class=\"border-b border-[var(--thread)]\" data-kid=\"1-3-2\" data-name=\"hero section\">\n            <div class=\"mx-auto grid max-w-[1200px] grid-cols-1 gap-10 px-4 pb-14 pt-9 sm:px-6 md:grid-cols-12 md:gap-8 md:px-10 md:pb-16 md:pt-12\" data-kid=\"1-3-2-1\" data-name=\"hero content grid\">\n                <div class=\"md:col-span-7 md:self-center\" data-kid=\"1-3-2-1-1\" data-name=\"hero text content block\">\n                    <div class=\"mb-4 text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--amber)]\" data-kid=\"1-3-2-1-1-1\" data-name=\"hero pre-title label\">\n                        Ký gửi · Thu mua · Bảo tồn\n                    </div>\n                    <h1 class=\"pt-serif max-w-[660px] text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-[var(--forest)] sm:text-[45px] md:text-[52px]\" data-kid=\"1-3-2-1-1-2\" data-name=\"hero headline text\" id=\"hero-title\">\n                        Trao lại một đời sách,\n                        <br data-kid=\"1-3-2-1-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[var(--burgundy)]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"hero headline highlighted text\">\n                            để câu chuyện tiếp tục.\n                        </span>\n                    </h1>\n                    <p class=\"mt-6 max-w-[560px] text-[15px] leading-7 text-[var(--muted)] sm:text-[16px]\" data-kid=\"1-3-2-1-1-3\" data-name=\"hero description paragraph\">\n                        The Page Turner nhận ký gửi và thu mua những cuốn sách có giá trị đọc, giá trị sưu tầm và một câu chuyện đáng được giữ lại.\n                    </p>\n                    <div class=\"mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center\" data-kid=\"1-3-2-1-1-4\" data-name=\"hero call-to-action button group\">\n                        <a class=\"rounded-[4px] bg-[var(--forest)] px-5 py-3 text-center text-[13px] font-semibold text-white shadow-[0_8px_18px_-12px_rgba(30,45,36,.7)] transition hover:bg-[var(--amber)]\" data-kid=\"1-3-2-1-1-4-1\" data-name=\"primary call-to-action button\" href=\"#submission\">\n                            Gửi thông tin sách\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-2-1-1-4-1-1\" data-name=\"arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                        <a class=\"rounded-[4px] border border-[var(--forest)] bg-transparent px-5 py-3 text-center text-[13px] font-semibold text-[var(--forest)] transition hover:bg-[var(--linen)]\" data-kid=\"1-3-2-1-1-4-2\" data-name=\"secondary call-to-action button\" href=\"#process\">\n                            Xem quy trình\n                        </a>\n                    </div>\n                    <div class=\"mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[11px] text-[var(--muted)]\" data-kid=\"1-3-2-1-1-5\" data-name=\"trust signals group\">\n                        <span data-kid=\"1-3-2-1-1-5-1\" data-name=\"trust signal item\">\n                            ✓ Thẩm định minh bạch\n                        </span>\n                        <span data-kid=\"1-3-2-1-1-5-2\" data-name=\"trust signal item\">\n                            ✓ Báo giá trong 2–3 ngày\n                        </span>\n                        <span data-kid=\"1-3-2-1-1-5-3\" data-name=\"trust signal item\">\n                            ✓ Bảo quản lưu trữ\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative min-h-[360px] overflow-hidden rounded-[5px] bg-[var(--forest)] p-7 text-white shadow-[0_16px_30px_-14px_rgba(30,45,36,.45)] md:col-span-5 md:min-h-[390px] md:p-8\" data-kid=\"1-3-2-1-2\" data-name=\"hero visual card container\">\n                    <div class=\"relative flex h-full min-h-[306px] flex-col justify-between md:min-h-[326px]\" data-kid=\"1-3-2-1-2-1\" data-name=\"hero visual card content\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"visual card badge container\">\n                            <span class=\"rounded-full border border-[#f4c477]/65 px-3 py-1 text-[9px] font-semibold uppercase tracking-[0.17em] text-[#f4c477]\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"visual card badge label\">\n                                Sổ tay ký gửi · 01\n                            </span>\n                            <span class=\"pt-serif text-[39px] leading-none text-white/20\" data-kid=\"1-3-2-1-2-1-1-2\" data-name=\"visual card watermark text\">\n                                PT\n                            </span>\n                        </div>\n                        <div data-kid=\"1-3-2-1-2-1-2\" data-name=\"visual card book graphic container\">\n                            <div class=\"mb-6 h-[166px] w-[122px] rotate-[-5deg] border-l-[7px] border-[var(--forest-deep)] bg-[#b86c37] p-3 shadow-[10px_10px_0_rgba(0,0,0,.15)] sm:h-[175px] sm:w-[128px]\" data-kid=\"1-3-2-1-2-1-2-1\" data-name=\"book cover block\">\n                                <div class=\"h-full border border-[#f1d7aa]/70 p-2 text-center\" data-kid=\"1-3-2-1-2-1-2-1-1\" data-name=\"book cover detail block\">\n                                    <div class=\"pt-serif text-[14px] leading-4 text-[#fff0d1]\" data-kid=\"1-3-2-1-2-1-2-1-1-1\" data-name=\"book title text\">\n                                        MỘT\n                                        <br data-kid=\"1-3-2-1-2-1-2-1-1-1-1\"/>\n                                        ĐỜI\n                                        <br data-kid=\"1-3-2-1-2-1-2-1-1-1-2\"/>\n                                        SÁCH\n                                    </div>\n                                    <div class=\"mt-7 text-[8px] uppercase tracking-[0.15em] text-[#f4c477]\" data-kid=\"1-3-2-1-2-1-2-1-1-2\" data-name=\"book genre text\">\n                                        lưu truyền\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"max-w-[300px] border-t border-white/20 pt-4\" data-kid=\"1-3-2-1-2-1-2-2\" data-name=\"visual card highlight box\">\n                                <div class=\"text-[9px] uppercase tracking-[0.18em] text-[#f4c477]\" data-kid=\"1-3-2-1-2-1-2-2-1\" data-name=\"highlight label\">\n                                    Bản thảo của bạn\n                                </div>\n                                <div class=\"pt-serif mt-2 text-[23px] leading-8 sm:text-[25px]\" data-kid=\"1-3-2-1-2-1-2-2-2\" data-name=\"highlight title text\">\n                                    Có thể là\n                                    <br data-kid=\"1-3-2-1-2-1-2-2-2-1\" data-name=\"highlight line break\"/>\n                                    một phát hiện mới.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-end justify-between text-[10px] text-white/60 sm:text-[11px]\" data-kid=\"1-3-2-1-2-1-3\" data-name=\"visual card footer info\">\n                            <span data-kid=\"1-3-2-1-2-1-3-1\" data-name=\"store location info\">\n                                Hà Nội · từ 2018\n                            </span>\n                            <span class=\"font-semibold text-white\" data-kid=\"1-3-2-1-2-1-3-2\" data-name=\"call-to-action link\">\n                                → Bắt đầu gửi\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"process-title\" class=\"px-4 py-14 sm:px-6 lg:px-10 lg:py-16\" data-kid=\"1-3-3\" data-name=\"process section\" id=\"process\">\n            <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-3-3-1\" data-name=\"process inner container\">\n                <div class=\"mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between\" data-kid=\"1-3-3-1-1\" data-name=\"process section header\">\n                    <div data-kid=\"1-3-3-1-1-1\" data-name=\"process title group\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--amber)]\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"process pre-title label\">\n                            Cách chúng tôi làm việc\n                        </div>\n                        <h2 class=\"pt-serif mt-2 text-[29px] font-semibold text-[var(--forest)] sm:text-[33px]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"process section title\" id=\"process-title\">\n                            Bốn bước để sách được trao đúng nơi\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[330px] text-[13px] leading-6 text-[var(--muted)] md:text-right\" data-kid=\"1-3-3-1-1-2\" data-name=\"process section description\">\n                        Từ thông tin ban đầu đến lúc hoàn tất ký gửi, mọi mốc đều được thông báo rõ ràng.\n                    </p>\n                </div>\n                <div class=\"relative grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4\" data-kid=\"1-3-3-1-2\" data-name=\"process step grid\">\n                    <div class=\"absolute left-[8%] right-[8%] top-9 hidden border-t border-dashed border-[var(--amber)]/50 lg:block\" data-kid=\"1-3-3-1-2-1\" data-name=\"step connector line\">\n                    </div>\n                    <article class=\"relative p-5\" data-kid=\"1-3-3-1-2-2\" data-name=\"process step article\">\n                        <div class=\"mb-7 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--forest)] text-[11px] font-semibold text-white\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"step number badge\">\n                            01\n                        </div>\n                        <h3 class=\"pt-serif text-[20px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"step title\">\n                            Gửi thông tin\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-3-1-2-2-3\" data-name=\"step description\">\n                            Cho chúng tôi biết về bạn và cuốn sách đang muốn trao lại.\n                        </p>\n                        <div class=\"mt-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--amber)]\" data-kid=\"1-3-3-1-2-2-4\" data-name=\"step detail label\">\n                            Form trực tuyến\n                        </div>\n                    </article>\n                    <article class=\"relative p-5\" data-kid=\"1-3-3-1-2-3\" data-name=\"process step article\">\n                        <div class=\"mb-7 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--amber)] text-[11px] font-semibold text-white\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"step number badge\">\n                            02\n                        </div>\n                        <h3 class=\"pt-serif text-[20px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"step title\">\n                            Thẩm định\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-3-1-2-3-3\" data-name=\"step description\">\n                            Đội ngũ xem xét tình trạng, ấn bản, nhu cầu đọc và sưu tầm.\n                        </p>\n                        <div class=\"mt-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--amber)]\" data-kid=\"1-3-3-1-2-3-4\" data-name=\"step detail label\">\n                            2–3 ngày làm việc\n                        </div>\n                    </article>\n                    <article class=\"relative p-5\" data-kid=\"1-3-3-1-2-4\" data-name=\"process step article\">\n                        <div class=\"mb-7 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--forest)] text-[11px] font-semibold text-white\" data-kid=\"1-3-3-1-2-4-1\" data-name=\"step number badge\">\n                            03\n                        </div>\n                        <h3 class=\"pt-serif text-[20px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-3-1-2-4-2\" data-name=\"step title\">\n                            Định giá\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-3-1-2-4-3\" data-name=\"step description\">\n                            Báo giá dựa trên tình trạng, độ hiếm và thị trường thực tế.\n                        </p>\n                        <div class=\"mt-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--amber)]\" data-kid=\"1-3-3-1-2-4-4\" data-name=\"step detail label\">\n                            Có căn cứ\n                        </div>\n                    </article>\n                    <article class=\"relative p-5\" data-kid=\"1-3-3-1-2-5\" data-name=\"process step article\">\n                        <div class=\"mb-7 flex h-8 w-8 items-center justify-center rounded-full bg-[var(--burgundy)] text-[11px] font-semibold text-white\" data-kid=\"1-3-3-1-2-5-1\" data-name=\"step number badge\">\n                            04\n                        </div>\n                        <h3 class=\"pt-serif text-[20px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-3-1-2-5-2\" data-name=\"step title\">\n                            Ký gửi / Thu mua\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-3-1-2-5-3\" data-name=\"step description\">\n                            Bạn chọn hình thức phù hợp, chúng tôi tiếp nhận và bảo quản sách.\n                        </p>\n                        <div class=\"mt-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--burgundy)]\" data-kid=\"1-3-3-1-2-5-4\" data-name=\"step detail label\">\n                            Hoàn tất minh bạch\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"criteria-title\" class=\"border-y border-[var(--thread)] bg-[var(--linen)] px-4 py-14 sm:px-6 lg:px-10 lg:py-16\" data-kid=\"1-3-4\" data-name=\"criteria section\">\n            <div class=\"mx-auto grid max-w-[1200px] grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-3-4-1\" data-name=\"criteria inner grid\">\n                <div class=\"lg:col-span-4\" data-kid=\"1-3-4-1-1\" data-name=\"criteria text block\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--amber)]\" data-kid=\"1-3-4-1-1-1\" data-name=\"criteria pre-title label\">\n                        Tiêu chí tiếp nhận\n                    </div>\n                    <h2 class=\"pt-serif mt-2 text-[30px] font-semibold leading-9 text-[var(--forest)] sm:text-[33px]\" data-kid=\"1-3-4-1-1-2\" data-name=\"criteria section title\" id=\"criteria-title\">\n                        Một cuốn sách\n                        <br data-kid=\"1-3-4-1-1-2-1\" data-name=\"headline line break\"/>\n                        đáng để lưu giữ.\n                    </h2>\n                    <p class=\"mt-4 max-w-[360px] text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-4-1-1-3\" data-name=\"criteria description\">\n                        Chúng tôi ưu tiên những ấn bản có nội dung tốt, nguồn gốc rõ và tình trạng đủ để tiếp tục một vòng đời mới.\n                    </p>\n                    <div class=\"mt-6 border-l-2 border-[var(--burgundy)] pl-4 text-[12px] italic leading-5 text-[var(--muted)]\" data-kid=\"1-3-4-1-1-4\" data-name=\"quote block\">\n                        “Không chỉ là bán lại. Là tìm một người đọc tiếp theo.”\n                    </div>\n                </div>\n                <div class=\"grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:col-span-8\" data-kid=\"1-3-4-1-2\" data-name=\"criteria items grid\">\n                    <article class=\"border-t border-[var(--thread)] pt-5\" data-kid=\"1-3-4-1-2-1\" data-name=\"criterion article\">\n                        <div aria-hidden=\"true\" class=\"mb-4 text-[22px] text-[var(--amber)]\" data-kid=\"1-3-4-1-2-1-1\" data-name=\"criterion icon\">\n                            ✦\n                        </div>\n                        <h3 class=\"pt-serif text-[18px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-4-1-2-1-2\" data-name=\"criterion title\">\n                            Nội dung có giá trị\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-4-1-2-1-3\" data-name=\"criterion description\">\n                            Văn học, lịch sử, triết học, nghệ thuật, sách thiếu nhi chọn lọc và ngoại văn.\n                        </p>\n                    </article>\n                    <article class=\"border-t border-[var(--thread)] pt-5\" data-kid=\"1-3-4-1-2-2\" data-name=\"criterion article\">\n                        <div aria-hidden=\"true\" class=\"mb-4 text-[22px] text-[var(--amber)]\" data-kid=\"1-3-4-1-2-2-1\" data-name=\"criterion icon\">\n                            ⌑\n                        </div>\n                        <h3 class=\"pt-serif text-[18px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-4-1-2-2-2\" data-name=\"criterion title\">\n                            Ấn bản rõ ràng\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-4-1-2-2-3\" data-name=\"criterion description\">\n                            Có thông tin tác giả, nhà xuất bản và năm in đủ để xác định ấn bản.\n                        </p>\n                    </article>\n                    <article class=\"border-t border-[var(--thread)] pt-5\" data-kid=\"1-3-4-1-2-3\" data-name=\"criterion article\">\n                        <div aria-hidden=\"true\" class=\"mb-4 text-[22px] text-[var(--amber)]\" data-kid=\"1-3-4-1-2-3-1\" data-name=\"criterion icon\">\n                            ◌\n                        </div>\n                        <h3 class=\"pt-serif text-[18px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-4-1-2-3-2\" data-name=\"criterion title\">\n                            Tình trạng ổn định\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-4-1-2-3-3\" data-name=\"criterion description\">\n                            Không mốc, không mùi ẩm nặng; gáy và ruột còn chắc, có thể đọc hoặc trưng bày.\n                        </p>\n                    </article>\n                    <article class=\"border-t border-[var(--thread)] pt-5\" data-kid=\"1-3-4-1-2-4\" data-name=\"criterion article\">\n                        <div aria-hidden=\"true\" class=\"mb-4 text-[22px] text-[var(--burgundy)]\" data-kid=\"1-3-4-1-2-4-1\" data-name=\"criterion icon\">\n                            ◈\n                        </div>\n                        <h3 class=\"pt-serif text-[18px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-4-1-2-4-2\" data-name=\"criterion title\">\n                            Dấu ấn riêng cũng được đón nhận\n                        </h3>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-4-1-2-4-3\" data-name=\"criterion description\">\n                            Bản có chữ ký, lời đề tặng hay ghi chú được xem xét riêng theo giá trị.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"submission-title\" class=\"px-4 py-14 sm:px-6 lg:px-10 lg:py-16\" data-kid=\"1-3-5\" data-name=\"submission form section\" id=\"submission\">\n            <div class=\"mx-auto grid max-w-[1200px] grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-3-5-1\" data-name=\"submission inner grid\">\n                <form class=\"border border-[var(--thread)] bg-white p-5 sm:p-7 lg:col-span-7\" data-kid=\"1-3-5-1-1\" data-name=\"submission form\" onsubmit=\"return false;\">\n                    <div class=\"flex flex-col gap-3 border-b border-[var(--thread)] pb-5 sm:flex-row sm:items-start sm:justify-between\" data-kid=\"1-3-5-1-1-1\" data-name=\"form header\">\n                        <div data-kid=\"1-3-5-1-1-1-1\" data-name=\"form pre-title label\">\n                            <div class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--amber)]\" data-kid=\"1-3-5-1-1-1-1-1\" data-name=\"form pre-title\">\n                                Bắt đầu tại đây\n                            </div>\n                            <h2 class=\"pt-serif mt-2 text-[29px] font-semibold text-[var(--forest)] sm:text-[32px]\" data-kid=\"1-3-5-1-1-1-1-2\" data-name=\"form title\" id=\"submission-title\">\n                                Gửi thông tin sách\n                            </h2>\n                        </div>\n                        <span class=\"w-fit rounded-full bg-[var(--linen)] px-3 py-1 text-[10px] font-semibold text-[var(--muted)]\" data-kid=\"1-3-5-1-1-1-2\" data-name=\"time estimate badge\">\n                            Mất khoảng 3 phút\n                        </span>\n                    </div>\n                    <p class=\"mt-5 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-5-1-1-2\" data-name=\"form description\">\n                        Bạn chưa cần gửi sách ngay. Hãy để lại thông tin, chúng tôi sẽ liên hệ để trao đổi bước tiếp theo.\n                    </p>\n                    <div class=\"mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2\" data-kid=\"1-3-5-1-1-3\" data-name=\"form input fields container\">\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-3-1\" data-name=\"name field label\">\n                            Họ và tên *\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-3-1-1\" data-name=\"name input field\" placeholder=\"Nguyễn Hoàng Hà\" required=\"\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-3-2\" data-name=\"phone field label\">\n                            Số điện thoại *\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-3-2-1\" data-name=\"phone input field\" placeholder=\"0988 123 456\" required=\"\" type=\"tel\"/>\n                        </label>\n                        <label class=\"sm:col-span-2 text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-3-3\" data-name=\"email field label\">\n                            Email\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-3-3-1\" data-name=\"email input field\" placeholder=\"ban@thepageturner.vn\" type=\"email\"/>\n                        </label>\n                    </div>\n                    <div class=\"my-7 flex items-center gap-3\" data-kid=\"1-3-5-1-1-4\" data-name=\"form divider\">\n                        <span class=\"h-px flex-1 bg-[var(--thread)]\" data-kid=\"1-3-5-1-1-4-1\" data-name=\"divider line\">\n                        </span>\n                        <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-3-5-1-1-4-2\" data-name=\"divider text\">\n                            Thông tin cuốn sách\n                        </span>\n                        <span class=\"h-px flex-1 bg-[var(--thread)]\" data-kid=\"1-3-5-1-1-4-3\" data-name=\"divider line\">\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2\" data-kid=\"1-3-5-1-1-5\" data-name=\"book info fields container\">\n                        <label class=\"sm:col-span-2 text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-1\" data-name=\"book title field label\">\n                            Tên sách *\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-1-1\" data-name=\"book title input field\" placeholder=\"Ví dụ: Số đỏ\" required=\"\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-2\" data-name=\"author field label\">\n                            Tác giả *\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-2-1\" data-name=\"author input field\" placeholder=\"Vũ Trọng Phụng\" required=\"\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-3\" data-name=\"publisher field label\">\n                            Nhà xuất bản\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-3-1\" data-name=\"publisher input field\" placeholder=\"Nhã Nam / NXB Văn học\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-4\" data-name=\"year field label\">\n                            Năm xuất bản\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-4-1\" data-name=\"year input field\" placeholder=\"1972\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-5\" data-name=\"method field label\">\n                            Hình thức mong muốn\n                            <select class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 pr-9 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-5-1\" data-name=\"method select dropdown\">\n                                <option data-kid=\"1-3-5-1-1-5-5-1-1\" data-name=\"select option\">\n                                    Ký gửi — nhận tiền khi bán\n                                </option>\n                                <option data-kid=\"1-3-5-1-1-5-5-1-2\" data-name=\"select option\">\n                                    Thu mua — nhận tiền sau thẩm định\n                                </option>\n                            </select>\n                        </label>\n                        <label class=\"sm:col-span-2 text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-6\" data-name=\"condition description field label\">\n                            Mô tả tình trạng sách\n                            <textarea class=\"mt-2 w-full resize-none border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-6-1\" data-name=\"condition textarea\" placeholder=\"Bìa, gáy, ruột sách, chữ ký, ghi chú hoặc dấu vết sử dụng...\" rows=\"3\"></textarea>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-7\" data-name=\"price estimate field label\">\n                            Giá bạn ước tính\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-7-1\" data-name=\"price input field\" placeholder=\"Ví dụ 350.000 ₫\" type=\"text\"/>\n                        </label>\n                        <label class=\"text-[12px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-1-5-8\" data-name=\"notes field label\">\n                            Ghi chú thêm\n                            <span class=\"font-normal text-[var(--muted)]\" data-kid=\"1-3-5-1-1-5-8-1\" data-name=\"notes field sublabel\">\n                                (tuỳ chọn)\n                            </span>\n                            <input class=\"mt-2 w-full border border-[var(--thread)] bg-[var(--linen)] px-3 py-3 text-[13px] font-normal text-[var(--ink)]\" data-kid=\"1-3-5-1-1-5-8-2\" data-name=\"notes input field\" placeholder=\"Lời đề tặng, nguồn gốc...\" type=\"text\"/>\n                        </label>\n                    </div>\n                    <label class=\"mt-5 flex items-start gap-3 text-[11px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-5-1-1-6\" data-name=\"terms agreement label\">\n                        <input class=\"mt-1 h-4 w-4 accent-[var(--forest)]\" data-kid=\"1-3-5-1-1-6-1\" data-name=\"agreement checkbox\" type=\"checkbox\"/>\n                        <span data-kid=\"1-3-5-1-1-6-2\" data-name=\"agreement text\">\n                            Tôi đồng ý để The Page Turner liên hệ về thông tin sách này.\n                        </span>\n                    </label>\n                    <button class=\"mt-6 w-full rounded-[4px] bg-[var(--forest)] px-5 py-3.5 text-[13px] font-semibold text-white shadow-[0_8px_18px_-10px_rgba(30,45,36,.55)] transition hover:bg-[var(--amber)]\" data-kid=\"1-3-5-1-1-7\" data-name=\"form submit button\" type=\"submit\">\n                        Gửi thông tin sách\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-3-5-1-1-7-1\" data-name=\"arrow icon\">\n                            →\n                        </span>\n                    </button>\n                    <div class=\"mt-3 text-center text-[11px] text-[var(--muted)]\" data-kid=\"1-3-5-1-1-8\" data-name=\"form helper text\">\n                        Chưa cần gửi ảnh ở bước này · Chúng tôi sẽ phản hồi trong 2–3 ngày làm việc\n                    </div>\n                </form>\n                <aside aria-labelledby=\"valuation-title\" class=\"lg:sticky lg:top-4 lg:col-span-5\" data-kid=\"1-3-5-1-2\" data-name=\"aside valuation content\">\n                    <div class=\"bg-[var(--forest)] p-6 text-white sm:p-7\" data-kid=\"1-3-5-1-2-1\" data-name=\"valuation info card\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[#f4c477]\" data-kid=\"1-3-5-1-2-1-1\" data-name=\"valuation pre-title\">\n                            Cam kết định giá\n                        </div>\n                        <h2 class=\"pt-serif mt-2 text-[30px] font-semibold leading-9 sm:text-[32px]\" data-kid=\"1-3-5-1-2-1-2\" data-name=\"valuation title\" id=\"valuation-title\">\n                            Rõ ràng từ\n                            <br data-kid=\"1-3-5-1-2-1-2-1\" data-name=\"title line break\"/>\n                            trang đầu tiên.\n                        </h2>\n                        <p class=\"mt-4 text-[13px] leading-6 text-white/70\" data-kid=\"1-3-5-1-2-1-3\" data-name=\"valuation description\">\n                            Mỗi cuốn sách được đọc như một vật phẩm riêng, không chạy theo một công thức máy móc.\n                        </p>\n                        <div class=\"mt-7 space-y-5\" data-kid=\"1-3-5-1-2-1-4\" data-name=\"valuation points list\">\n                            <div class=\"flex gap-3 border-t border-white/15 pt-4\" data-kid=\"1-3-5-1-2-1-4-1\" data-name=\"point item\">\n                                <span class=\"pt-serif text-[18px] text-[#f4c477]\" data-kid=\"1-3-5-1-2-1-4-1-1\" data-name=\"point index\">\n                                    01\n                                </span>\n                                <div data-kid=\"1-3-5-1-2-1-4-1-2\" data-name=\"point text block\">\n                                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-5-1-2-1-4-1-2-1\" data-name=\"point title\">\n                                        Chấm tình trạng có căn cứ\n                                    </h3>\n                                    <p class=\"mt-1 text-[11px] leading-5 text-white/60\" data-kid=\"1-3-5-1-2-1-4-1-2-2\" data-name=\"point description\">\n                                        Bìa, gáy, ruột, chữ ký và vết ẩm được ghi nhận trung thực.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3 border-t border-white/15 pt-4\" data-kid=\"1-3-5-1-2-1-4-2\" data-name=\"point item\">\n                                <span class=\"pt-serif text-[18px] text-[#f4c477]\" data-kid=\"1-3-5-1-2-1-4-2-1\" data-name=\"point index\">\n                                    02\n                                </span>\n                                <div data-kid=\"1-3-5-1-2-1-4-2-2\" data-name=\"point text block\">\n                                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-5-1-2-1-4-2-2-1\" data-name=\"point title\">\n                                        Ảnh thật, mô tả thật\n                                    </h3>\n                                    <p class=\"mt-1 text-[11px] leading-5 text-white/60\" data-kid=\"1-3-5-1-2-1-4-2-2-2\" data-name=\"point description\">\n                                        Sách đăng bán được chụp tại tiệm, không dùng ảnh minh hoạ.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3 border-t border-white/15 pt-4\" data-kid=\"1-3-5-1-2-1-4-3\" data-name=\"point item\">\n                                <span class=\"pt-serif text-[18px] text-[#f4c477]\" data-kid=\"1-3-5-1-2-1-4-3-1\" data-name=\"point index\">\n                                    03\n                                </span>\n                                <div data-kid=\"1-3-5-1-2-1-4-3-2\" data-name=\"point text block\">\n                                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-5-1-2-1-4-3-2-1\" data-name=\"point title\">\n                                        Bảo quản như sách quý\n                                    </h3>\n                                    <p class=\"mt-1 text-[11px] leading-5 text-white/60\" data-kid=\"1-3-5-1-2-1-4-3-2-2\" data-name=\"point description\">\n                                        Được làm sạch, bọc và lưu trữ trong điều kiện phù hợp.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3 border-t border-white/15 pt-4\" data-kid=\"1-3-5-1-2-1-4-4\" data-name=\"point item\">\n                                <span class=\"pt-serif text-[18px] text-[#f4c477]\" data-kid=\"1-3-5-1-2-1-4-4-1\" data-name=\"point index\">\n                                    04\n                                </span>\n                                <div data-kid=\"1-3-5-1-2-1-4-4-2\" data-name=\"point text block\">\n                                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-5-1-2-1-4-4-2-1\" data-name=\"point title\">\n                                        Kỳ vọng thanh toán rõ ràng\n                                    </h3>\n                                    <p class=\"mt-1 text-[11px] leading-5 text-white/60\" data-kid=\"1-3-5-1-2-1-4-4-2-2\" data-name=\"point description\">\n                                        Ký gửi được đối soát định kỳ; thu mua thanh toán sau khi chốt giá.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"border border-t-0 border-[var(--thread)] bg-white p-6\" data-kid=\"1-3-5-1-2-2\" data-name=\"valuation extra card\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-5-1-2-2-1\" data-name=\"extra card header\">\n                            <h3 class=\"pt-serif text-[18px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-2-2-1-1\" data-name=\"extra card title\">\n                                Thang tình trạng\n                            </h3>\n                            <span class=\"text-[11px] text-[var(--muted)]\" data-kid=\"1-3-5-1-2-2-1-2\" data-name=\"extra card reference count\">\n                                4 mức tham chiếu\n                            </span>\n                        </div>\n                        <div class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"1-3-5-1-2-2-2\" data-name=\"condition badges container\">\n                            <span class=\"rounded-full border border-[var(--forest)] bg-[var(--forest)]/10 px-3 py-1 text-[10px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-2-2-2-1\" data-name=\"condition badge\">\n                                Như mới\n                            </span>\n                            <span class=\"rounded-full border border-[var(--amber)] bg-[var(--amber)]/10 px-3 py-1 text-[10px] font-semibold text-[var(--amber)]\" data-kid=\"1-3-5-1-2-2-2-2\" data-name=\"condition badge\">\n                                Tốt\n                            </span>\n                            <span class=\"rounded-full border border-[var(--amber)]/30 bg-[var(--linen)] px-3 py-1 text-[10px] font-semibold text-[var(--ink)]\" data-kid=\"1-3-5-1-2-2-2-3\" data-name=\"condition badge\">\n                                Đã qua sử dụng\n                            </span>\n                            <span class=\"rounded-full border border-[var(--burgundy)] bg-[var(--burgundy)]/10 px-3 py-1 text-[10px] font-semibold text-[var(--burgundy)]\" data-kid=\"1-3-5-1-2-2-2-4\" data-name=\"condition badge\">\n                                Có dấu vết rõ\n                            </span>\n                        </div>\n                        <div class=\"mt-5 border-t border-[var(--thread)] pt-4 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-5-1-2-2-3\" data-name=\"extra card description\">\n                            <span class=\"font-semibold text-[var(--forest)]\" data-kid=\"1-3-5-1-2-2-3-1\" data-name=\"description bold text\">\n                                Thanh toán & hoàn trả.\n                            </span>\n                            Nếu không phù hợp với mức giá hoặc hình thức đã trao đổi, sách được gửi trả theo thỏa thuận ban đầu.\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section aria-labelledby=\"notes-title\" class=\"border-t border-[var(--thread)] bg-[var(--linen)] px-4 py-14 sm:px-6 lg:px-10 lg:py-16\" data-kid=\"1-3-6\" data-name=\"notes section\">\n            <div class=\"mx-auto grid max-w-[1200px] grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-3-6-1\" data-name=\"notes inner grid\">\n                <div class=\"lg:col-span-4\" data-kid=\"1-3-6-1-1\" data-name=\"notes text block\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--amber)]\" data-kid=\"1-3-6-1-1-1\" data-name=\"notes pre-title\">\n                        Trước khi gửi\n                    </div>\n                    <h2 class=\"pt-serif mt-2 text-[29px] font-semibold leading-9 text-[var(--forest)]\" data-kid=\"1-3-6-1-1-2\" data-name=\"notes section title\" id=\"notes-title\">\n                        Một vài điều\n                        <br data-kid=\"1-3-6-1-1-2-1\" data-name=\"headline line break\"/>\n                        cần biết.\n                    </h2>\n                    <p class=\"mt-4 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-6-1-1-3\" data-name=\"notes description\">\n                        Chúng tôi muốn quá trình trao đổi nhẹ nhàng, rõ ràng và tôn trọng cả cuốn sách lẫn người sở hữu.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-8\" data-kid=\"1-3-6-1-2\" data-name=\"notes items container\">\n                    <div class=\"border-t border-[var(--thread)]\" data-kid=\"1-3-6-1-2-1\" data-name=\"notes inner items list\">\n                        <div class=\"grid grid-cols-[48px_1fr] gap-4 border-b border-[var(--thread)] py-4 sm:grid-cols-[64px_1fr_auto] sm:items-center\" data-kid=\"1-3-6-1-2-1-1\" data-name=\"note item\">\n                            <span class=\"pt-serif text-[22px] text-[var(--amber)]\" data-kid=\"1-3-6-1-2-1-1-1\" data-name=\"note index\">\n                                01\n                            </span>\n                            <div data-kid=\"1-3-6-1-2-1-1-2\" data-name=\"note text block\">\n                                <h3 class=\"text-[14px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-6-1-2-1-1-2-1\" data-name=\"note title\">\n                                    Chưa cần đóng gói hoặc mang sách đến ngay\n                                </h3>\n                                <p class=\"mt-1 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-6-1-2-1-1-2-2\" data-name=\"note description\">\n                                    Bước đầu chỉ cần thông tin cơ bản; chúng tôi sẽ hướng dẫn cách tiếp nhận sau khi xem xét.\n                                </p>\n                            </div>\n                            <span class=\"hidden text-[11px] font-semibold text-[var(--forest)] sm:inline\" data-kid=\"1-3-6-1-2-1-1-3\" data-name=\"note label\">\n                                Rõ ràng\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[48px_1fr] gap-4 border-b border-[var(--thread)] py-4 sm:grid-cols-[64px_1fr_auto] sm:items-center\" data-kid=\"1-3-6-1-2-1-2\" data-name=\"note item\">\n                            <span class=\"pt-serif text-[22px] text-[var(--amber)]\" data-kid=\"1-3-6-1-2-1-2-1\" data-name=\"note index\">\n                                02\n                            </span>\n                            <div data-kid=\"1-3-6-1-2-1-2-2\" data-name=\"note text block\">\n                                <h3 class=\"text-[14px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-6-1-2-1-2-2-1\" data-name=\"note title\">\n                                    Ảnh có thể gửi sau khi chúng tôi phản hồi\n                                </h3>\n                                <p class=\"mt-1 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-6-1-2-1-2-2-2\" data-name=\"note description\">\n                                    Trang này không yêu cầu tải ảnh; bạn sẽ nhận được hướng dẫn phù hợp cho từng cuốn.\n                                </p>\n                            </div>\n                            <span class=\"hidden text-[11px] font-semibold text-[var(--forest)] sm:inline\" data-kid=\"1-3-6-1-2-1-2-3\" data-name=\"note label\">\n                                Không áp lực\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[48px_1fr] gap-4 border-b border-[var(--thread)] py-4 sm:grid-cols-[64px_1fr_auto] sm:items-center\" data-kid=\"1-3-6-1-2-1-3\" data-name=\"note item\">\n                            <span class=\"pt-serif text-[22px] text-[var(--amber)]\" data-kid=\"1-3-6-1-2-1-3-1\" data-name=\"note index\">\n                                03\n                            </span>\n                            <div data-kid=\"1-3-6-1-2-1-3-2\" data-name=\"note text block\">\n                                <h3 class=\"text-[14px] font-semibold text-[var(--forest)]\" data-kid=\"1-3-6-1-2-1-3-2-1\" data-name=\"note title\">\n                                    Bạn luôn được biết sách đang ở đâu\n                                </h3>\n                                <p class=\"mt-1 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-6-1-2-1-3-2-2\" data-name=\"note description\">\n                                    Từ lúc tiếp nhận, định giá đến khi bán được, mọi mốc đối soát đều được thông báo.\n                                </p>\n                            </div>\n                            <span class=\"hidden text-[11px] font-semibold text-[var(--forest)] sm:inline\" data-kid=\"1-3-6-1-2-1-3-3\" data-name=\"note label\">\n                                An tâm\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--thread)] bg-[var(--paper)] px-4 py-12 sm:px-6 lg:px-10\" data-kid=\"1-4\" data-name=\"footer container\">\n        <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-4-1\" data-name=\"footer inner container\">\n            <div class=\"grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10\" data-kid=\"1-4-1-1\" data-name=\"footer grid\">\n                <div data-kid=\"1-4-1-1-1\" data-name=\"footer brand block\">\n                    <div class=\"pt-serif text-[19px] font-semibold text-[var(--forest)]\" data-kid=\"1-4-1-1-1-1\" data-name=\"brand name\">\n                        The Page Turner\n                    </div>\n                    <p class=\"mt-3 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-1-1-1-2\" data-name=\"brand description\">\n                        Nơi gìn giữ và trao gửi những giá trị tri thức qua nhiều thế hệ, bằng sự cẩn trọng của người làm sách.\n                    </p>\n                    <div class=\"mt-4 text-[11px] font-semibold text-[var(--forest)]\" data-kid=\"1-4-1-1-1-3\" data-name=\"footer location label\">\n                        ⌂ Tiệm sách độc lập Hà Nội\n                    </div>\n                </div>\n                <div data-kid=\"1-4-1-1-2\" data-name=\"footer links block\">\n                    <h3 class=\"text-[13px] font-semibold text-[var(--forest)]\" data-kid=\"1-4-1-1-2-1\" data-name=\"block title\">\n                        Hỗ trợ & Chính sách\n                    </h3>\n                    <ul class=\"mt-3 space-y-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-1-1-2-2\" data-name=\"links list\">\n                        <li data-kid=\"1-4-1-1-2-2-1\" data-name=\"link item\">\n                            Quy chuẩn phân loại tình trạng sách\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-2\" data-name=\"link item\">\n                            Chính sách kiểm tra & đổi trả 7 ngày\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-3\" data-name=\"link item\">\n                            Giao hàng & đóng gói chuyên dụng\n                        </li>\n                        <li data-kid=\"1-4-1-1-2-2-4\" data-name=\"link item\">\n                            Ký gửi & thu mua sách cũ\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-3\" data-name=\"footer contact block\">\n                    <h3 class=\"text-[13px] font-semibold text-[var(--forest)]\" data-kid=\"1-4-1-1-3-1\" data-name=\"block title\">\n                        Liên hệ tiệm sách\n                    </h3>\n                    <ul class=\"mt-3 space-y-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-1-1-3-2\" data-name=\"contact list\">\n                        <li data-kid=\"1-4-1-1-3-2-1\" data-name=\"contact item\">\n                            ⌖ 42 Tràng Tiền, Hoàn Kiếm, Hà Nội\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-2\" data-name=\"contact item\">\n                            ⌕ Hotline: 0988 123 456\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-3\" data-name=\"contact item\">\n                            ✉ thuthu@thepageturner.vn\n                        </li>\n                        <li data-kid=\"1-4-1-1-3-2-4\" data-name=\"contact item\">\n                            ◷ Mở cửa: 08:30 – 21:30 hàng ngày\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-4-1-1-4\" data-name=\"footer newsletter block\">\n                    <h3 class=\"text-[13px] font-semibold text-[var(--forest)]\" data-kid=\"1-4-1-1-4-1\" data-name=\"block title\">\n                        Bản tin sách hiếm\n                    </h3>\n                    <p class=\"mt-3 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-1-1-4-2\" data-name=\"newsletter description\">\n                        Nhận danh mục bản tuyển chọn, sách cũ kỳ và bản in đầu phát hành mới nhất.\n                    </p>\n                    <div class=\"mt-4 flex border border-[var(--thread)] bg-[var(--linen)]\" data-kid=\"1-4-1-1-4-3\" data-name=\"newsletter input group\">\n                        <span class=\"flex-1 px-3 py-2 text-[11px] text-[var(--muted)]\" data-kid=\"1-4-1-1-4-3-1\" data-name=\"newsletter placeholder\">\n                            Địa chỉ email của bạn...\n                        </span>\n                        <button class=\"bg-[var(--forest)] px-3 py-2 text-[10px] font-semibold text-white\" data-kid=\"1-4-1-1-4-3-2\" data-name=\"newsletter subscribe button\" type=\"button\">\n                            Đăng ký\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-10 flex flex-col gap-3 border-t border-[var(--thread)] pt-5 text-[11px] text-[var(--muted)] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-4-1-2\" data-name=\"footer bottom bar\">\n                <span data-kid=\"1-4-1-2-1\" data-name=\"copyright notice\">\n                    © 2025 The Page Turner. Bản quyền thuộc về Tiệm sách The Page Turner Việt Nam.\n                </span>\n                <span data-kid=\"1-4-1-2-2\" data-name=\"legal links\">\n                    Điều khoản dịch vụ   Chính sách bảo mật   Chứng thư ấn bản\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
