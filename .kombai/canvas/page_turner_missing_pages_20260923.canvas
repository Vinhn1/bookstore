    "var_ae18511f1afa": {
      "type": "variant",
      "label": "Page Turner — Hồ sơ & Cài đặt",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n  .page-turner { --paper: #fbf9f6; --paper-soft: #f4efea; --paper-deep: #efebe5; --forest: #1e2d24; --forest-soft: #334135; --slate: #5a685d; --amber: #c27803; --amber-soft: #fff4dc; --line: #e6dec8; --white: #ffffff; font-family: 'Be Vietnam Pro', Arial, sans-serif; }\n  .font-display { font-family: 'Playfair Display', Georgia, serif; }\n  .font-ui { font-family: 'Be Vietnam Pro', Arial, sans-serif; }\n  .page-turner input::placeholder { color: var(--slate); opacity: .72; }\n  .page-turner select { appearance: auto; }\n  .page-turner #thong-tin-ca-nhan > div:last-child button:last-child:hover { background-color: var(--forest-soft); }\n  .page-turner a, .page-turner button { cursor: pointer; }\n</style>\n<div class=\"page-turner min-h-full bg-[var(--paper)] text-[var(--forest-soft)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[var(--line)] bg-[var(--white)]\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <div class=\"hidden items-center justify-between border-b border-[var(--line)] bg-[var(--paper-soft)] px-6 py-2 text-[10px] leading-4 text-[var(--slate)] lg:flex\" data-kid=\"1-1-1\" data-name=\"utility announcement bar\">\n            <p data-kid=\"1-1-1-1\" data-name=\"announcement text\">\n                Cam kết 100% ảnh thật chụp trực tiếp từng cuốn sách\n                <span class=\"mx-2 text-[var(--amber)]\" data-kid=\"1-1-1-1-1\" data-name=\"bullet point icon\">\n                    •\n                </span>\n                Kiểm tra hàng trước khi thanh toán\n                <span class=\"mx-2 text-[var(--amber)]\" data-kid=\"1-1-1-1-2\" data-name=\"bullet point icon\">\n                    •\n                </span>\n                Đổi trả miễn phí 7 ngày\n            </p>\n            <div class=\"flex gap-7\" data-kid=\"1-1-1-2\" data-name=\"contact information container\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"opening hours text\">\n                    Hà Nội: 08:30 – 21:30\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"hotline number text\">\n                    Hotline: 0988 123 456\n                </span>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-4 px-4 py-4 sm:px-6 lg:flex-nowrap lg:gap-7\" data-kid=\"1-1-2\" data-name=\"site branding and search bar container\">\n            <a class=\"min-w-[148px] leading-none no-underline\" data-kid=\"1-1-2-1\" data-name=\"site logo link\" href=\"#\">\n                <span class=\"font-display text-[19px] text-[var(--forest)]\" data-kid=\"1-1-2-1-1\" data-name=\"site title text\">\n                    The Page Turner\n                </span>\n                <span class=\"mt-1 block text-[9px] font-semibold uppercase tracking-[0.18em] text-[var(--slate)]\" data-kid=\"1-1-2-1-2\" data-name=\"site tagline text\">\n                    Sách cũ & quý hiếm\n                </span>\n            </a>\n            <div class=\"order-3 flex w-full min-w-0 items-center rounded-sm border border-[var(--line)] bg-[var(--paper-soft)] px-3 py-2.5 text-xs text-[var(--slate)] lg:order-none lg:flex-1\" data-kid=\"1-1-2-2\" data-name=\"search input field wrapper\">\n                <svg aria-hidden=\"true\" class=\"mr-2 h-4 w-4 shrink-0 text-[var(--amber)]\" data-kid=\"1-1-2-2-1\" data-name=\"search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"6.5\">\n                    </circle>\n                    <path d=\"m16 16 4.2 4.2\">\n                    </path>\n                </svg>\n                <span class=\"truncate\" data-kid=\"1-1-2-2-2\" data-name=\"search placeholder text\">\n                    Tìm kiếm sách, tác giả, nhà xuất bản\n                </span>\n                <span class=\"ml-auto hidden border-l border-[var(--line)] pl-3 text-[11px] sm:inline\" data-kid=\"1-1-2-2-3\" data-name=\"search by topic link\">\n                    Theo chủ đề\n                </span>\n            </div>\n            <div class=\"ml-auto flex shrink-0 items-center gap-4 text-[11px] text-[var(--forest)] sm:gap-5\" data-kid=\"1-1-2-3\" data-name=\"user account utilities container\">\n                <span class=\"hidden items-center gap-1.5 sm:flex\" data-kid=\"1-1-2-3-1\" data-name=\"wishlist utility button\">\n                    <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--amber)]\" data-kid=\"1-1-2-3-1-1\" data-name=\"heart wishlist icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                        <path d=\"M20.8 8.8c0 5.4-8.8 10.1-8.8 10.1S3.2 14.2 3.2 8.8A4.3 4.3 0 0 1 12 6.7a4.3 4.3 0 0 1 8.8 2.1Z\">\n                        </path>\n                    </svg>\n                    Yêu thích\n                </span>\n                <span class=\"hidden items-center gap-1.5 sm:flex\" data-kid=\"1-1-2-3-2\" data-name=\"cart utility button\">\n                    <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--amber)]\" data-kid=\"1-1-2-3-2-1\" data-name=\"shopping cart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n                        <path d=\"M3 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.5L20.5 8H6\">\n                        </path>\n                        <circle cx=\"9\" cy=\"20\" r=\"1\">\n                        </circle>\n                        <circle cx=\"18\" cy=\"20\" r=\"1\">\n                        </circle>\n                    </svg>\n                    Giỏ hàng\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-3\" data-name=\"user account menu trigger\">\n                    <span class=\"grid